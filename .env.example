# Vorlage – als .env kopieren und lokal ausfüllen. Echte Schlüssel NIE committen.
# In GitHub: Settings → Secrets and variables → Actions → New repository secret (gleiche Namen).

# Videoclips (Gemini Omni 1.2 Flash / Kling über Replicate) und Referenzbilder – kostenpflichtig
REPLICATE_API_TOKEN=

# Optional: Soundeffekte über ElevenLabs (kommerzielle Nutzung ab Starter-Plan) – kostenpflichtig
ELEVENLABS_API_KEY=

# Optional: KI-Bildprüfung der Clips über die Gemini API – kostenpflichtig
GEMINI_API_KEY=

# Optional: Anbieter fest umstellen (mock | manual | replicate / procedural | elevenlabs / none | gemini)
# CINE_VIDEO_PROVIDER=manual
# CINE_IMAGE_PROVIDER=manual
# CINE_SFX_PROVIDER=procedural
# CINE_VISION_QC_PROVIDER=none
