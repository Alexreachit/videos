{"lines": [{"text": "Tag 2 auf Squarehead Island!", "start": 0.05, "end": 2.363, "spec": {"type": "map", "mood": "bright"}, "afx": null, "words": [["Tag", 0.0, 0.304], ["2", 0.33, 0.567], ["auf", 0.588, 0.892], ["Squarehead", 0.918, 1.695], ["Island!", 1.763, 2.269]]}, {"text": "Gestern habe ich mein eigenes Land gegründet.", "start": 2.483, "end": 4.494, "spec": {"type": "recap", "mood": "calm"}, "afx": null, "words": [["Gestern", 0.0, 0.324], ["habe", 0.352, 0.562], ["ich", 0.58, 0.752], ["mein", 0.767, 0.977], ["eigenes", 0.995, 1.319], ["Land", 1.347, 1.557], ["gegründet.", 1.575, 1.976]]}, {"text": "Unser Ziel: das reichste Land der Welt.", "start": 4.614, "end": 8.351, "spec": {"type": "goal"}, "afx": null, "words": [["Unser", 0.0, 0.429], ["Ziel:", 0.467, 0.83], ["das", 0.862, 1.855], ["reichste", 1.942, 2.569], ["Land", 2.624, 2.987], ["der", 3.019, 3.316], ["Welt.", 3.342, 3.705]]}, {"text": "Und ihr habt entschieden: Wir bauen ein Haus!", "start": 8.471, "end": 11.374, "spec": {"type": "vote", "mood": "bright"}, "afx": null, "words": [["Und", 0.0, 0.225], ["ihr", 0.245, 0.47], ["habt", 0.489, 0.765], ["entschieden:", 0.789, 1.683], ["Wir", 1.761, 1.986], ["bauen", 2.006, 2.331], ["ein", 2.359, 2.585], ["Haus!", 2.604, 2.879]]}, {"text": "Wir sind jetzt schon 15 Einwohner!", "start": 11.494, "end": 13.864, "spec": {"type": "crowd", "mood": "bright"}, "afx": null, "words": [["Wir", 0.0, 0.265], ["sind", 0.288, 0.612], ["jetzt", 0.641, 1.024], ["schon", 1.057, 1.44], ["15", 1.474, 1.68], ["Einwohner!", 1.698, 2.317]]}, {"text": "Eure Likes bringen 150 Euro. Macht 170 Euro in der Kasse!", "start": 13.984, "end": 18.937, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.0, 0.347], ["Likes", 0.377, 0.786], ["bringen", 0.822, 1.357], ["150", 1.404, 1.687], ["Euro.", 1.712, 2.059], ["Macht", 2.089, 3.18], ["170", 3.275, 3.558], ["Euro", 3.583, 3.929], ["in", 3.96, 4.18], ["der", 4.199, 4.483], ["Kasse!", 4.507, 4.917]]}, {"text": "Für eine Villa reicht das nicht…", "start": 19.057, "end": 21.075, "spec": {"type": "villa", "mood": "calm"}, "afx": null, "words": [["Für", 0.0, 0.239], ["eine", 0.26, 0.551], ["Villa", 0.577, 0.922], ["reicht", 0.952, 1.349], ["das", 1.384, 1.623], ["nicht…", 1.644, 1.988]]}, {"text": "Aber für eine kleine Hütte! Alle Mann, wir bauen!", "start": 21.195, "end": 24.395, "spec": {"type": "build", "mood": "bright"}, "afx": null, "words": [["Aber", 0.0, 0.274], ["für", 0.298, 0.522], ["eine", 0.541, 0.815], ["kleine", 0.839, 1.212], ["Hütte!", 1.245, 1.948], ["Alle", 2.009, 2.283], ["Mann,", 2.307, 2.58], ["wir", 2.604, 2.828], ["bauen!", 2.848, 3.171]]}, {"text": "Einer will Bürgermeister werden. Du wirst mein Vize-Bürgermeister!", "start": 24.515, "end": 28.473, "spec": {"type": "vize"}, "afx": null, "words": [["Einer", 0.0, 0.331], ["will", 0.36, 0.64], ["Bürgermeister", 0.665, 1.403], ["werden.", 1.468, 2.026], ["Du", 2.075, 2.253], ["wirst", 2.269, 2.6], ["mein", 2.629, 2.909], ["Vize-Bürgermeister!", 2.933, 3.876]]}, {"text": "Hier ist deine Sonnenbrille!", "start": 28.593, "end": 30.11, "spec": {"type": "brille", "mood": "bright"}, "afx": null, "words": [["Hier", 0.0, 0.256], ["ist", 0.278, 0.488], ["deine", 0.506, 0.808], ["Sonnenbrille!", 0.835, 1.463]]}, {"text": "Und ja: Du wohnst schon hier!", "start": 30.23, "end": 32.246, "spec": {"type": "wohnt"}, "afx": null, "words": [["Und", 0.0, 0.211], ["ja:", 0.229, 0.794], ["Du", 0.843, 1.007], ["wohnst", 1.021, 1.373], ["schon", 1.404, 1.709], ["hier!", 1.735, 1.993]]}, {"text": "Wer in die Armee will: Du bist der Erste in der Wache!", "start": 32.366, "end": 35.587, "spec": {"type": "armee"}, "afx": null, "words": [["Wer", 0.0, 0.2], ["in", 0.217, 0.373], ["die", 0.386, 0.586], ["Armee", 0.603, 0.892], ["will:", 0.917, 1.161], ["Du", 1.182, 1.682], ["bist", 1.726, 1.97], ["der", 1.991, 2.191], ["Erste", 2.208, 2.497], ["in", 2.522, 2.677], ["der", 2.691, 2.891], ["Wache!", 2.908, 3.197]]}, {"text": "Und wer sich sucht: Hier bist du!", "start": 35.707, "end": 37.883, "spec": {"type": "elias", "mood": "bright"}, "afx": null, "words": [["Und", 0.0, 0.228], ["wer", 0.247, 0.475], ["sich", 0.495, 0.773], ["sucht:", 0.797, 1.332], ["Hier", 1.378, 1.656], ["bist", 1.681, 1.959], ["du!", 1.983, 2.16]]}, {"text": "Nur ein Problem: 15 Leute, eine Hütte und nur eine Melone.", "start": 38.003, "end": 41.813, "spec": {"type": "problem", "mood": "calm"}, "afx": null, "words": [["Nur", 0.0, 0.256], ["ein", 0.279, 0.535], ["Problem:", 0.558, 1.042], ["15", 1.084, 1.284], ["Leute,", 1.301, 1.671], ["eine", 1.704, 2.017], ["Hütte", 2.044, 2.415], ["und", 2.447, 2.703], ["nur", 2.726, 2.982], ["eine", 3.004, 3.318], ["Melone.", 3.345, 3.773]]}, {"text": "Also: Pflanzen wir ein Melonenfeld?", "start": 41.933, "end": 44.143, "spec": {"type": "feld", "mood": "bright"}, "afx": null, "words": [["Also:", 0.0, 0.273], ["Pflanzen", 0.297, 0.989], ["wir", 1.049, 1.273], ["ein", 1.292, 1.516], ["Melonenfeld?", 1.535, 2.157]]}, {"text": "Oder bauen wir ein Boot zur Nachbarinsel?", "start": 44.263, "end": 46.402, "spec": {"type": "boot"}, "afx": null, "words": [["Oder", 0.0, 0.243], ["bauen", 0.264, 0.552], ["wir", 0.577, 0.776], ["ein", 0.793, 0.992], ["Boot", 1.009, 1.252], ["zur", 1.274, 1.473], ["Nachbarinsel?", 1.49, 2.087]]}, {"text": "Der Top-Kommentar entscheidet.", "start": 46.522, "end": 48.243, "spec": {"type": "comment"}, "afx": null, "words": [["Der", 0.0, 0.234], ["Top-Kommentar", 0.254, 0.954], ["entscheidet.", 1.015, 1.664]]}], "dur": 49.64}