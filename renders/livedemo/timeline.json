{"lines": [{"text": "Doppelt tippen für Likes, dann bauen wir den nächsten Teil der Insel!", "start": 0.05, "end": 3.986, "spec": {"type": "say"}, "afx": null, "words": [["Doppelt", 0.093, 0.37], ["tippen", 0.382, 0.764], ["für", 0.775, 0.949], ["Likes", 0.949, 1.331], ["dann", 1.655, 1.817], ["bauen", 1.817, 2.06], ["wir", 2.06, 2.141], ["den", 2.141, 2.269], ["nächsten", 2.28, 2.685], ["Teil", 2.685, 2.951], ["der", 2.951, 3.09], ["Insel", 3.102, 3.599]]}, {"text": "Bürgermeister bin ich, sophie_xo! Aber das größte Haus bekommt den Ehrenplatz neben mir.", "start": 4.106, "end": 9.77, "spec": {"type": "say"}, "afx": null, "words": [["Bürgermeister", 0.093, 0.66], ["bin", 0.66, 0.845], ["ich", 0.845, 1.065], ["sophie", 1.4, 1.852], ["xo", 1.863, 2.245], ["Aber", 2.627, 2.766], ["das", 2.766, 2.882], ["größte", 2.882, 3.275], ["Haus", 3.275, 3.576], ["bekommt", 3.576, 3.97], ["den", 3.982, 4.167], ["Ehrenplatz", 4.167, 4.734], ["neben", 4.734, 5.023], ["mir", 5.023, 5.324]]}, {"text": "Als Nächstes kommt der Brunnen bei 500 Likes. Also fleißig tippen!", "start": 9.89, "end": 14.282, "spec": {"type": "say"}, "afx": null, "words": [["Als", 0.093, 0.243], ["Nächstes", 0.243, 0.694], ["kommt", 0.694, 0.914], ["der", 0.914, 1.018], ["Brunnen", 1.018, 1.435], ["bei", 1.447, 1.62], ["500", 1.632, 2.187], ["Likes", 2.199, 2.616], ["Also", 2.998, 3.206], ["fleißig", 3.206, 3.646], ["tippen", 3.657, 4.039]]}, {"text": "Wow, danke paulinchen für Rose! Dein Haus wächst!", "start": 14.402, "end": 18.05, "spec": {"type": "say"}, "afx": null, "words": [["Wow", 0.093, 0.336], ["danke", 0.602, 0.88], ["paulinchen", 0.88, 1.458], ["für", 1.47, 1.62], ["Rose", 1.632, 2.049], ["Dein", 2.419, 2.569], ["Haus", 2.569, 2.859], ["wächst", 2.87, 3.31]]}, {"text": "Neuer Einwohner: sophie_xo! Dein Haus steht schon.", "start": 18.17, "end": 21.77, "spec": {"type": "say"}, "afx": null, "words": [["Neuer", 0.104, 0.347], ["Einwohner", 0.359, 0.961], ["sophie", 1.227, 1.62], ["xo", 1.62, 2.025], [