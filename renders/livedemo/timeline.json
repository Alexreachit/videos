{"lines": [{"text": "Doppelt tippen für Likes, dann bauen wir den nächsten Teil der Insel!", "start": 0.05, "end": 4.01, "spec": {"type": "say"}, "afx": null, "words": [["Doppelt", 0.104, 0.463], ["tippen", 0.475, 0.833], ["für", 0.833, 0.984], ["Likes", 0.984, 1.377], ["dann", 1.678, 1.829], ["bauen", 1.84, 2.095], ["wir", 2.095, 2.176], ["den", 2.176, 2.315], ["nächsten", 2.315, 2.708], ["Teil", 2.708, 2.975], ["der", 2.975, 3.125], ["Insel", 3.125, 3.623]]}, {"text": "Bürgermeister bin ich, sophie_xo! Aber das größte Haus bekommt den Ehrenplatz neben mir.", "start": 4.13, "end": 9.866, "spec": {"type": "say"}, "afx": null, "words": [["Bürgermeister", 0.104, 0.637], ["bin", 0.637, 0.833], ["ich", 0.833, 1.042], ["sophie", 1.377, 1.84], ["xo", 1.852, 2.268], ["Aber", 2.65, 2.789], ["das", 2.789, 2.905], ["größte", 2.905, 3.287], ["Haus", 3.299, 3.6], ["bekommt", 3.6, 3.993], ["den", 3.993, 4.167], ["Ehrenplatz", 4.178, 4.792], ["neben", 4.792, 5.093], ["mir", 5.104, 5.393]]}, {"text": "Als Nächstes kommt der Brunnen bei 500 Likes. Also fleißig tippen!", "start": 9.986, "end": 14.498, "spec": {"type": "say"}, "afx": null, "words": [["Als", 0.093, 0.255], ["Nächstes", 0.266, 0.718], ["kommt", 0.718, 0.961], ["der", 0.972, 1.076], ["Brunnen", 1.088, 1.505], ["bei", 1.516, 1.701], ["500", 1.701, 2.292], ["Likes", 2.292, 2.708], ["Also", 3.079, 3.299], ["fleißig", 3.31, 3.773], ["tippen", 3.773, 4.167]]}, {"text": "Wow, danke paulinchen für Rose! Dein Haus wächst!", "start": 14.618, "end": 18.266, "spec": {"type": "say"}, "afx": null, "words": [["Wow", 0.093, 0.336], ["danke", 0.602, 0.88], ["paulinchen", 0.88, 1.458], ["für", 1.47, 1.62], ["Rose", 1.632, 2.049], ["Dein", 2.419, 2.569], ["Haus", 2.569, 2.859], ["wächst", 2.87, 3.31]]}, {"text": "Neuer Einwohner: sophie_xo! Dein Haus steht schon.", "start": 18.386, "end": 21.986, "spec": {"type": "say"}, "afx": null, "words": [["Neuer", 0.104, 0.347], ["Einwohner", 0.359, 0.961], ["sophie", 1.227, 1.62], ["xo", 1.62, 2.0