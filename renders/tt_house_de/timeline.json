{"lines": [{"text": "Wohnung kaufen, oder mieten und in einen ETF investieren? Nach 30 Jahren trennt beide nur ein Kleinwagen.", "start": 0.1, "end": 6.652, "spec": {"mood": "tense"}, "words": [["Wohnung", 0.049, 0.424], ["kaufen", 0.424, 0.867], ["oder", 1.072, 1.242], ["mieten", 1.242, 1.651], ["und", 1.651, 1.844], ["in", 1.844, 1.958], ["einen", 1.958, 2.162], ["ETF", 2.163, 2.663], ["investieren", 2.663, 3.344], ["Nach 30 Jahren", 3.651, 4.64], ["trennt", 4.64, 4.958], ["beide", 4.958, 5.242], ["nur", 5.242, 5.412], ["ein", 5.412, 5.526], ["Kleinwagen", 5.526, 6.242]]}, {"text": "Beide starten mit rund 66.000 Euro.", "start": 6.852, "end": 9.948, "spec": {"mood": "calm"}, "words": [["Beide", 0.049, 0.39], ["starten", 0.39, 0.787], ["mit", 0.787, 0.924], ["rund", 0.924, 1.174], ["66.000 Euro", 1.174, 2.787]]}, {"text": "Der Käufer zahlt 212.000 Euro für die Wohnung. 23.000 sind sofort weg: Steuer, Notar, Makler.", "start": 10.148, "end": 17.9, "spec": {}, "words": [["Der", 0.05, 0.243], ["Käufer", 0.243, 0.63], ["zahlt", 0.63, 0.925], ["212.000 Euro", 0.925, 2.448], ["für", 2.448, 2.584], ["die", 2.584, 2.675], ["Wohnung", 2.675, 3.13], ["23.000", 3.466, 4.58], ["sind", 4.58, 4.739], ["sofort", 4.739, 5.057], ["weg", 5.057, 5.284], ["Steuer", 5.625, 6.091], ["Notar", 6.273, 6.727], ["Makler", 6.909, 7.42]]}, {"text": "Kredit plus Instandhaltung: rund 1.000 Euro im Monat.", "start": 18.1, "end": 21.94, "spec": {}, "words": [["Kredit", 0.05, 0.459], ["plus", 0.459, 0.755], ["Instandhaltung", 0.755, 1.505], ["rund", 1.834, 2.107], ["1.000 Euro", 2.107, 2.97], ["im", 2.97, 3.05], ["Monat", 3.05, 3.527]]}, {"text": "Der Mieter zahlt 718 Euro Miete und investiert den Rest.", "start": 22.14, "end": 26.028, "spec": {}, "words": [["Der", 0.05, 0.243], ["Mieter", 0.243, 0.55], ["zahlt", 0.55, 0.845], ["718 Euro", 0.845, 1.914], ["Miete", 1.914, 2.311], ["und", 2.323, 2.527], ["investiert", 2.527, 3.039], ["den", 3.039, 3.175], ["Rest", 3.175, 3.573]]}, {"text": "Und der ETF liegt die ganzen 30 Jahre vorne.", "start": 26.228, "end": 29.276, "spec": {"mood": "tense"}, "words": [["Und", 0.049, 0.299], ["der", 0.299, 0.469], ["ETF", 0.469, 1.037], ["liegt", 1.083, 1.287], ["die", 1.288, 1.378], ["ganzen", 1.378, 1.697], ["30 Jahre", 1.697, 2.299], ["vorne", 2.299, 2.731]]}, {"text": "Am Ende: Wohnung 533.000 Euro. ETF 559.000, nach Steuern.", "start": 29.476, "end": 36.604, "spec": {"mood": "bright", "cut": true}, "words": [["Am", 0.049, 0.287], ["Ende", 0.287, 0.617], ["Wohnung", 0.912, 1.219], ["533.000 Euro", 1.219, 3.333], ["ETF", 3.648, 4.159], ["559.000", 4.159, 5.852], ["nach", 6.102, 6.273], ["Steuern", 6.273, 6.807]]}, {"text": "Aber bei 6 Prozent Rendite gewinnt die Wohnung, bei 8 Prozent klar der ETF. Was würdest du wählen:", "start": 36.804, "end": 42.924, "spec": {"mood": "tense", "cut": true}, "words": [["Aber", 0.049, 0.31], ["bei 6 Prozent", 0.31, 1.072], ["Rendite", 1.072, 1.447], ["gewinnt", 1.447, 1.731], ["die", 1.731, 1.833], ["Wohnung", 1.833, 2.219], ["bei 8 Prozent", 2.469, 3.299], ["klar", 3.299, 3.583], ["der", 3.583, 3.708], ["ETF", 3.708, 4.333], ["Was", 4.64, 4.935], ["würdest", 4.935, 5.242], ["du", 5.242, 5.333], ["wählen", 5.333, 5.799]]}], "dur": 43.02}