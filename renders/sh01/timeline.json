{"lines": [{"text": "Tag eins: Ich habe gerade mein eigenes Land gegründet.", "start": 0.05, "end": 2.916, "spec": {"type": "fly", "mood": "calm"}, "afx": null, "words": [["Tag", 0.0, 0.206], ["eins:", 0.224, 0.477], ["Ich", 0.498, 0.705], ["habe", 0.723, 0.975], ["gerade", 0.997, 1.341], ["mein", 1.371, 1.623], ["eigenes", 1.645, 2.035], ["Land", 2.069, 2.321], ["gegründet.", 2.343, 2.824]]}, {"text": "Willkommen auf Squarehead Island!", "start": 3.036, "end": 5.627, "spec": {"type": "sign"}, "afx": null, "words": [["Willkommen", 0.0, 0.783], ["auf", 0.851, 1.158], ["Squarehead", 1.184, 1.968], ["Island!", 2.036, 2.546]]}, {"text": "Einwohner: genau einer. Ich.", "start": 5.747, "end": 8.572, "spec": {"type": "pop"}, "afx": null, "words": [["Einwohner:", 0.0, 0.77], ["genau", 0.837, 1.239], ["einer.", 1.274, 2.423], ["Ich.", 2.523, 2.801]]}, {"text": "Aber jeder neue Follower wird ein Bürger.", "start": 8.692, "end": 10.814, "spec": {"type": "follow"}, "afx": null, "words": [["Aber", 0.0, 0.241], ["jeder", 0.262, 0.547], ["neue", 0.572, 0.814], ["Follower", 0.834, 1.251], ["wird", 1.287, 1.529], ["ein", 1.55, 1.747], ["Bürger.", 1.764, 2.093]]}, {"text": "Unser Ziel: das reichste Land der Welt.", "start": 10.934, "end": 13.107, "spec": {"type": "goal", "mood": "bright"}, "afx": null, "words": [["Unser", 0.0, 0.313], ["Ziel:", 0.34, 0.605], ["das", 0.628, 0.845], ["reichste", 0.864, 1.321], ["Land", 1.361, 1.626], ["der", 1.649, 1.866], ["Welt.", 1.884, 2.149]]}, {"text": "Aber schau dich um. Keine Häuser, keine Bank, nicht mal eine Straße.", "start": 13.227, "end": 17.053, "spec": {"type": "empty", "mood": "calm"}, "afx": null, "words": [["Aber", 0.0, 0.246], ["schau", 0.267, 0.558], ["dich", 0.583, 1.174], ["um.", 1.226, 1.382], ["Keine", 1.396, 1.686], ["Häuser,", 1.712, 2.047], ["keine", 2.076, 2.367], ["Bank,", 2.392, 2.638], ["nicht", 2.66, 2.95], ["mal", 2.975, 3.177], ["eine", 3.194, 3.44], ["Straße.", 3.462, 3.797]]}, {"text": "Folg jetzt, und du bekommst Reisepass Nummer eins.", "start": 17.173, "end": 19.626, "spec": {"type": "passport"}, "afx": null, "words": [["Folg", 0.0, 0.234], ["jetzt,", 0.255, 0.531], ["und", 0.555, 0.747], ["du", 0.764, 0.913], ["bekommst", 0.926, 1.33], ["Reisepass", 1.365, 1.812], ["Nummer", 1.851, 2.171], ["eins.", 2.198, 2.433]]}, {"text": "Unsere Staatskasse: zwanzig Euro... und eine Melone.", "start": 19.746, "end": 23.821, "spec": {"type": "treasury"}, "afx": null, "words": [["Unsere", 0.0, 0.45], ["Staatskasse:", 0.489, 1.539], ["zwanzig", 1.631, 2.141], ["Euro...", 2.185, 2.874], ["und", 2.934, 3.204], ["eine", 3.227, 3.557], ["Melone.", 3.586, 4.036]]}, {"text": "Und für jeden Like kommen zehn Euro in die Kasse!", "start": 23.941, "end": 26.485, "spec": {"type": "likes"}, "afx": null, "words": [["Und", 0.0, 0.195], ["für", 0.212, 0.407], ["jeden", 0.424, 0.706], ["Like", 0.73, 0.969], ["kommen", 0.989, 1.314], ["zehn", 1.343, 1.581], ["Euro", 1.602, 1.84], ["in", 1.861, 2.012], ["die", 2.026, 2.221], ["Kasse!", 2.238, 2.519]]}, {"text": "Also, was bauen wir zuerst? Ein Feld oder ein Haus?", "start": 26.605, "end": 30.377, "spec": {"type": "choice"}, "afx": null, "words": [["Also,", 0.0, 0.328], ["was", 0.356, 0.624], ["bauen", 0.647, 1.034], ["wir", 1.068, 1.336], ["zuerst?", 1.359, 2.06], ["Ein", 2.121, 2.389], ["Feld", 2.413, 2.74], ["oder", 2.769, 3.096], ["ein", 3.125, 3.393], ["Haus?", 3.416, 3.743]]}, {"text": "Der Top-Kommentar entscheidet.", "start": 30.497, "end": 32.451, "spec": {"type": "comment"}, "afx": null, "words": [["Der", 0.0, 0.265], ["Top-Kommentar", 0.288, 1.084], ["entscheidet.", 1.154, 1.89]]}], "dur": 33.85}