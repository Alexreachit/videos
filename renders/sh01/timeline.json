{"lines": [{"text": "Tag eins: Ich habe gerade mein eigenes Land gegründet.", "start": 0.05, "end": 3.314, "spec": {"type": "fly", "mood": "calm"}, "afx": null, "words": [["Tag", 0.086, 0.323], ["eins", 0.323, 0.657], ["Ich", 0.991, 1.056], ["habe", 1.056, 1.228], ["gerade", 1.228, 1.562], ["mein", 1.573, 1.81], ["eigenes", 1.81, 2.155], ["Land", 2.166, 2.403], ["gegründet", 2.403, 2.953]]}, {"text": "Willkommen auf Squarehead Island!", "start": 3.434, "end": 5.306, "spec": {"type": "sign"}, "afx": null, "words": [["Willkommen", 0.097, 0.582], ["auf", 0.582, 0.711], ["Squarehead", 0.711, 1.121], ["Island", 1.121, 1.455]]}, {"text": "Einwohner: genau einer. Ich.", "start": 5.426, "end": 7.826, "spec": {"type": "pop"}, "afx": null, "words": [["Einwohner", 0.086, 0.55], ["genau", 0.776, 1.078], ["einer", 1.078, 1.465], ["Ich", 1.821, 2.069]]}, {"text": "Aber jeder neue Follower wird ein Bürger.", "start": 7.946, "end": 10.418, "spec": {"type": "follow"}, "afx": null, "words": [["Aber", 0.086, 0.269], ["jeder", 0.28, 0.55], ["neue", 0.55, 0.819], ["Follower", 0.83, 1.347], ["wird", 1.358, 1.541], ["ein", 1.552, 1.724], ["Bürger", 1.724, 2.155]]}, {"text": "Unser Ziel: das reichste Land der Welt.", "start": 10.538, "end": 13.13, "spec": {"type": "goal", "mood": "bright"}, "afx": null, "words": [["Unser", 0.097, 0.345], ["Ziel", 0.345, 0.765], ["das", 1.088, 1.228], ["reichste", 1.228, 1.606], ["Land", 1.616, 1.832], ["der", 1.843, 1.94], ["Welt", 1.94, 2.274]]}, {"text": "Aber schau dich um. Keine Häuser, keine Bank, nicht mal eine Straße.", "start": 13.25, "end": 17.666, "spec": {"type": "empty", "mood": "calm"}, "afx": null, "words": [["Aber", 0.097, 0.248], ["schau", 0.248, 0.485], ["dich", 0.485, 0.722], ["um", 0.722, 0.905], ["Keine", 1.25, 1.466], ["Häuser", 1.476, 1.918], ["keine", 2.198, 2.468], ["Bank", 2.468, 2.78], ["nicht", 3.125, 3.287], ["mal", 3.287, 3.427], ["eine Straße", 3.438, 4.084]]}, {"text": "Folg jetzt, und du bekommst Reisepass Nummer eins.", "start": 17.786, "end": 21.146, "spec": {"type": "passport"}, "afx": null, "words": [["Folg", 0.119, 0.377], ["jetzt", 0.377, 0.722], ["und", 1.056, 1.142], ["du", 1.153, 1.228], ["bekommst", 1.228, 1.627], ["Reisepass", 1.638, 2.263], ["Nummer", 2.274, 2.554], ["eins", 2.565, 3.028]]}, {"text": "Unsere Staatskasse: zwanzig Euro... und eine Melone.", "start": 21.266, "end": 24.698, "spec": {"type": "treasury"}, "afx": null, "words": [["Unsere", 0.086, 0.312], ["Staatskasse", 0.312, 0.916], ["zwanzig", 1.121, 1.584], ["Euro", 1.595, 1.961], ["und", 2.328, 2.457], ["eine", 2.457, 2.651], ["Melone", 2.651, 3.114]]}, {"text": "Und für jeden Like kommen zehn Euro in die Kasse!", "start": 24.818, "end": 27.506, "spec": {"type": "likes"}, "afx": null, "words": [["Und", 0.086, 0.183], ["für", 0.183, 0.302], ["jeden", 0.302, 0.593], ["Like", 0.603, 0.733], ["kommen", 0.733, 1.002], ["zehn", 1.013, 1.325], ["Euro", 1.325, 1.746], ["in", 1.746, 1.832], ["die", 1.843, 1.929], ["Kasse", 1.94, 2.371]]}, {"text": "Also, was bauen wir zuerst? Ein Feld oder ein Haus?", "start": 27.626, "end": 31.466, "spec": {"type": "choice"}, "afx": null, "words": [["Also", 0.097, 0.431], ["was", 0.776, 0.894], ["bauen", 0.894, 1.142], ["wir", 1.142, 1.25], ["zuerst", 1.261, 1.864], ["Ein", 2.231, 2.349], ["Feld", 2.349, 2.705], ["oder", 2.716, 2.899], ["ein", 2.899, 3.039], ["Haus", 3.039, 3.502]]}, {"text": "Der Top-Kommentar entscheidet.", "start": 31.586, "end": 33.458, "spec": {"type": "comment"}, "afx": null, "words": [["Der", 0.086, 0.183], ["Top-Kommentar", 0.183, 0.905], ["entscheidet", 0.905, 1.519]]}], "dur": 34.86}