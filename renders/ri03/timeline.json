{"lines": [{"text": "Tag drei auf Roundhead Island!", "start": 0.05, "end": 1.922, "spec": {"type": "day", "mood": "bright"}, "afx": null, "words": [["Tag", 0.086, 0.291], ["drei", 0.291, 0.539], ["auf", 0.539, 0.657], ["Roundhead", 0.657, 0.97], ["Island", 0.97, 1.272]]}, {"text": "Gestern habt ihr entschieden: fischen oder die Nachbarinsel ausrauben?", "start": 2.042, "end": 5.906, "spec": {"type": "recap", "mood": "calm"}, "afx": null, "words": [["Gestern", 0.086, 0.345], ["habt", 0.345, 0.506], ["ihr", 0.506, 0.593], ["entschieden", 0.603, 1.121], ["fischen", 1.466, 1.864], ["oder", 1.875, 2.047], ["die", 2.047, 2.134], ["Nachbarinsel", 2.144, 2.877], ["ausrauben", 2.877, 3.545]]}, {"text": "76 Prozent sagen: Ausrauben!", "start": 6.026, "end": 8.882, "spec": {"type": "vote", "mood": "bright"}, "afx": null, "words": [["76 Prozent", 0.097, 1.347], ["sagen", 1.347, 1.692], ["Ausrauben", 1.95, 2.522]]}, {"text": "Und wir sind jetzt 128 Einwohner!", "start": 9.002, "end": 11.906, "spec": {"type": "crowd"}, "afx": null, "words": [["Und", 0.097, 0.183], ["wir", 0.183, 0.28], ["sind", 0.28, 0.453], ["jetzt", 0.463, 0.83], ["128 Einwohner", 0.841, 2.586]]}, {"text": "Eure 50 Likes bringen 500 Euro!", "start": 12.026, "end": 14.714, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.097, 0.442], ["50", 0.442, 0.927], ["Likes", 0.927, 1.088], ["bringen", 1.099, 1.433], ["500 Euro", 1.433, 2.349]]}, {"text": "Also schleichen wir heute Nacht mit dem Boot rüber.", "start": 14.834, "end": 17.474, "spec": {"type": "night", "mood": "calm"}, "afx": null, "words": [["Also", 0.097, 0.291], ["schleichen", 0.291, 0.711], ["wir", 0.722, 0.841], ["heute", 0.851, 1.121], ["Nacht", 1.131, 1.39], ["mit", 1.39, 1.509], ["dem", 1.509, 1.638], ["Boot", 1.638, 1.897], ["rüber", 1.907, 2.328]]}, {"text": "Benluca, die Krabbe, spioniert vorne am Strand.", "start": 17.594, "end": 21.122, "spec": {"type": "spy"}, "afx": null, "words": [["Benluca", 0.097, 0.722], ["die", 1.002, 1.11], ["Krabbe", 1.121, 1.552], ["spioniert", 1.875, 2.36], ["vorne", 2.36, 2.672], ["am", 2.683, 2.78], ["Strand", 2.78, 3.211]]}, {"text": "Und da: eine riesige Schatzkiste!", "start": 21.242, "end": 23.738, "spec": {"type": "chest", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.194], ["da", 0.194, 0.517], ["eine", 0.808, 1.067], ["riesige", 1.067, 1.476], ["Schatzkiste", 1.476, 2.177]]}, {"text": "Wir schnappen sie und rudern so schnell wir können zurück!", "start": 23.858, "end": 27.074, "spec": {"type": "escape"}, "afx": null, "words": [["Wir", 0.086, 0.205], ["schnappen", 0.205, 0.582], ["sie", 0.582, 0.894], ["und", 0.905, 1.078], ["rudern", 1.078, 1.444], ["so", 1.444, 1.659], ["schnell", 1.67, 2.047], ["wir", 2.047, 2.198], ["können", 2.209, 2.5], ["zurück", 2.5, 2.899]]}, {"text": "Darin: 1000 Euro in Gold!", "start": 27.194, "end": 29.546, "spec": {"type": "gold"}, "afx": null, "words": [["Darin", 0.097, 0.442], ["1000 Euro", 0.7, 1.584], ["in", 1.595, 1.703], ["Gold", 1.713, 2.026]]}, {"text": "Doch dann geht auf der Nachbarinsel das Licht an...", "start": 29.666, "end": 32.162, "spec": {"type": "lights", "mood": "calm"}, "afx": null, "words": [["Doch", 0.086, 0.172], ["dann", 0.172, 0.291], ["geht", 0.291, 0.485], ["auf", 0.485, 0.593], ["der", 0.603, 0.69], ["Nachbarinsel", 0.69, 1.422], ["das", 1.422, 1.616], ["Licht", 1.627, 1.929], ["an", 1.94, 2.177]]}, {"text": "Die Nachbarn haben uns gesehen. Und sie wollen Rache!", "start": 32.282, "end": 35.21, "spec": {"type": "revenge"}, "afx": null, "words": [["Die", 0.086, 0.162], ["Nachbarn", 0.162, 0.528], ["haben", 0.539, 0.787], ["uns", 0.797, 0.927], ["gesehen", 0.938, 1.379], ["Und", 1.724, 1.81], ["sie", 1.81, 1.94], ["wollen", 1.95, 2.231], ["Rache", 2.231, 2.608]]}, {"text": "Also: Bauen wir eine riesige Mauer?", "start": 35.33, "end": 37.778, "spec": {"type": "wall", "mood": "bright"}, "afx": null, "words": [["Also", 0.097, 0.42], ["Bauen", 0.787, 1.013], ["wir", 1.024, 1.121], ["eine", 1.121, 1.293], ["riesige", 1.293, 1.746], ["Mauer", 1.756, 2.134]]}, {"text": "Oder schließen wir Frieden und geben das Gold zurück?", "start": 37.898, "end": 40.586, "spec": {"type": "peace"}, "afx": null, "words": [["Oder", 0.086, 0.28], ["schließen", 0.28, 0.657], ["wir", 0.668, 0.787], ["Frieden", 0.797, 1.272], ["und", 1.272, 1.433], ["geben", 1.444, 1.627], ["das", 1.638, 1.756], ["Gold", 1.756, 1.972], ["zurück", 1.983, 2.371]]}, {"text": "Der Top-Kommentar entscheidet.", "start": 40.706, "end": 42.578, "spec": {"type": "comment"}, "afx": null, "words": [["Der", 0.086, 0.183], ["Top-Kommentar", 0.183, 0.894], ["entscheidet", 0.894, 1.519]]}], "dur": 43.98}