{"lines": [{"text": "Tag fünf auf Roundhead Island! Und gleich da drüben wohnen die Eckköpfe.", "start": 0.05, "end": 4.202, "spec": {"type": "map", "mood": "bright"}, "afx": null, "words": [["Tag", 0.086, 0.28], ["fünf", 0.28, 0.55], ["auf", 0.56, 0.722], ["Roundhead", 0.722, 1.056], ["Island", 1.067, 1.368], ["Und", 1.703, 1.8], ["gleich", 1.8, 2.134], ["da", 2.134, 2.317], ["drüben", 2.317, 2.726], ["wohnen", 2.737, 3.05], ["die", 3.05, 3.19], ["Eckköpfe", 3.2, 3.825]]}, {"text": "Gestern bauten die Nachbarn ein Katapult.", "start": 4.322, "end": 6.77, "spec": {"type": "recap", "mood": "calm"}, "afx": null, "words": [["Gestern", 0.086, 0.356], ["bauten", 0.356, 0.679], ["die", 0.679, 0.765], ["Nachbarn", 0.776, 1.315], ["ein", 1.315, 1.444], ["Katapult", 1.444, 2.134]]}, {"text": "Ihr habt abgestimmt: 61 Prozent für die Kanone!", "start": 6.89, "end": 10.274, "spec": {"type": "vote", "mood": "bright"}, "afx": null, "words": [["Ihr", 0.086, 0.205], ["habt", 0.205, 0.453], ["abgestimmt", 0.453, 1.045], ["61", 1.379, 1.95], ["Prozent", 1.961, 2.381], ["für", 2.381, 2.478], ["die", 2.478, 2.554], ["Kanone", 2.554, 3.071]]}, {"text": "13 neue Bürger! Wir sind jetzt 141 Einwohner.", "start": 10.394, "end": 14.498, "spec": {"type": "crowd"}, "afx": null, "words": [["13", 0.086, 0.506], ["neue", 0.506, 0.787], ["Bürger", 0.787, 1.228], ["Wir", 1.584, 1.703], ["sind", 1.703, 1.875], ["jetzt", 1.875, 2.188], ["141", 2.198, 3.222], ["Einwohner", 3.222, 3.782]]}, {"text": "Eure 34 Herzen bringen 340 Euro!", "start": 14.618, "end": 18.266, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.097, 0.463], ["34", 0.474, 1.304], ["Herzen", 1.304, 1.638], ["bringen", 1.638, 1.983], ["340", 1.994, 2.942], ["Euro", 2.942, 3.33]]}, {"text": "Ein neuer Bürger wollte eine Gurke sein. Wunsch erfüllt!", "start": 18.386, "end": 21.77, "spec": {"type": "gurke"}, "afx": null, "words": [["Ein", 0.097, 0.237], ["neuer", 0.237, 0.485], ["Bürger", 0.485, 0.787], ["wollte", 0.787, 1.131], ["eine", 1.142, 1.336], ["Gurke", 1.336, 1.616], ["sein", 1.627, 1.961], ["Wunsch", 2.317, 2.554], ["erfüllt", 2.565, 3.06]]}, {"text": "Und wer sich einen Hund gewünscht hat: Hier ist er!", "start": 21.89, "end": 24.674, "spec": {"type": "hund", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.172], ["wer", 0.183, 0.291], ["sich", 0.291, 0.463], ["einen", 0.463, 0.636], ["Hund", 0.647, 0.84], ["gewünscht", 0.851, 1.228], ["hat", 1.228, 1.422], ["Hier", 1.767, 1.972], ["ist", 1.983, 2.198], ["er", 2.198, 2.457]]}, {"text": "Die Kanone kostet 500 Euro. Bleiben 270 Euro.", "start": 24.794, "end": 29.162, "spec": {"type": "money2"}, "afx": null, "words": [["Die", 0.086, 0.162], ["Kanone", 0.162, 0.679], ["kostet", 0.679, 1.078], ["500", 1.088, 1.627], ["Euro", 1.627, 2.004], ["Bleiben", 2.36, 2.694], ["270", 2.705, 3.61], ["Euro", 3.621, 4.03]]}, {"text": "Also: Alle Mann an die Mauer, wir bauen!", "start": 29.282, "end": 32.306, "spec": {"type": "build", "mood": "bright"}, "afx": null, "words": [["Also", 0.097, 0.442], ["Alle", 0.819, 1.002], ["Mann", 1.002, 1.185], ["an", 1.196, 1.272], ["die", 1.272, 1.358], ["Mauer", 1.369, 1.713], ["wir", 2.101, 2.295], ["bauen", 2.306, 2.716]]}, {"text": "Probeschuss! Drei, zwei, eins…", "start": 32.426, "end": 35.33, "spec": {"type": "countdown", "mood": "calm"}, "afx": null, "words": [["Probeschuss", 0.086, 0.657], ["Drei", 1.013, 1.196], ["zwei", 1.487, 1.864], ["eins", 2.123, 2.597]]}, {"text": "Feuer!", "start": 35.45, "end": 36.266, "spec": {"type": "fire"}, "afx": null, "words": [["Feuer", 0.119, 0.506]]}, {"text": "Platsch! Der Schuss ging daneben.", "start": 36.386, "end": 38.45, "spec": {"type": "splash", "mood": "bright"}, "afx": null, "words": [["Platsch", 0.097, 0.453], ["Der", 0.787, 0.884], ["Schuss", 0.884, 1.099], ["ging", 1.11, 1.272], ["daneben", 1.272, 1.735]]}, {"text": "Doch dann treibt eine Flaschenpost an unseren Strand.", "start": 38.57, "end": 41.378, "spec": {"type": "bottle", "mood": "calm"}, "afx": null, "words": [["Doch", 0.086, 0.172], ["dann", 0.172, 0.323], ["treibt", 0.334, 0.625], ["eine", 0.625, 0.797], ["Flaschenpost", 0.797, 1.509], ["an", 1.509, 1.692], ["unseren", 1.692, 2.026], ["Strand", 2.037, 2.478]]}, {"text": "Die Eckköpfe schreiben: Lasst uns handeln statt schießen!", "start": 41.498, "end": 44.522, "spec": {"type": "letter"}, "afx": null, "words": [["Die", 0.086, 0.194], ["Eckköpfe", 0.194, 0.657], ["schreiben", 0.668, 1.078], ["Lasst", 1.422, 1.616], ["uns", 1.616, 1.735], ["handeln", 1.735, 2.037], ["statt", 2.047, 2.252], ["schießen", 2.263, 2.705]]}, {"text": "Also: Handeln wir mit den Eckköpfen?", "start": 44.642, "end": 46.946, "spec": {"type": "trade", "mood": "bright"}, "afx": null, "words": [["Also", 0.097, 0.409], ["Handeln", 0.765, 1.078], ["wir", 1.078, 1.196], ["mit", 1.196, 1.293], ["den", 1.293, 1.422], ["Eckköpfen", 1.422, 1.983]]}, {"text": "Oder rüsten wir weiter auf, mit einer zweiten Kanone?", "start": 47.066, "end": 50.354, "spec": {"type": "arms"}, "afx": null, "words": [["Oder", 0.086, 0.28], ["rüsten", 0.291, 0.647], ["wir", 0.647, 0.787], ["weiter", 0.787, 1.164], ["auf", 1.164, 1.487], ["mit", 1.756, 1.875], ["einer", 1.875, 2.069], ["zweiten", 2.08, 2.478], ["Kanone", 2.478, 2.953]]}, {"text": "Der Top-Kommentar entscheidet.", "start": 50.474, "end": 52.346, "spec": {"type": "comment"}, "afx": null, "words": [["Der", 0.086, 0.194], ["Top-Kommentar", 0.194, 0.937], ["entscheidet", 0.938, 1.541]]}], "dur": 53.75}