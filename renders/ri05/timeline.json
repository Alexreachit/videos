{"lines": [{"text": "Tag fünf auf Roundhead Island! Und gleich da drüben wohnen die Eckköpfe.", "start": 0.05, "end": 4.202, "spec": {"type": "map", "mood": "bright"}, "afx": null, "words": [["Tag", 0.086, 0.28], ["fünf", 0.28, 0.55], ["auf", 0.56, 0.722], ["Roundhead", 0.722, 1.056], ["Island", 1.067, 1.368], ["Und", 1.703, 1.8], ["gleich", 1.8, 2.134], ["da", 2.134, 2.317], ["drüben", 2.317, 2.726], ["wohnen", 2.737, 3.05], ["die", 3.05, 3.19], ["Eckköpfe", 3.2, 3.825]]}, {"text": "Gestern bauten die Nachbarn ein Katapult.", "start": 4.322, "end": 6.794, "spec": {"type": "recap", "mood": "calm"}, "afx": null, "words": [["Gestern", 0.086, 0.366], ["bauten", 0.366, 0.711], ["die", 0.711, 0.819], ["Nachbarn", 0.83, 1.358], ["ein", 1.369, 1.498], ["Katapult", 1.498, 2.134]]}, {"text": "Ihr habt abgestimmt: 61 Prozent für die Kanone!", "start": 6.914, "end": 10.49, "spec": {"type": "vote", "mood": "bright"}, "afx": null, "words": [["Ihr", 0.097, 0.215], ["habt", 0.215, 0.539], ["abgestimmt", 0.539, 1.131], ["61 Prozent", 1.498, 2.608], ["für", 2.608, 2.705], ["die", 2.705, 2.78], ["Kanone", 2.791, 3.254]]}, {"text": "13 neue Bürger! Wir sind jetzt 141 Einwohner.", "start": 10.61, "end": 14.69, "spec": {"type": "crowd"}, "afx": null, "words": [["13", 0.086, 0.442], ["neue", 0.442, 0.7], ["Bürger", 0.711, 1.131], ["Wir", 1.487, 1.595], ["sind", 1.595, 1.746], ["jetzt", 1.746, 2.058], ["141 Einwohner", 2.069, 3.75]]}, {"text": "Eure 34 Herzen bringen 340 Euro!", "start": 14.81, "end": 18.554, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.086, 0.366], ["34 Herzen", 0.377, 1.692], ["bringen", 1.692, 2.037], ["340 Euro", 2.047, 3.405]]}, {"text": "Ein neuer Bürger wollte eine Gurke sein. Wunsch erfüllt!", "start": 18.674, "end": 22.082, "spec": {"type": "gurke"}, "afx": null, "words": [["Ein", 0.097, 0.237], ["neuer", 0.237, 0.506], ["Bürger", 0.517, 0.841], ["wollte", 0.851, 1.164], ["eine", 1.164, 1.369], ["Gurke", 1.369, 1.681], ["sein", 1.681, 2.015], ["Wunsch", 2.371, 2.586], ["erfüllt", 2.586, 3.082]]}, {"text": "Und wer sich einen Hund gewünscht hat: Hier ist er!", "start": 22.202, "end": 25.13, "spec": {"type": "hund", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.172], ["wer", 0.172, 0.28], ["sich", 0.291, 0.453], ["einen", 0.453, 0.668], ["Hund", 0.679, 0.938], ["gewünscht", 0.938, 1.347], ["hat", 1.347, 1.552], ["Hier", 1.897, 2.112], ["ist", 2.123, 2.338], ["er", 2.338, 2.608]]}, {"text": "Die Kanone kostet 500 Euro. Bleiben 270 Euro.", "start": 25.25, "end": 29.498, "spec": {"type": "money2"}, "afx": null, "words": [["Die", 0.086, 0.151], ["Kanone", 0.162, 0.636], ["kostet", 0.636, 1.045], ["500 Euro", 1.056, 1.961], ["Bleiben", 2.328, 2.64], ["270 Euro", 2.651, 3.922]]}, {"text": "Also: Alle Mann an die Mauer, wir bauen!", "start": 29.618, "end": 32.498, "spec": {"type": "build", "mood": "bright"}, "afx": null, "words": [["Also", 0.097, 0.431], ["Alle", 0.776, 0.938], ["Mann", 0.948, 1.099], ["an", 1.099, 1.185], ["die", 1.185, 1.261], ["Mauer", 1.261, 1.595], ["wir", 1.983, 2.144], ["bauen", 2.155, 2.554]]}, {"text": "Probeschuss! Drei, zwei, eins…", "start": 32.618, "end": 35.57, "spec": {"type": "countdown", "mood": "calm"}, "afx": null, "words": [["Probeschuss", 0.075, 0.733], ["Drei", 1.078, 1.282], ["zwei", 1.552, 1.918], ["eins", 2.188, 2.651]]}, {"text": "Feuer!", "start": 35.69, "end": 36.506, "spec": {"type": "fire"}, "afx": null, "words": [["Feuer", 0.119, 0.485]]}, {"text": "Platsch! Knapp vor Squarehead Island.", "start": 36.626, "end": 39.146, "spec": {"type": "splash", "mood": "bright"}, "afx": null, "words": [["Platsch", 0.097, 0.453], ["Knapp", 0.797, 1.034], ["vor", 1.099, 1.347], ["Squarehead", 1.358, 1.853], ["Island", 1.853, 2.209]]}, {"text": "Doch dann treibt eine Flaschenpost an unseren Strand.", "start": 39.266, "end": 42.026, "spec": {"type": "bottle", "mood": "calm"}, "afx": null, "words": [["Doch", 0.097, 0.194], ["dann", 0.205, 0.345], ["treibt", 0.345, 0.647], ["eine", 0.647, 0.808], ["Flaschenpost", 0.808, 1.498], ["an", 1.498, 1.659], ["unseren", 1.67, 1.994], ["Strand", 2.004, 2.435]]}, {"text": "Die Eckköpfe schreiben: Lasst uns handeln statt schießen!", "start": 42.146, "end": 45.266, "spec": {"type": "letter"}, "afx": null, "words": [["Die", 0.086, 0.194], ["Eckköpfe", 0.194, 0.69], ["schreiben", 0.69, 1.099], ["Lasst", 1.422, 1.627], ["uns", 1.627, 1.756], ["handeln", 1.767, 2.123], ["statt", 2.123, 2.338], ["schießen", 2.349, 2.802]]}, {"text": "Also: Handeln wir mit den Eckköpfen?", "start": 45.386, "end": 47.786, "spec": {"type": "trade", "mood": "bright"}, "afx": null, "words": [["Also", 0.097, 0.442], ["Handeln", 0.797, 1.121], ["wir", 1.121, 1.239], ["mit", 1.25, 1.347], ["den", 1.358, 1.476], ["Eckköpfen", 1.487, 2.091]]}, {"text": "Oder rüsten wir weiter auf, mit einer zweiten Kanone?", "start": 47.906, "end": 51.122, "spec": {"type": "arms"}, "afx": null, "words": [["Oder", 0.086, 0.259], ["rüsten", 0.259, 0.593], ["wir", 0.593, 0.733], ["weiter", 0.733, 1.099], ["auf", 1.099, 1.412], ["mit", 1.681, 1.81], ["einer", 1.81, 1.994], ["zweiten", 2.004, 2.381], ["Kanone", 2.381, 2.877]]}, {"text": "Der Top-Kommentar entscheidet.", "start": 51.242, "end": 53.114, "spec": {"type": "comment"}, "afx": null, "words": [["Der", 0.086, 0.183], ["Top-Kommentar", 0.183, 0.905], ["entscheidet", 0.916, 1.498]]}], "dur": 54.51}