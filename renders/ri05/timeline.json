{"lines": [{"text": "Tag fünf auf Roundhead Island! Und gleich da drüben wohnen die Eckköpfe.", "start": 0.05, "end": 4.346, "spec": {"type": "map", "mood": "bright"}, "afx": null, "words": [["Tag", 0.086, 0.28], ["fünf", 0.28, 0.582], ["auf", 0.593, 0.776], ["Roundhead", 0.787, 1.121], ["Island", 1.131, 1.455], ["Und", 1.81, 1.907], ["gleich", 1.918, 2.231], ["da", 2.231, 2.381], ["drüben", 2.392, 2.791], ["wohnen", 2.791, 3.136], ["die", 3.147, 3.297], ["Eckköpfe", 3.308, 3.966]]}, {"text": "Gestern bauten die Nachbarn ein Katapult.", "start": 4.466, "end": 6.938, "spec": {"type": "recap", "mood": "calm"}, "afx": null, "words": [["Gestern", 0.086, 0.388], ["bauten", 0.399, 0.744], ["die", 0.754, 0.851], ["Nachbarn", 0.851, 1.369], ["ein", 1.369, 1.487], ["Katapult", 1.487, 2.134]]}, {"text": "Ihr habt abgestimmt: 61 Prozent für die Kanone!", "start": 7.058, "end": 10.538, "spec": {"type": "vote", "mood": "bright"}, "afx": null, "words": [["Ihr", 0.097, 0.205], ["habt", 0.205, 0.496], ["abgestimmt", 0.496, 1.078], ["61 Prozent", 1.412, 2.489], ["für", 2.489, 2.586], ["die", 2.597, 2.672], ["Kanone", 2.683, 3.168]]}, {"text": "13 neue Bürger! Wir sind jetzt 141 Einwohner.", "start": 10.658, "end": 14.834, "spec": {"type": "crowd"}, "afx": null, "words": [["13", 0.086, 0.474], ["neue", 0.485, 0.754], ["Bürger", 0.765, 1.196], ["Wir", 1.552, 1.67], ["sind", 1.681, 1.821], ["jetzt", 1.821, 2.112], ["141 Einwohner", 2.123, 3.858]]}, {"text": "Eure 34 Herzen bringen 340 Euro!", "start": 14.954, "end": 18.698, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.086, 0.377], ["34 Herzen", 0.388, 1.713], ["bringen", 1.724, 2.069], ["340 Euro", 2.08, 3.416]]}, {"text": "Ein neuer Bürger wollte eine Gurke sein. Wunsch erfüllt!", "start": 18.818, "end": 22.322, "spec": {"type": "gurke"}, "afx": null, "words": [["Ein", 0.097, 0.237], ["neuer", 0.237, 0.506], ["Bürger", 0.517, 0.873], ["wollte", 0.884, 1.239], ["eine", 1.239, 1.433], ["Gurke", 1.444, 1.735], ["sein", 1.735, 2.069], ["Wunsch", 2.425, 2.662], ["erfüllt", 2.672, 3.179]]}, {"text": "Und wer sich einen Hund gewünscht hat: Hier ist er!", "start": 22.442, "end": 25.298, "spec": {"type": "hund", "mood": "bright"}, "afx": null, "words": [["Und", 0.075, 0.162], ["wer", 0.162, 0.269], ["sich", 0.28, 0.453], ["einen", 0.453, 0.647], ["Hund", 0.647, 0.862], ["gewünscht", 0.873, 1.261], ["hat", 1.261, 1.444], ["Hier", 1.832, 2.015], ["ist", 2.026, 2.263], ["er", 2.263, 2.532]]}, {"text": "Die Kanone kostet 500 Euro. Bleiben 270 Euro.", "start": 25.418, "end": 29.666, "spec": {"type": "money2"}, "afx": null, "words": [["Die", 0.086, 0.162], ["Kanone", 0.162, 0.593], ["kostet", 0.593, 1.002], ["500 Euro", 1.002, 1.918], ["Bleiben", 2.284, 2.586], ["270 Euro", 2.597, 3.933]]}, {"text": "Also: Alle Mann an die Mauer, wir bauen!", "start": 29.786, "end": 32.762, "spec": {"type": "build", "mood": "bright"}, "afx": null, "words": [["Also", 0.097, 0.442], ["Alle", 0.808, 0.991], ["Mann", 1.002, 1.164], ["an", 1.164, 1.25], ["die", 1.25, 1.325], ["Mauer", 1.325, 1.659], ["wir", 2.08, 2.252], ["bauen", 2.252, 2.651]]}, {"text": "Probeschuss! Drei, zwei, eins…", "start": 32.882, "end": 35.978, "spec": {"type": "countdown", "mood": "calm"}, "afx": null, "words": [["Probeschuss", 0.086, 0.754], ["Drei", 1.099, 1.304], ["zwei", 1.616, 1.972], ["eins", 2.306, 2.759]]}, {"text": "Feuer!", "start": 36.098, "end": 36.89, "spec": {"type": "fire"}, "afx": null, "words": [["Feuer", 0.119, 0.485]]}, {"text": "Platsch! Knapp vor Squarehead Island.", "start": 37.01, "end": 39.482, "spec": {"type": "splash", "mood": "bright"}, "afx": null, "words": [["Platsch", 0.097, 0.485], ["Knapp", 0.841, 1.067], ["vor", 1.153, 1.336], ["Squarehead", 1.336, 1.789], ["Island", 1.8, 2.155]]}, {"text": "Doch dann treibt eine Flaschenpost an unseren Strand.", "start": 39.602, "end": 42.458, "spec": {"type": "bottle", "mood": "calm"}, "afx": null, "words": [["Doch", 0.086, 0.172], ["dann", 0.172, 0.345], ["treibt", 0.356, 0.657], ["eine", 0.657, 0.819], ["Flaschenpost", 0.819, 1.541], ["an", 1.541, 1.746], ["unseren", 1.756, 2.08], ["Strand", 2.08, 2.522]]}, {"text": "Die Eckköpfe schreiben: Lasst uns handeln statt schießen!", "start": 42.578, "end": 45.698, "spec": {"type": "letter"}, "afx": null, "words": [["Die", 0.086, 0.205], ["Eckköpfe", 0.215, 0.668], ["schreiben", 0.668, 1.045], ["Lasst", 1.39, 1.606], ["uns", 1.616, 1.746], ["handeln", 1.746, 2.09], ["statt", 2.091, 2.295], ["schießen", 2.295, 2.78]]}, {"text": "Also: Handeln wir mit den Eckköpfen?", "start": 45.818, "end": 48.218, "spec": {"type": "trade", "mood": "bright"}, "afx": null, "words": [["Also", 0.097, 0.42], ["Handeln", 0.797, 1.131], ["wir", 1.142, 1.261], ["mit", 1.261, 1.358], ["den", 1.358, 1.487], ["Eckköpfen", 1.487, 2.08]]}, {"text": "Oder rüsten wir weiter auf, mit einer zweiten Kanone?", "start": 48.338, "end": 51.578, "spec": {"type": "arms"}, "afx": null, "words": [["Oder", 0.097, 0.28], ["rüsten", 0.28, 0.625], ["wir", 0.625, 0.776], ["weiter", 0.776, 1.142], ["auf", 1.153, 1.476], ["mit", 1.746, 1.875], ["einer", 1.875, 2.058], ["zweiten", 2.058, 2.435], ["Kanone", 2.435, 2.92]]}, {"text": "Der Top-Kommentar entscheidet.", "start": 51.698, "end": 53.57, "spec": {"type": "comment"}, "afx": null, "words": [["Der", 0.086, 0.172], ["Top-Kommentar", 0.172, 0.937], ["entscheidet", 0.938, 1.552]]}], "dur": 54.97}