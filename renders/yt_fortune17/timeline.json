"ink", "out": [1, 0]}, {"e": "tx", "txt": "$1 BILLION", "x": 1340, "y": 620, "size": 110, "at": 0.45, "col": "green", "out": [1, 0]}, {"e": "obj", "k": "samthink", "x": 520, "y": 620, "w": 400, "at": 0, "out": [1, 0]}]}, "afx": null, "words": [["Its", 0.1, 0.213], ["founder", 0.212, 0.75], ["Mark", 0.95, 1.15], ["Zuckerberg", 1.15, 1.762], ["was", 1.775, 1.912], ["twenty-two", 1.925, 2.5], ["One", 2.9, 3.125], ["billion", 3.138, 3.438], ["dollars", 3.45, 3.888], ["at", 3.975, 4.075], ["twenty-two", 4.088, 4.713]]}, {"text": "He said no. According to the book An Ugly Truth, he told his advisers he wouldn't know what to do with the money, and would probably just build another Facebook.", "start": 273.672, "end": 282.384, "spec": {"type": "beat", "scene": "fb", "els": [{"e": "deal", "x": 960, "y": 360, "press": 0.15, "at": 0, "out": [1, 0]}, {"e": "letter", "x": 960, "y": 640, "w": 900, "head": "ACCORDING TO “AN UGLY TRUTH”", "body": "He wouldn't know what to do with the money – he'd probably just build another Facebook.", "at": 0.45, "out": [1, 0]}]}, "afx": null, "words": [["He", 0.1, 0.15], ["said", 0.15, 0.387], ["no", 0.388, 0.7], ["According", 1.087, 1.425], ["to", 1.438, 1.488], ["the", 1.488, 1.575], ["book", 1.575, 1.812], ["An", 1.812, 1.9], ["Ugly", 1.913, 2.175], ["Truth", 2.175, 2.688], ["he", 3.05, 3.112], ["told", 3.112, 3.325], ["his", 3.325, 3.438], ["advisers", 3.438, 4.062], ["he", 4.075, 4.175], ["wouldn't", 4.175, 4.438], ["know", 4.438, 4.688], ["what", 4.7, 4.875], ["to", 4.875, 4.95], ["do", 4.95, 5.225], ["with", 5.237, 5.337], ["the", 5.338, 5.4], ["money", 5.4, 5.775], ["and", 6.2, 6.312], ["would", 6.312, 6.45], ["probably", 6.45, 6.925], ["just", 6.938, 7.15], ["build", 7.15, 7.388], ["another", 7.388, 7.688], ["Facebook", 7.688, 8.35]]}, {"text": "Many people in the company thought he was crazy. Zuckerberg later said that after he turned it down, huge numbers of people quit.", "start": 282.864, "end": 290.712, "spec": {"type": "beat", "sce