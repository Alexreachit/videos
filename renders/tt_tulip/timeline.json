{"lines": [{"text": "Why you should never buy something just because everyone else is.", "start": 0.05, "end": 3.17, "spec": {"type": "hero"}, "words": [["Why", 0.086, 0.183], ["you", 0.183, 0.248], ["should", 0.248, 0.399], ["never", 0.399, 0.603], ["buy", 0.614, 0.722], ["something", 0.733, 1.164], ["just", 1.282, 1.433], ["because", 1.433, 1.864], ["everyone", 1.875, 2.198], ["else", 2.209, 2.468], ["is", 2.478, 2.823]]}, {"text": "In the sixteen-thirties, tulips became the hottest thing to trade in Holland.", "start": 3.25, "end": 7.09, "spec": {"type": "holland"}, "words": [["In", 0.065, 0.119], ["the", 0.119, 0.183], ["sixteen-thirties", 0.194, 1.088], ["tulips", 1.282, 1.627], ["became", 1.627, 1.95], ["the", 1.95, 2.015], ["hottest", 2.015, 2.446], ["thing", 2.446, 2.672], ["to", 2.683, 2.748], ["trade", 2.748, 3.05], ["in", 3.05, 3.114], ["Holland", 3.114, 3.524]]}, {"text": "Within weeks, one bulb got twelve times more expensive.", "start": 7.17, "end": 10.362, "spec": {"type": "rise"}, "words": [["Within", 0.097, 0.334], ["weeks", 0.334, 0.754], ["one", 0.765, 1.024], ["bulb", 1.024, 1.293], ["got", 1.304, 1.498], ["twelve", 1.498, 1.875], ["times", 1.875, 2.177], ["more", 2.177, 2.306], ["expensive", 2.306, 2.866]]}, {"text": "The priciest one sold for five thousand guilders. That's the price of a nice house.", "start": 10.442, "end": 15.17, "spec": {"type": "house"}, "words": [["The", 0.086, 0.14], ["priciest", 0.14, 0.679], ["one", 0.679, 0.916], ["sold", 0.916, 1.315], ["for", 1.325, 1.465], ["five", 1.466, 1.886], ["thousand", 1.886, 2.306], ["guilders", 2.306, 2.823], ["That's", 3.179, 3.308], ["the", 3.308, 3.384], ["price", 3.384, 3.675], ["of", 3.675, 3.707], ["a", 3.707, 3.728], ["nice", 3.728, 3.976], ["house", 3.976, 4.407]]}, {"text": "A craftsman earned about three hundred a year.", "start": 15.25, "end": 17.722, "spec": {"type": "wage"}, "words": [["A", 0.075, 0.108], ["craftsman", 0.108, 0.614], ["earned", 0.733, 0.884], ["about", 0.884, 1