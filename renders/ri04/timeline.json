{"lines": [{"text": "Tag vier auf Roundhead Island!", "start": 0.05, "end": 1.922, "spec": {"type": "day", "mood": "bright"}, "afx": null, "words": [["Tag", 0.086, 0.269], ["vier", 0.269, 0.517], ["auf", 0.517, 0.657], ["Roundhead", 0.657, 1.002], ["Island", 1.002, 1.325]]}, {"text": "Gestern hieß es: Mauer oder Frieden?", "start": 2.042, "end": 4.634, "spec": {"type": "recap", "mood": "calm"}, "afx": null, "words": [["Gestern", 0.086, 0.377], ["hieß", 0.377, 0.69], ["es", 0.69, 0.937], ["Mauer", 1.282, 1.595], ["oder", 1.595, 1.8], ["Frieden", 1.8, 2.263]]}, {"text": "Und die Mauer hat gewonnen!", "start": 4.754, "end": 6.626, "spec": {"type": "vote", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.205], ["die", 0.215, 0.334], ["Mauer", 0.345, 0.657], ["hat", 0.657, 0.819], ["gewonnen", 0.83, 1.25]]}, {"text": "Wir sind 128 Einwohner. Holt eure Freunde, jeder Follower ist ein neuer Bürger!", "start": 6.746, "end": 12.266, "spec": {"type": "crowd"}, "afx": null, "words": [["Wir", 0.086, 0.172], ["sind", 0.183, 0.345], ["128 Einwohner", 0.345, 1.994], ["Holt", 2.349, 2.5], ["eure", 2.5, 2.78], ["Freunde", 2.791, 3.244], ["jeder", 3.567, 3.782], ["Follower", 3.782, 4.224], ["ist", 4.224, 4.375], ["ein", 4.375, 4.537], ["neuer", 4.537, 4.795], ["Bürger", 4.806, 5.205]]}, {"text": "Eure Likes bringen 350 Euro!", "start": 12.386, "end": 14.666, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.086, 0.269], ["Likes", 0.269, 0.442], ["bringen", 0.453, 0.744], ["350 Euro", 0.754, 1.94]]}, {"text": "Die Mauer kostet 1500 Euro. Bleiben 430 Euro.", "start": 14.786, "end": 19.418, "spec": {"type": "money2"}, "afx": null, "words": [["Die", 0.086, 0.172], ["Mauer", 0.183, 0.463], ["kostet", 0.463, 0.819], ["1500 Euro", 0.819, 2.274], ["Bleiben", 2.629, 2.942], ["430 Euro", 2.942, 4.31]]}, {"text": "Also: Alle Mann an die Steine!", "start": 19.538, "end": 21.722, "spec": {"type": "build", "mood": "bright"}, "afx": null, "words": [["Also", 0.097, 0.442], ["Alle", 0.862, 1.034], ["Mann", 1.034, 1.261], ["an", 1.261, 1.336], ["die", 1.336, 1.422], ["Steine", 1.433, 1.875]]}, {"text": "Benluca passt auf, dass alles schön gerade wird.", "start": 21.842, "end": 24.794, "spec": {"type": "build2"}, "afx": null, "words": [["Benluca", 0.097, 0.474], ["passt", 0.474, 0.83], ["auf", 0.841, 1.121], ["dass", 1.315, 1.498], ["alles", 1.498, 1.746], ["schön", 1.756, 1.994], ["gerade", 2.004, 2.338], ["wird", 2.338, 2.64]]}, {"text": "Und fertig ist die große Mauer!", "start": 24.914, "end": 26.858, "spec": {"type": "done", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.183], ["fertig", 0.194, 0.603], ["ist", 0.603, 0.722], ["die", 0.733, 0.841], ["große", 0.851, 1.239], ["Mauer", 1.239, 1.638]]}, {"text": "In der Nacht kommen die Eckköpfe mit Fackeln.", "start": 26.978, "end": 29.258, "spec": {"type": "night", "mood": "calm"}, "afx": null, "words": [["In", 0.086, 0.14], ["der", 0.14, 0.237], ["Nacht", 0.248, 0.506], ["kommen", 0.517, 0.711], ["die", 0.711, 0.862], ["Eckköpfe", 0.862, 1.358], ["mit", 1.358, 1.509], ["Fackeln", 1.519, 1.95]]}, {"text": "Und krachen direkt gegen die Mauer!", "start": 29.378, "end": 31.25, "spec": {"type": "crash"}, "afx": null, "words": [["Und", 0.065, 0.162], ["krachen", 0.162, 0.485], ["direkt", 0.485, 0.873], ["gegen", 0.873, 1.099], ["die", 1.099, 1.185], ["Mauer", 1.185, 1.519]]}, {"text": "Wütend rudern sie zurück. Unsere Mauer hält!", "start": 31.37, "end": 34.466, "spec": {"type": "hold", "mood": "bright"}, "afx": null, "words": [["Wütend", 0.086, 0.474], ["rudern", 0.485, 0.884], ["sie", 0.884, 1.034], ["zurück", 1.045, 1.487], ["Unsere", 1.843, 2.112], ["Mauer", 2.123, 2.392], ["hält", 2.392, 2.759]]}, {"text": "Doch am Morgen schaut Sam durchs Fernglas.", "start": 34.586, "end": 36.962, "spec": {"type": "morning", "mood": "calm"}, "afx": null, "words": [["Doch", 0.086, 0.205], ["am", 0.215, 0.291], ["Morgen", 0.291, 0.571], ["schaut", 0.571, 0.884], ["Sam", 0.894, 1.164], ["durchs", 1.164, 1.336], ["Fernglas", 1.336, 2.037]]}, {"text": "Die Nachbarn bauen ein riesiges Katapult!", "start": 37.082, "end": 39.626, "spec": {"type": "catapult"}, "afx": null, "words": [["Die", 0.086, 0.151], ["Nachbarn", 0.162, 0.593], ["bauen", 0.603, 0.916], ["ein", 0.927, 1.088], ["riesiges", 1.099, 1.584], ["Katapult", 1.595, 2.22]]}, {"text": "Bauen wir eine eigene Kanone?", "start": 39.746, "end": 41.618, "spec": {"type": "cannon", "mood": "bright"}, "afx": null, "words": [["Bauen", 0.097, 0.291], ["wir", 0.291, 0.399], ["eine", 0.399, 0.614], ["eigene", 0.614, 0.927], ["Kanone", 0.938, 1.455]]}, {"text": "Oder schicken wir Benluca als Friedensboten mit einem Geschenk?", "start": 41.738, "end": 45.17, "spec": {"type": "peace"}, "afx": null, "words": [["Oder", 0.086, 0.248], ["schicken", 0.248, 0.55], ["wir", 0.55, 0.69], ["Benluca", 0.7, 1.412], ["als", 1.412, 1.595], ["Friedensboten", 1.595, 2.349], ["mit", 2.349, 2.468], ["einem", 2.468, 2.662], ["Geschenk", 2.662, 3.114]]}, {"text": "Der Top-Kommentar entscheidet.", "start": 45.29, "end": 47.162, "spec": {"type": "comment"}, "afx": null, "words": [["Der", 0.086, 0.172], ["Top-Kommentar", 0.172, 0.937], ["entscheidet", 0.938, 1.552]]}], "dur": 48.56}