{"lines": [{"text": "Tag vier auf Roundhead Island!", "start": 0.05, "end": 2.378, "spec": {"type": "day", "mood": "bright"}, "afx": null, "words": [["Tag", 0.095, 0.318], ["vier", 0.351, 0.53], ["auf", 0.586, 0.742], ["Roundhead", 0.787, 1.11], ["Island", 1.166, 1.512]]}, {"text": "Gestern hieß es: Mauer oder Frieden?", "start": 2.498, "end": 5.354, "spec": {"type": "recap", "mood": "calm"}, "afx": null, "words": [["Gestern", 0.095, 0.474], ["hieß", 0.485, 0.664], ["es", 0.709, 0.921], ["Mauer", 1.043, 1.278], ["oder", 1.356, 1.546], ["Frieden", 1.557, 1.936]]}, {"text": "Und die Mauer hat gewonnen!", "start": 5.474, "end": 7.586, "spec": {"type": "vote", "mood": "bright"}, "afx": null, "words": [["Und", 0.095, 0.273], ["die", 0.284, 0.351], ["Mauer", 0.385, 0.552], ["hat", 0.586, 0.731], ["gewonnen", 0.798, 1.222]]}, {"text": "Wir sind 128 Einwohner. Holt eure Freunde, jeder Follower ist ein neuer Bürger!", "start": 7.706, "end": 14.666, "spec": {"type": "crowd"}, "afx": null, "words": [["Wir", 0.095, 0.329], ["sind", 0.34, 0.519], ["128 Einwohner", 0.575, 2.293], ["Holt", 3.181, 3.437], ["eure", 3.504, 3.739], ["Freunde", 3.75, 4.196], ["jeder", 4.375, 4.643], ["Follower", 4.665, 5.045], ["ist", 5.1, 5.246], ["ein", 5.301, 5.424], ["neuer", 5.446, 5.658], ["Bürger", 5.714, 6.038]]}, {"text": "Eure 35 Likes bringen 350 Euro!", "start": 14.786, "end": 18.794, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.095, 0.418], ["35", 0.429, 1.211], ["Likes", 1.255, 1.479], ["bringen", 1.546, 1.836], ["350 Euro", 1.858, 3.086]]}, {"text": "Die Mauer kostet 1500 Euro. Bleiben 430 Euro.", "start": 18.914, "end": 24.314, "spec": {"type": "money2"}, "afx": null, "words": [["Die", 0.095, 0.206], ["Mauer", 0.24, 0.407], ["kostet", 0.474, 0.775], ["1500 Euro", 0.831, 2.081], ["Bleiben", 2.98, 3.337], ["430 Euro", 3.348, 4.487]]}, {"text": "Also: Alle Mann an die Steine!", "start": 24.434, "end": 27.026, "spec": {"type": "build", "mood": "bright"}, "afx": null, "words": [["Also", 0.095, 0.496], ["Alle", 0.675, 0.865], ["Mann", 0.887, 1.043], ["an", 1.088, 1.177], ["die", 1.211, 1.266], ["Steine", 1.311, 1.713]]}, {"text": "Benluca passt auf, dass alles schön gerade wird.", "start": 27.146, "end": 30.386, "spec": {"type": "build2"}, "afx": null, "words": [["Benluca", 0.095, 0.485], ["passt", 0.53, 0.742], ["auf", 0.798, 1.01], ["dass", 1.177, 1.333], ["alles", 1.389, 1.601], ["schön", 1.624, 1.791], ["gerade", 1.825, 2.126], ["wird", 2.148, 2.383]]}, {"text": "Und fertig ist die große Mauer!", "start": 30.506, "end": 32.93, "spec": {"type": "done", "mood": "bright"}, "afx": null, "words": [["Und", 0.095, 0.251], ["fertig", 0.273, 0.641], ["ist", 0.686, 0.809], ["die", 0.82, 0.865], ["große", 0.932, 1.222], ["Mauer", 1.244, 1.523]]}, {"text": "In der Nacht kommen die Eckköpfe mit Fackeln.", "start": 33.05, "end": 35.81, "spec": {"type": "night", "mood": "calm"}, "afx": null, "words": [["In", 0.095, 0.206], ["der", 0.229, 0.307], ["Nacht", 0.34, 0.519], ["kommen", 0.586, 0.809], ["die", 0.82, 0.876], ["Eckköpfe", 0.943, 1.322], ["mit", 1.356, 1.456], ["Fackeln", 1.49, 1.88]]}, {"text": "Und krachen direkt gegen die Mauer!", "start": 35.93, "end": 38.474, "spec": {"type": "crash"}, "afx": null, "words": [["Und", 0.095, 0.262], ["krachen", 0.307, 0.619], ["direkt", 0.653, 0.921], ["gegen", 1.021, 1.255], ["die", 1.278, 1.333], ["Mauer", 1.367, 1.646]]}, {"text": "Wütend rudern sie zurück. Unsere Mauer hält!", "start": 38.594, "end": 42.458, "spec": {"type": "hold", "mood": "bright"}, "afx": null, "words": [["Wütend", 0.095, 0.429], ["rudern", 0.463, 0.742], ["sie", 0.753, 0.842], ["zurück", 0.898, 1.222], ["Unsere", 2.109, 2.478], ["Mauer", 2.5, 2.679], ["hält", 2.723, 3.013]]}, {"text": "Doch am Morgen schaut Sam durchs Fernglas.", "start": 42.578, "end": 45.386, "spec": {"type": "morning", "mood": "calm"}, "afx": null, "words": [["Doch", 0.095, 0.273], ["am", 0.329, 0.396], ["Morgen", 0.396, 0.709], ["schaut", 0.72, 0.965], ["Sam", 1.01, 1.188], ["durchs", 1.222, 1.423], ["Fernglas", 1.445, 1.981]]}, {"text": "Die Nachbarn bauen ein riesiges Katapult!", "start": 45.506, "end": 48.434, "spec": {"type": "catapult"}, "afx": null, "words": [["Die", 0.095, 0.217], ["Nachbarn", 0.251, 0.63], ["bauen", 0.675, 0.887], ["ein", 0.932, 1.066], ["riesiges", 1.099, 1.479], ["Katapult", 1.534, 2.059]]}, {"text": "Bauen wir eine eigene Kanone?", "start": 48.554, "end": 51.026, "spec": {"type": "cannon", "mood": "bright"}, "afx": null, "words": [["Bauen", 0.095, 0.34], ["wir", 0.362, 0.474], ["eine", 0.53, 0.697], ["eigene", 0.775, 1.066], ["Kanone", 1.11, 1.59]]}, {"text": "Oder schicken wir Benluca als Friedensboten mit einem Geschenk?", "start": 51.146, "end": 54.89, "spec": {"type": "peace"}, "afx": null, "words": [["Oder", 0.095, 0.396], ["schicken", 0.407, 0.686], ["wir", 0.72, 0.798], ["Benluca", 0.842, 1.211], ["als", 1.266, 1.456], ["Friedensboten", 1.467, 2.193], ["mit", 2.204, 2.293], ["einem", 2.349, 2.528], ["Geschenk", 2.55, 2.896]]}, {"text": "Der Top-Kommentar entscheidet.", "start": 55.01, "end": 57.314, "spec": {"type": "comment"}, "afx": null, "words": [["Der", 0.095, 0.229], ["Top-Kommentar", 0.273, 0.887], ["entscheidet", 0.932, 1.445]]}], "dur": 58.71}