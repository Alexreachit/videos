{"lines": [{"text": "Tag vier auf Roundhead Island!", "start": 0.05, "end": 1.922, "spec": {"type": "day", "mood": "bright"}, "afx": null, "words": [["Tag", 0.086, 0.269], ["vier", 0.269, 0.517], ["auf", 0.517, 0.657], ["Roundhead", 0.657, 1.002], ["Island", 1.002, 1.325]]}, {"text": "Gestern hieß es: Mauer oder Frieden?", "start": 2.042, "end": 4.634, "spec": {"type": "recap", "mood": "calm"}, "afx": null, "words": [["Gestern", 0.086, 0.377], ["hieß", 0.377, 0.69], ["es", 0.69, 0.937], ["Mauer", 1.282, 1.595], ["oder", 1.595, 1.8], ["Frieden", 1.8, 2.263]]}, {"text": "Und die Mauer hat gewonnen!", "start": 4.754, "end": 6.626, "spec": {"type": "vote", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.183], ["die", 0.194, 0.302], ["Mauer", 0.312, 0.603], ["hat", 0.603, 0.765], ["gewonnen", 0.765, 1.185]]}, {"text": "Wir sind 128 Einwohner. Holt eure Freunde, jeder Follower ist ein neuer Bürger!", "start": 6.746, "end": 12.458, "spec": {"type": "crowd"}, "afx": null, "words": [["Wir", 0.086, 0.194], ["sind", 0.194, 0.377], ["128 Einwohner", 0.388, 2.112], ["Holt", 2.478, 2.64], ["eure", 2.64, 2.888], ["Freunde", 2.899, 3.33], ["jeder", 3.653, 3.879], ["Follower", 3.879, 4.321], ["ist", 4.321, 4.472], ["ein", 4.472, 4.644], ["neuer", 4.655, 4.968], ["Bürger", 4.978, 5.388]]}, {"text": "Eure Herzen bringen uns 350 Euro!", "start": 12.578, "end": 15.674, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.097, 0.377], ["Herzen", 0.377, 0.744], ["bringen", 0.744, 1.088], ["uns", 1.088, 1.261], ["350 Euro", 1.272, 2.759]]}, {"text": "Die Mauer kostet 1500 Euro. Bleiben 430 Euro.", "start": 15.794, "end": 20.402, "spec": {"type": "money2"}, "afx": null, "words": [["Die", 0.086, 0.162], ["Mauer", 0.172, 0.496], ["kostet", 0.496, 0.862], ["1500 Euro", 0.862, 2.328], ["Bleiben", 2.672, 2.963], ["430 Euro", 2.963, 4.278]]}, {"text": "Also: Alle Mann an die Steine!", "start": 20.522, "end": 22.706, "spec": {"type": "build", "mood": "bright"}, "afx": null, "words": [["Also", 0.097, 0.442], ["Alle", 0.819, 1.002], ["Mann", 1.002, 1.207], ["an", 1.207, 1.293], ["die", 1.304, 1.401], ["Steine", 1.412, 1.853]]}, {"text": "Benluca passt auf, dass alles schön gerade wird.", "start": 22.826, "end": 25.922, "spec": {"type": "build2"}, "afx": null, "words": [["Benluca", 0.097, 0.474], ["passt", 0.474, 0.841], ["auf", 0.841, 1.121], ["dass", 1.422, 1.616], ["alles", 1.627, 1.864], ["schön", 1.864, 2.112], ["gerade", 2.123, 2.468], ["wird", 2.468, 2.769]]}, {"text": "Und fertig ist die große Mauer!", "start": 26.042, "end": 27.986, "spec": {"type": "done", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.183], ["fertig", 0.183, 0.614], ["ist", 0.614, 0.733], ["die", 0.744, 0.851], ["große", 0.851, 1.239], ["Mauer", 1.239, 1.616]]}, {"text": "In der Nacht kommen die Eckköpfe mit Fackeln.", "start": 28.106, "end": 30.314, "spec": {"type": "night", "mood": "calm"}, "afx": null, "words": [["In", 0.086, 0.14], ["der", 0.14, 0.215], ["Nacht", 0.215, 0.496], ["kommen", 0.496, 0.69], ["die", 0.69, 0.819], ["Eckköpfe", 0.83, 1.304], ["mit", 1.304, 1.433], ["Fackeln", 1.444, 1.886]]}, {"text": "Und krachen direkt gegen die Mauer!", "start": 30.434, "end": 32.33, "spec": {"type": "crash"}, "afx": null, "words": [["Und", 0.075, 0.172], ["krachen", 0.172, 0.506], ["direkt", 0.517, 0.916], ["gegen", 0.927, 1.142], ["die", 1.142, 1.218], ["Mauer", 1.218, 1.573]]}, {"text": "Wütend rudern sie zurück. Unsere Mauer hält!", "start": 32.45, "end": 35.57, "spec": {"type": "hold", "mood": "bright"}, "afx": null, "words": [["Wütend", 0.086, 0.442], ["rudern", 0.453, 0.873], ["sie", 0.873, 1.024], ["zurück", 1.034, 1.487], ["Unsere", 1.853, 2.134], ["Mauer", 2.144, 2.468], ["hält", 2.478, 2.812]]}, {"text": "Doch am Morgen schaut Sam durchs Fernglas.", "start": 35.69, "end": 38.018, "spec": {"type": "morning", "mood": "calm"}, "afx": null, "words": [["Doch", 0.086, 0.194], ["am", 0.194, 0.28], ["Morgen", 0.28, 0.571], ["schaut", 0.571, 0.884], ["Sam", 0.894, 1.153], ["durchs", 1.164, 1.358], ["Fernglas", 1.358, 2.015]]}, {"text": "Die Nachbarn bauen ein riesiges Katapult!", "start": 38.138, "end": 40.682, "spec": {"type": "catapult"}, "afx": null, "words": [["Die", 0.086, 0.151], ["Nachbarn", 0.151, 0.571], ["bauen", 0.571, 0.894], ["ein", 0.905, 1.078], ["riesiges", 1.088, 1.573], ["Katapult", 1.573, 2.209]]}, {"text": "Bauen wir eine eigene Kanone?", "start": 40.802, "end": 42.674, "spec": {"type": "cannon", "mood": "bright"}, "afx": null, "words": [["Bauen", 0.097, 0.302], ["wir", 0.302, 0.442], ["eine", 0.453, 0.722], ["eigene", 0.733, 1.045], ["Kanone", 1.045, 1.552]]}, {"text": "Oder schicken wir Benluca als Friedensboten mit einem Geschenk?", "start": 42.794, "end": 46.202, "spec": {"type": "peace"}, "afx": null, "words": [["Oder", 0.086, 0.237], ["schicken", 0.237, 0.539], ["wir", 0.539, 0.668], ["Benluca", 0.679, 1.336], ["als", 1.347, 1.541], ["Friedensboten", 1.541, 2.263], ["mit", 2.274, 2.392], ["einem", 2.392, 2.586], ["Geschenk", 2.597, 3.082]]}, {"text": "Der Top-Kommentar entscheidet.", "start": 46.322, "end": 48.194, "spec": {"type": "comment"}, "afx": null, "words": [["Der", 0.086, 0.183], ["Top-Kommentar", 0.183, 0.927], ["entscheidet", 0.927, 1.552]]}], "dur": 49.59}