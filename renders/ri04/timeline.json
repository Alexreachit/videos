{"lines": [{"text": "Tag vier auf Roundhead Island!", "start": 0.05, "end": 1.706, "spec": {"type": "day", "mood": "bright"}, "afx": null, "words": [["Tag", 0.086, 0.269], ["vier", 0.269, 0.517], ["auf", 0.517, 0.657], ["Roundhead", 0.657, 1.002], ["Island", 1.002, 1.325]]}, {"text": "Gestern hieß es: Mauer oder Frieden?", "start": 1.826, "end": 4.298, "spec": {"type": "recap", "mood": "calm"}, "afx": null, "words": [["Gestern", 0.086, 0.356], ["hieß", 0.356, 0.625], ["es", 0.625, 0.851], ["Mauer", 1.175, 1.476], ["oder", 1.476, 1.681], ["Frieden", 1.692, 2.144]]}, {"text": "Und die Mauer hat gewonnen!", "start": 4.418, "end": 6.29, "spec": {"type": "vote", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.205], ["die", 0.215, 0.334], ["Mauer", 0.345, 0.657], ["hat", 0.657, 0.819], ["gewonnen", 0.83, 1.25]]}, {"text": "Wir sind 128 Einwohner. Holt eure Freunde, jeder Follower ist ein neuer Bürger!", "start": 6.41, "end": 12.362, "spec": {"type": "crowd"}, "afx": null, "words": [["Wir", 0.086, 0.194], ["sind", 0.194, 0.377], ["128 Einwohner", 0.377, 2.134], ["Holt", 2.489, 2.672], ["eure", 2.672, 2.942], ["Freunde", 2.953, 3.416], ["jeder", 3.718, 3.987], ["Follower", 3.987, 4.472], ["ist", 4.472, 4.677], ["ein", 4.677, 4.871], ["neuer", 4.871, 5.205], ["Bürger", 5.205, 5.625]]}, {"text": "Eure 35 Likes bringen 350 Euro!", "start": 12.482, "end": 15.914, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.086, 0.334], ["35", 0.345, 1.002], ["Likes", 1.153, 1.369], ["bringen", 1.369, 1.746], ["350 Euro", 1.864, 3.114]]}, {"text": "Die Mauer kostet 1500 Euro. Bleiben 430 Euro.", "start": 16.034, "end": 20.738, "spec": {"type": "money2"}, "afx": null, "words": [["Die", 0.086, 0.172], ["Mauer", 0.172, 0.496], ["kostet", 0.496, 0.873], ["1500 Euro", 0.873, 2.317], ["Bleiben", 2.672, 2.985], ["430 Euro", 2.996, 4.386]]}, {"text": "Also: Alle Mann an die Steine!", "start": 20.858, "end": 22.946, "spec": {"type": "build", "mood": "bright"}, "afx": null, "words": [["Also", 0.097, 0.453], ["Alle", 0.722, 0.905], ["Mann", 0.905, 1.153], ["an", 1.153, 1.239], ["die", 1.239, 1.336], ["Steine", 1.336, 1.767]]}, {"text": "Benluca passt auf, dass alles schön gerade wird.", "start": 23.066, "end": 26.09, "spec": {"type": "build2"}, "afx": null, "words": [["Benluca", 0.086, 0.474], ["passt", 0.474, 0.851], ["auf", 0.851, 1.121], ["dass", 1.412, 1.573], ["alles", 1.573, 1.832], ["schön", 1.832, 2.058], ["gerade", 2.058, 2.392], ["wird", 2.392, 2.683]]}, {"text": "Und fertig ist die große Mauer!", "start": 26.21, "end": 28.082, "spec": {"type": "done", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.172], ["fertig", 0.183, 0.593], ["ist", 0.603, 0.711], ["die", 0.722, 0.819], ["große", 0.819, 1.185], ["Mauer", 1.196, 1.541]]}, {"text": "In der Nacht kommen die Eckköpfe mit Fackeln.", "start": 28.202, "end": 30.482, "spec": {"type": "night", "mood": "calm"}, "afx": null, "words": [["In", 0.086, 0.14], ["der", 0.14, 0.237], ["Nacht", 0.248, 0.506], ["kommen", 0.517, 0.711], ["die", 0.711, 0.862], ["Eckköpfe", 0.862, 1.358], ["mit", 1.358, 1.509], ["Fackeln", 1.519, 1.95]]}, {"text": "Und krachen direkt gegen die Mauer!", "start": 30.602, "end": 32.498, "spec": {"type": "crash"}, "afx": null, "words": [["Und", 0.086, 0.194], ["krachen", 0.205, 0.56], ["direkt", 0.56, 0.927], ["gegen", 0.927, 1.142], ["die", 1.142, 1.218], ["Mauer", 1.218, 1.584]]}, {"text": "Wütend rudern sie zurück. Unsere Mauer hält!", "start": 32.618, "end": 35.834, "spec": {"type": "hold", "mood": "bright"}, "afx": null, "words": [["Wütend", 0.097, 0.485], ["rudern", 0.496, 0.905], ["sie", 0.916, 1.11], ["zurück", 1.11, 1.573], ["Unsere", 1.918, 2.198], ["Mauer", 2.198, 2.532], ["hält", 2.532, 2.909]]}, {"text": "Doch am Morgen schaut Sam durchs Fernglas.", "start": 35.954, "end": 38.21, "spec": {"type": "morning", "mood": "calm"}, "afx": null, "words": [["Doch", 0.086, 0.183], ["am", 0.183, 0.259], ["Morgen", 0.259, 0.539], ["schaut", 0.539, 0.83], ["Sam", 0.83, 1.088], ["durchs", 1.099, 1.272], ["Fernglas", 1.272, 1.94]]}, {"text": "Die Nachbarn bauen ein riesiges Katapult!", "start": 38.33, "end": 40.874, "spec": {"type": "catapult"}, "afx": null, "words": [["Die", 0.086, 0.151], ["Nachbarn", 0.162, 0.593], ["bauen", 0.603, 0.916], ["ein", 0.927, 1.088], ["riesiges", 1.099, 1.584], ["Katapult", 1.595, 2.22]]}, {"text": "Bauen wir eine eigene Kanone?", "start": 40.994, "end": 42.866, "spec": {"type": "cannon", "mood": "bright"}, "afx": null, "words": [["Bauen", 0.097, 0.291], ["wir", 0.291, 0.399], ["eine", 0.399, 0.614], ["eigene", 0.614, 0.927], ["Kanone", 0.938, 1.455]]}, {"text": "Oder schicken wir Benluca als Friedensboten mit einem Geschenk?", "start": 42.986, "end": 46.418, "spec": {"type": "peace"}, "afx": null, "words": [["Oder", 0.086, 0.248], ["schicken", 0.248, 0.55], ["wir", 0.55, 0.69], ["Benluca", 0.7, 1.412], ["als", 1.412, 1.595], ["Friedensboten", 1.595, 2.349], ["mit", 2.349, 2.468], ["einem", 2.468, 2.662], ["Geschenk", 2.662, 3.114]]}, {"text": "Der Top-Kommentar entscheidet.", "start": 46.538, "end": 48.41, "spec": {"type": "comment"}, "afx": null, "words": [["Der", 0.086, 0.183], ["Top-Kommentar", 0.183, 0.905], ["entscheidet", 0.905, 1.519]]}], "dur": 49.81}