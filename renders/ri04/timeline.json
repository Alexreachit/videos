{"lines": [{"text": "Tag vier auf Roundhead Island!", "start": 0.05, "end": 1.922, "spec": {"type": "day", "mood": "bright"}, "afx": null, "words": [["Tag", 0.086, 0.269], ["vier", 0.269, 0.517], ["auf", 0.517, 0.647], ["Roundhead", 0.647, 1.002], ["Island", 1.002, 1.325]]}, {"text": "Gestern hieß es: Mauer oder Frieden?", "start": 2.042, "end": 4.418, "spec": {"type": "recap", "mood": "calm"}, "afx": null, "words": [["Gestern", 0.086, 0.366], ["hieß", 0.377, 0.647], ["es", 0.647, 0.851], ["Mauer", 1.088, 1.412], ["oder", 1.412, 1.606], ["Frieden", 1.616, 2.058]]}, {"text": "Und die Mauer hat gewonnen!", "start": 4.538, "end": 6.41, "spec": {"type": "vote", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.205], ["die", 0.215, 0.323], ["Mauer", 0.323, 0.593], ["hat", 0.593, 0.754], ["gewonnen", 0.754, 1.164]]}, {"text": "Wir sind 128 Einwohner. Holt eure Freunde, jeder Follower ist ein neuer Bürger!", "start": 6.53, "end": 12.242, "spec": {"type": "crowd"}, "afx": null, "words": [["Wir", 0.075, 0.183], ["sind", 0.183, 0.366], ["128 Einwohner", 0.366, 2.058], ["Holt", 2.425, 2.619], ["eure", 2.619, 2.899], ["Freunde", 2.899, 3.351], ["jeder", 3.675, 3.89], ["Follower", 3.89, 4.321], ["ist", 4.321, 4.483], ["ein", 4.494, 4.677], ["neuer", 4.677, 4.946], ["Bürger", 4.946, 5.377]]}, {"text": "Eure 35 Likes bringen 350 Euro!", "start": 12.362, "end": 15.65, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.086, 0.302], ["35", 0.312, 0.916], ["Likes", 0.916, 1.099], ["bringen", 1.099, 1.466], ["350 Euro", 1.659, 2.974]]}, {"text": "Die Mauer kostet 1500 Euro. Bleiben 430 Euro.", "start": 15.77, "end": 20.546, "spec": {"type": "money2"}, "afx": null, "words": [["Die", 0.086, 0.162], ["Mauer", 0.162, 0.496], ["kostet", 0.496, 0.862], ["1500 Euro", 0.873, 2.371], ["Bleiben", 2.737, 3.039], ["430 Euro", 3.039, 4.45]]}, {"text": "Also: Alle Mann an die Steine!", "start": 20.666, "end": 22.73, "spec": {"type": "build", "mood": "bright"}, "afx": null, "words": [["Also", 0.097, 0.453], ["Alle", 0.733, 0.905], ["Mann", 0.905, 1.131], ["an", 1.142, 1.207], ["die", 1.218, 1.304], ["Steine", 1.315, 1.746]]}, {"text": "Benluca passt auf, dass alles schön gerade wird.", "start": 22.85, "end": 25.97, "spec": {"type": "build2"}, "afx": null, "words": [["Benluca", 0.097, 0.496], ["passt", 0.496, 0.873], ["auf", 0.873, 1.153], ["dass", 1.444, 1.627], ["alles", 1.627, 1.886], ["schön", 1.897, 2.134], ["gerade", 2.134, 2.478], ["wird", 2.489, 2.78]]}, {"text": "Und fertig ist die große Mauer!", "start": 26.09, "end": 27.962, "spec": {"type": "done", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.183], ["fertig", 0.183, 0.582], ["ist", 0.582, 0.69], ["die", 0.69, 0.776], ["große", 0.776, 1.131], ["Mauer", 1.131, 1.498]]}, {"text": "In der Nacht kommen die Eckköpfe mit Fackeln.", "start": 28.082, "end": 30.338, "spec": {"type": "night", "mood": "calm"}, "afx": null, "words": [["In", 0.086, 0.14], ["der", 0.151, 0.226], ["Nacht", 0.226, 0.474], ["kommen", 0.474, 0.668], ["die", 0.668, 0.797], ["Eckköpfe", 0.808, 1.315], ["mit", 1.315, 1.465], ["Fackeln", 1.466, 1.918]]}, {"text": "Und krachen direkt gegen die Mauer!", "start": 30.458, "end": 32.354, "spec": {"type": "crash"}, "afx": null, "words": [["Und", 0.075, 0.162], ["krachen", 0.162, 0.485], ["direkt", 0.485, 0.894], ["gegen", 0.894, 1.11], ["die", 1.121, 1.207], ["Mauer", 1.207, 1.562]]}, {"text": "Wütend rudern sie zurück. Unsere Mauer hält!", "start": 32.474, "end": 35.498, "spec": {"type": "hold", "mood": "bright"}, "afx": null, "words": [["Wütend", 0.086, 0.442], ["rudern", 0.453, 0.84], ["sie", 0.851, 1.013], ["zurück", 1.013, 1.455], ["Unsere", 1.8, 2.069], ["Mauer", 2.08, 2.36], ["hält", 2.36, 2.715]]}, {"text": "Doch am Morgen schaut Sam durchs Fernglas.", "start": 35.618, "end": 37.97, "spec": {"type": "morning", "mood": "calm"}, "afx": null, "words": [["Doch", 0.086, 0.215], ["am", 0.215, 0.312], ["Morgen", 0.312, 0.593], ["schaut", 0.603, 0.905], ["Sam", 0.916, 1.153], ["durchs", 1.153, 1.325], ["Fernglas", 1.336, 2.026]]}, {"text": "Die Nachbarn bauen ein riesiges Katapult!", "start": 38.09, "end": 40.61, "spec": {"type": "catapult"}, "afx": null, "words": [["Die", 0.086, 0.151], ["Nachbarn", 0.162, 0.56], ["bauen", 0.56, 0.873], ["ein", 0.884, 1.056], ["riesiges", 1.067, 1.552], ["Katapult", 1.562, 2.198]]}, {"text": "Bauen wir eine eigene Kanone?", "start": 40.73, "end": 42.602, "spec": {"type": "cannon", "mood": "bright"}, "afx": null, "words": [["Bauen", 0.097, 0.302], ["wir", 0.302, 0.42], ["eine", 0.42, 0.657], ["eigene", 0.657, 0.991], ["Kanone", 0.991, 1.541]]}, {"text": "Oder schicken wir Benluca als Friedensboten mit einem Geschenk?", "start": 42.722, "end": 46.082, "spec": {"type": "peace"}, "afx": null, "words": [["Oder", 0.086, 0.248], ["schicken", 0.248, 0.539], ["wir", 0.539, 0.679], ["Benluca", 0.69, 1.293], ["als", 1.293, 1.498], ["Friedensboten", 1.509, 2.274], ["mit", 2.274, 2.392], ["einem", 2.392, 2.575], ["Geschenk", 2.575, 3.039]]}, {"text": "Der Top-Kommentar entscheidet.", "start": 46.202, "end": 48.074, "spec": {"type": "comment"}, "afx": null, "words": [["Der", 0.086, 0.183], ["Top-Kommentar", 0.183, 0.894], ["entscheidet", 0.894, 1.498]]}], "dur": 49.47}