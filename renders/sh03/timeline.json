{"lines": [{"text": "Tag 3 auf Squarehead Island!", "start": 0.05, "end": 1.994, "spec": {"type": "map", "mood": "bright"}, "afx": null, "words": [["Tag", 0.049, 0.328], ["drei", 0.328, 0.662], ["auf", 0.662, 0.819], ["Squarehead", 0.819, 1.232], ["Island", 1.232, 1.622]]}, {"text": "Ihr habt entschieden: Wir pflanzen ein Melonenfeld!", "start": 2.114, "end": 5.21, "spec": {"type": "feld", "mood": "bright"}, "afx": null, "words": [["Ihr", 0.089, 0.223], ["habt", 0.223, 0.435], ["entschieden", 0.435, 0.926], ["Wir", 1.272, 1.406], ["pflanzen", 1.406, 1.875], ["ein", 1.875, 1.987], ["Melonenfeld", 1.987, 2.768]]}, {"text": "Wir sind jetzt 22 Einwohner!", "start": 5.33, "end": 7.754, "spec": {"type": "crowd", "mood": "bright"}, "afx": null, "words": [["Wir", 0.049, 0.294], ["sind", 0.294, 0.473], ["jetzt", 0.473, 0.774], ["zweiundzwanzig", 0.774, 1.544], ["Einwohner", 1.544, 2.113]]}, {"text": "Eure Likes bringen 140 Euro. Macht 310 Euro in der Kasse!", "start": 7.874, "end": 12.626, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.056, 0.324], ["Likes", 0.324, 0.636], ["bringen", 0.636, 0.937], ["hundertvierzig", 0.938, 1.641], ["Euro", 1.641, 2.042], ["Macht", 2.388, 2.712], ["dreihundertzehn", 2.712, 3.46], ["Euro", 3.46, 3.828], ["in", 3.828, 3.895], ["der", 3.895, 3.984], ["Kasse", 3.984, 4.431]]}, {"text": "Tamino will Dönermann werden: Hier ist deine Dönerbude!", "start": 12.746, "end": 16.154, "spec": {"type": "doener"}, "afx": null, "words": [["Tamino", 0.05, 0.53], ["will", 0.53, 0.686], ["Dönermann", 0.686, 1.099], ["werden", 1.099, 1.412], ["Hier", 1.847, 2.081], ["ist", 2.081, 2.226], ["deine", 2.226, 2.427], ["Dönerbude", 2.427, 3.086]]}, {"text": "Henry bekommt seinen Gurkenladen, direkt daneben!", "start": 16.274, "end": 19.394, "spec": {"type": "gurken"}, "afx": null, "words": [["Henry", 0.05, 0.452], ["bekommt", 0.452, 0.787], ["seinen", 0.787, 1.01], ["Gurkenladen", 1.01, 1.691], ["direkt", 1.903, 2.249], ["daneben", 2.249, 2.807]]}, {"text": "Elias kriegt Goldkette, Cappy und einen blauen Pulli!", "start": 19.514, "end": 22.85, "spec": {"type": "elias", "mood": "bright"}, "afx": null, "words": [["Elias", 0.049, 0.506], ["kriegt", 0.506, 0.774], ["Goldkette", 0.774, 1.354], ["Cappy", 1.578, 1.991], ["und", 1.991, 2.147], ["einen", 2.147, 2.337], ["blauen", 2.337, 2.616], ["Pulli", 2.616, 3.017]]}, {"text": "Kristian bekommt seine Uschanka. Auf der Insel ist es zwar warm, aber egal!", "start": 22.97, "end": 27.818, "spec": {"type": "uschanka"}, "afx": null, "words": [["Kristian", 0.05, 0.642], ["bekommt", 0.641, 0.987], ["seine", 0.988, 1.244], ["Uschanka", 1.244, 1.847], ["Auf", 2.148, 2.36], ["der", 2.36, 2.494], ["Insel", 2.494, 2.807], ["ist", 2.807, 2.952], ["es", 2.952, 3.041], ["zwar", 3.041, 3.253], ["warm", 3.253, 3.554], ["aber", 3.856, 4.068], ["egal", 4.068, 4.548]]}, {"text": "Und Jk777 ist ab heute Bodyguard vom Vize-Bürgermeister!", "start": 27.938, "end": 32.186, "spec": {"type": "bodyguard"}, "afx": null, "words": [["Und", 0.049, 0.316], ["Jott", 0.317, 0.562], ["Ka", 0.562, 0.875], ["sieben", 0.875, 1.165], ["sieben", 1.165, 1.388], ["sieben", 1.388, 1.745], ["ist", 1.745, 1.912], ["ab", 1.913, 2.013], ["heute", 2.013, 2.281], ["Bodyguard", 2.281, 2.75], ["vom", 2.75, 2.906], ["Vize-Bürgermeister", 2.906, 3.933]]}, {"text": "Die erste Melone ist reif. Aber wohin mit der ganzen Ernte?", "start": 32.306, "end": 36.29, "spec": {"type": "reif", "mood": "calm"}, "afx": null, "words": [["Die", 0.089, 0.246], ["erste", 0.246, 0.547], ["Melone", 0.547, 1.016], ["ist", 1.016, 1.205], ["reif", 1.205, 1.652], ["Aber", 1.958, 2.293], ["wohin", 2.293, 2.65], ["mit", 2.65, 2.773], ["der", 2.773, 2.874], ["ganzen", 2.874, 3.231], ["Ernte", 3.231, 3.677]]}, {"text": "Bauen wir einen Markt für Melonen, Döner und Gurken?", "start": 36.41, "end": 39.482, "spec": {"type": "markt", "mood": "bright"}, "afx": null, "words": [["Bauen", 0.05, 0.329], ["wir", 0.329, 0.452], ["einen", 0.452, 0.641], ["Markt", 0.641, 0.92], ["für", 0.921, 1.043], ["Melonen", 1.043, 1.59], ["Döner", 1.746, 2.137], ["und", 2.137, 2.293], ["Gurken", 2.293, 2.751]]}, {"text": "Oder einen Brunnen, damit das Feld nie austrocknet?", "start": 39.602, "end": 42.65, "spec": {"type": "brunnen"}, "afx": null, "words": [["Oder", 0.049, 0.361], ["einen", 0.361, 0.596], ["Brunnen", 0.596, 1.008], ["damit", 1.198, 1.421], ["das", 1.421, 1.566], ["Feld", 1.567, 1.845], ["nie", 1.846, 2.058], ["austrocknet", 2.058, 2.738]]}, {"text": "Der Top-Kommentar entscheidet.", "start": 42.77, "end": 44.882, "spec": {"type": "comment"}, "afx": null, "words": [["Der", 0.049, 0.316], ["Top-Kommentar", 0.317, 1.12], ["entscheidet", 1.165, 1.79]]}], "dur": 46.28}