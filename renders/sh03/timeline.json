{"lines": [{"text": "Tag 3 auf Squarehead Island!", "start": 0.05, "end": 1.994, "spec": {"type": "map", "mood": "bright"}, "afx": null, "words": [["Tag", 0.049, 0.328], ["drei", 0.328, 0.662], ["auf", 0.662, 0.819], ["Squarehead", 0.819, 1.232], ["Island", 1.232, 1.622]]}, {"text": "Die Regeln: Folgen macht dich zum Bürger, jedes Like bringt 10 Euro, und im Kommentar darfst du dir was wünschen!", "start": 2.114, "end": 7.97, "spec": {"type": "regeln"}, "afx": null, "words": [["Die", 0.05, 0.229], ["Regeln", 0.229, 0.642], ["Folgen", 0.898, 1.222], ["macht", 1.222, 1.378], ["dich", 1.378, 1.49], ["zum", 1.49, 1.635], ["Bürger", 1.635, 1.981], ["jedes", 2.249, 2.505], ["Like", 2.505, 2.773], ["bringt", 2.773, 2.996], ["zehn", 2.996, 3.253], ["Euro", 3.253, 3.61], ["und", 3.867, 4.001], ["im", 4.001, 4.079], ["Kommentar", 4.079, 4.548], ["darfst", 4.548, 4.771], ["du", 4.771, 4.827], ["dir", 4.827, 4.95], ["was", 4.95, 5.095], ["wünschen", 5.095, 5.541]]}, {"text": "Ihr habt entschieden: Wir pflanzen ein Melonenfeld!", "start": 8.09, "end": 11.186, "spec": {"type": "feld", "mood": "bright"}, "afx": null, "words": [["Ihr", 0.089, 0.223], ["habt", 0.223, 0.435], ["entschieden", 0.435, 0.926], ["Wir", 1.272, 1.406], ["pflanzen", 1.406, 1.875], ["ein", 1.875, 1.987], ["Melonenfeld", 1.987, 2.768]]}, {"text": "Wir sind jetzt 22 Einwohner!", "start": 11.306, "end": 13.73, "spec": {"type": "crowd", "mood": "bright"}, "afx": null, "words": [["Wir", 0.049, 0.294], ["sind", 0.294, 0.473], ["jetzt", 0.473, 0.774], ["zweiundzwanzig", 0.774, 1.544], ["Einwohner", 1.544, 2.113]]}, {"text": "Eure Likes bringen 150 Euro. Macht 320 Euro in der Kasse!", "start": 13.85, "end": 18.842, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.049, 0.361], ["Likes", 0.361, 0.674], ["bringen", 0.674, 0.975], ["hundertfünfzig", 0.975, 1.712], ["Euro", 1.712, 2.113], ["Macht", 2.455, 2.779], ["dreihundertzwanzig", 2.779, 3.728], ["Euro", 3.728, 4.085], ["in", 4.085, 4.152], ["der", 4.152, 4.241], ["Kasse", 4.241, 4.687]]}, {"text": "Tamino will Dönermann werden: Hier ist deine Dönerbude!", "start": 18.962, "end": 22.37, "spec": {"type": "doener"}, "afx": null, "words": [["Tamino", 0.05, 0.53], ["will", 0.53, 0.686], ["Dönermann", 0.686, 1.099], ["werden", 1.099, 1.412], ["Hier", 1.847, 2.081], ["ist", 2.081, 2.226], ["deine", 2.226, 2.427], ["Dönerbude", 2.427, 3.086]]}, {"text": "Henry bekommt seinen Gurkenladen, direkt daneben!", "start": 22.49, "end": 25.61, "spec": {"type": "gurken"}, "afx": null, "words": [["Henry", 0.05, 0.452], ["bekommt", 0.452, 0.787], ["seinen", 0.787, 1.01], ["Gurkenladen", 1.01, 1.691], ["direkt", 1.903, 2.249], ["daneben", 2.249, 2.807]]}, {"text": "Elias kriegt Goldkette, Cappy und einen blauen Pulli!", "start": 25.73, "end": 29.066, "spec": {"type": "elias", "mood": "bright"}, "afx": null, "words": [["Elias", 0.049, 0.506], ["kriegt", 0.506, 0.774], ["Goldkette", 0.774, 1.354], ["Cappy", 1.578, 1.991], ["und", 1.991, 2.147], ["einen", 2.147, 2.337], ["blauen", 2.337, 2.616], ["Pulli", 2.616, 3.017]]}, {"text": "Kristian bekommt seine Uschanka. Auf der Insel ist es zwar warm, aber egal!", "start": 29.186, "end": 34.034, "spec": {"type": "uschanka"}, "afx": null, "words": [["Kristian", 0.05, 0.642], ["bekommt", 0.641, 0.987], ["seine", 0.988, 1.244], ["Uschanka", 1.244, 1.847], ["Auf", 2.148, 2.36], ["der", 2.36, 2.494], ["Insel", 2.494, 2.807], ["ist", 2.807, 2.952], ["es", 2.952, 3.041], ["zwar", 3.041, 3.253], ["warm", 3.253, 3.554], ["aber", 3.856, 4.068], ["egal", 4.068, 4.548]]}, {"text": "Und Jk777 ist ab heute Bodyguard vom Vize-Bürgermeister!", "start": 34.154, "end": 38.402, "spec": {"type": "bodyguard"}, "afx": null, "words": [["Und", 0.049, 0.316], ["Jott", 0.317, 0.562], ["Ka", 0.562, 0.875], ["sieben", 0.875, 1.165], ["sieben", 1.165, 1.388], ["sieben", 1.388, 1.745], ["ist", 1.745, 1.912], ["ab", 1.913, 2.013], ["heute", 2.013, 2.281], ["Bodyguard", 2.281, 2.75], ["vom", 2.75, 2.906], ["Vize-Bürgermeister", 2.906, 3.933]]}, {"text": "Die erste Melone ist reif. Aber wohin mit der ganzen Ernte?", "start": 38.522, "end": 42.506, "spec": {"type": "reif", "mood": "calm"}, "afx": null, "words": [["Die", 0.089, 0.246], ["erste", 0.246, 0.547], ["Melone", 0.547, 1.016], ["ist", 1.016, 1.205], ["reif", 1.205, 1.652], ["Aber", 1.958, 2.293], ["wohin", 2.293, 2.65], ["mit", 2.65, 2.773], ["der", 2.773, 2.874], ["ganzen", 2.874, 3.231], ["Ernte", 3.231, 3.677]]}, {"text": "Bauen wir einen Markt für Melonen, Döner und Gurken?", "start": 42.626, "end": 45.698, "spec": {"type": "markt", "mood": "bright"}, "afx": null, "words": [["Bauen", 0.05, 0.329], ["wir", 0.329, 0.452], ["einen", 0.452, 0.641], ["Markt", 0.641, 0.92], ["für", 0.921, 1.043], ["Melonen", 1.043, 1.59], ["Döner", 1.746, 2.137], ["und", 2.137, 2.293], ["Gurken", 2.293, 2.751]]}, {"text": "Oder einen Brunnen, damit das Feld nie austrocknet?", "start": 45.818, "end": 48.866, "spec": {"type": "brunnen"}, "afx": null, "words": [["Oder", 0.049, 0.361], ["einen", 0.361, 0.596], ["Brunnen", 0.596, 1.008], ["damit", 1.198, 1.421], ["das", 1.421, 1.566], ["Feld", 1.567, 1.845], ["nie", 1.846, 2.058], ["austrocknet", 2.058, 2.738]]}, {"text": "Der Top-Kommentar entscheidet.", "start": 48.986, "end": 51.098, "spec": {"type": "comment"}, "afx": null, "words": [["Der", 0.049, 0.316], ["Top-Kommentar", 0.317, 1.12], ["entscheidet", 1.165, 1.79]]}], "dur": 52.5}