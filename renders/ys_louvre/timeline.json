{"lines": [{"text": "Seven minutes. That's all it took to rob the Louvre.", "start": 0.05, "end": 2.882, "spec": {"type": "hero"}, "afx": null, "words": [["Seven", 0.086, 0.312], ["minutes", 0.312, 0.776], ["That's", 1.121, 1.25], ["all", 1.261, 1.412], ["it", 1.412, 1.476], ["took", 1.476, 1.659], ["to", 1.659, 1.735], ["rob", 1.735, 2.015], ["the", 2.026, 2.091], ["Louvre", 2.101, 2.532]]}, {"text": "In October twenty twenty-five, a truck with a ladder lift parked right below a window.", "start": 2.962, "end": 7.474, "spec": {"type": "climb"}, "afx": null, "words": [["In", 0.075, 0.129], ["October", 0.129, 0.517], ["twenty", 0.517, 0.711], ["twenty-five", 0.711, 1.315], ["a", 1.562, 1.606], ["truck", 1.606, 1.864], ["with", 1.875, 1.972], ["a", 1.972, 2.004], ["ladder", 2.004, 2.381], ["lift", 2.381, 2.565], ["parked", 2.565, 2.899], ["right", 3.103, 3.308], ["below", 3.308, 3.61], ["a", 3.621, 3.685], ["window", 3.696, 4.192]]}, {"text": "Two men in work vests rode it up and cut through the glass.", "start": 7.554, "end": 10.746, "spec": {"type": "climb"}, "afx": null, "words": [["Two", 0.086, 0.205], ["men", 0.205, 0.366], ["in", 0.366, 0.453], ["work", 0.453, 0.679], ["vests", 0.679, 1.067], ["rode", 1.078, 1.282], ["it", 1.282, 1.336], ["up", 1.336, 1.519], ["and", 1.843, 1.929], ["cut", 1.94, 2.134], ["through", 2.144, 2.274], ["the", 2.274, 2.328], ["glass", 2.328, 2.856]]}, {"text": "Inside, they grabbed eight pieces of the French crown jewels.", "start": 10.826, "end": 14.258, "spec": {"type": "grab"}, "afx": null, "words": [["Inside", 0.086, 0.56], ["they", 0.765, 0.862], ["grabbed", 0.862, 1.185], ["eight", 1.336, 1.509], ["pieces", 1.519, 1.929], ["of", 1.94, 1.983], ["the", 1.983, 2.037], ["French", 2.037, 2.338], ["crown", 2.338, 2.651], ["jewels", 2.662, 3.125]]}, {"text": "Worth about one hundred million dollars.", "start": 14.338, "end": 16.378, "spec": {"type": "value", "cut": true}, "afx": null, "words": [["Worth", 0.086, 0.205], ["about", 0.205,