{"lines": [{"text": "Why you should never hire your brother-in-law for a heist.", "start": 0.05, "end": 2.738, "spec": {"shot": "hero"}, "afx": null, "words": [["Why", 0.086, 0.194], ["you", 0.194, 0.28], ["should", 0.28, 0.453], ["never", 0.463, 0.754], ["hire", 0.765, 1.067], ["your", 1.067, 1.153], ["brother-in-law", 1.164, 1.681], ["for", 1.692, 1.853], ["a", 1.864, 1.886], ["heist", 1.897, 2.371]]}, {"text": "In 1983, six robbers raided a warehouse at Heathrow Airport.", "start": 2.838, "end": 7.11, "spec": {"shot": "airport"}, "afx": null, "words": [["In 1983", 0.086, 1.078], ["six", 1.444, 1.659], ["robbers", 1.659, 1.961], ["raided", 1.961, 2.187], ["a", 2.198, 2.274], ["warehouse", 2.284, 2.953], ["at", 3.103, 3.211], ["Heathrow", 3.211, 3.567], ["Airport", 3.567, 3.955]]}, {"text": "An inside guard had copied the key for them.", "start": 7.21, "end": 9.442, "spec": {"shot": "key"}, "afx": null, "words": [["An", 0.075, 0.14], ["inside", 0.151, 0.582], ["guard", 0.582, 0.819], ["had", 0.819, 0.959], ["copied", 0.959, 1.304], ["the", 1.304, 1.347], ["key", 1.358, 1.606], ["for", 1.606, 1.735], ["them", 1.735, 1.907]]}, {"text": "They poured petrol on the staff and demanded the vault codes.", "start": 9.542, "end": 12.758, "spec": {"shot": "petrol"}, "afx": null, "words": [["They", 0.086, 0.162], ["poured", 0.172, 0.388], ["petrol", 0.399, 0.7], ["on", 0.7, 0.765], ["the", 0.765, 0.819], ["staff", 0.819, 1.282], ["and", 1.595, 1.67], ["demanded", 1.67, 2.112], ["the", 2.112, 2.166], ["vault", 2.166, 2.425], ["codes", 2.435, 2.909]]}, {"text": "They came for cash, but found three tonnes of gold. Twenty-six million pounds!", "start": 12.858, "end": 17.682, "spec": {"shot": "gold", "cut": true}, "afx": null, "words": [["They", 0.097, 0.172], ["came", 0.172, 0.366], ["for", 0.377, 0.485], ["cash", 0.485, 0.937], ["but", 1.013, 1.131], ["found", 1.131, 1.422], ["three", 1.422, 1.853], ["tonnes", 1.864, 2.155], ["of", 2.166, 2.241], ["gold", 2.241, 2.575], ["Twenty-six", 2.931, 3.491], ["million", 3.578, 3.922], ["pounds", 3.922, 4.504]]}, {"text": "Police soon suspected the guard. He named his brother-in-law.", "start": 17.782, "end": 21.262, "spec": {"shot": "police"}, "afx": null, "words": [["Police", 0.086, 0.399], ["soon", 0.409, 0.819], ["suspected", 0.948, 1.412], ["the", 1.422, 1.465], ["guard", 1.466, 1.778], ["He", 2.134, 2.177], ["named", 2.177, 2.371], ["his", 2.381, 2.468], ["brother-in-law", 2.478, 3.157]]}, {"text": "Two got twenty-five years. Most of the gold was never found.", "start": 21.362, "end": 24.698, "spec": {"shot": "prison"}, "afx": null, "words": [["Two", 0.086, 0.183], ["got", 0.183, 0.323], ["twenty-five", 0.323, 0.797], ["years", 0.797, 1.272], ["Most", 1.627, 1.8], ["of", 1.8, 1.853], ["the", 1.853, 1.907], ["gold", 1.907, 2.177], ["was", 2.177, 2.295], ["never", 2.295, 2.586], ["found", 2.586, 2.996]]}, {"text": "Some say if you bought gold jewelry in Britain after 1983, you may be wearing it.", "start": 24.798, "end": 29.55, "spec": {"shot": "jewel"}, "afx": null, "words": [["Some", 0.086, 0.237], ["say", 0.237, 0.42], ["if", 0.42, 0.496], ["you", 0.496, 0.571], ["bought", 0.582, 0.873], ["gold", 0.884, 1.153], ["jewelry", 1.153, 1.562], ["in", 1.573, 1.638], ["Britain", 1.638, 1.972], ["after 1983", 2.069, 3.136], ["you", 3.513, 3.599], ["may", 3.599, 3.718], ["be", 3.718, 3.836], ["wearing", 3.836, 4.256], ["it", 4.256, 4.429]]}, {"text": "Would you still wear it?", "start": 29.65, "end": 31.522, "spec": {"shot": "end", "choice": true}, "afx": null, "words": [["Would", 0.086, 0.172], ["you", 0.172, 0.237], ["still", 0.237, 0.485], ["wear", 0.485, 0.636], ["it", 0.636, 0.754]]}], "dur": 31.92}