{"lines": [{"text": "Tag eins: Ich habe gerade mein eigenes Land gegründet.", "start": 0.05, "end": 3.314, "spec": {"type": "fly", "mood": "calm"}, "afx": null, "words": [["Tag", 0.086, 0.323], ["eins", 0.323, 0.657], ["Ich", 0.991, 1.056], ["habe", 1.056, 1.228], ["gerade", 1.228, 1.562], ["mein", 1.573, 1.81], ["eigenes", 1.81, 2.155], ["Land", 2.166, 2.403], ["gegründet", 2.403, 2.953]]}, {"text": "Willkommen auf Roundhead Island!", "start": 3.434, "end": 5.306, "spec": {"type": "sign"}, "afx": null, "words": [["Willkommen", 0.097, 0.571], ["auf", 0.571, 0.733], ["Roundhead", 0.733, 1.121], ["Island", 1.131, 1.476]]}, {"text": "Einwohner: genau einer. Ich.", "start": 5.426, "end": 7.826, "spec": {"type": "pop"}, "afx": null, "words": [["Einwohner", 0.086, 0.55], ["genau", 0.776, 1.078], ["einer", 1.078, 1.465], ["Ich", 1.821, 2.069]]}, {"text": "Aber jeder neue Follower wird ein Bürger.", "start": 7.946, "end": 10.418, "spec": {"type": "follow"}, "afx": null, "words": [["Aber", 0.086, 0.269], ["jeder", 0.28, 0.55], ["neue", 0.55, 0.819], ["Follower", 0.83, 1.347], ["wird", 1.358, 1.541], ["ein", 1.552, 1.724], ["Bürger", 1.724, 2.155]]}, {"text": "Unser Ziel: das reichste Land der Welt.", "start": 10.538, "end": 13.13, "spec": {"type": "goal", "mood": "bright"}, "afx": null, "words": [["Unser", 0.097, 0.345], ["Ziel", 0.345, 0.765], ["das", 1.088, 1.228], ["reichste", 1.228, 1.606], ["Land", 1.616, 1.832], ["der", 1.843, 1.94], ["Welt", 1.94, 2.274]]}, {"text": "Aber schau dich um. Keine Häuser, keine Bank, nicht mal eine Straße.", "start": 13.25, "end": 17.666, "spec": {"type": "empty", "mood": "calm"}, "afx": null, "words": [["Aber", 0.097, 0.248], ["schau", 0.248, 0.485], ["dich", 0.485, 0.722], ["um", 0.722, 0.905], ["Keine", 1.25, 1.466], ["Häuser", 1.476, 1.918], ["keine", 2.198, 2.468], ["Bank", 2.468, 2.78], ["nicht", 3.125, 3.287], ["mal", 3.287, 3.427], ["eine Straße", 3.438, 4.084]]}, {"text": "Folg jetzt, und du bekommst Reisepass Nummer eins.", "start": 17.786, "end": 21.146, "spec": {"type": "passport"}, "afx": null, "words": [["Folg", 0.119, 0.377], ["jetzt", 0.377, 0.722], ["und", 1.056, 1.142], ["du", 1.153, 1.228], ["bekommst", 1.228, 1.627], ["Reisepass", 1.638, 2.263], ["Nummer", 2.274, 2.554], ["eins", 2.565, 3.028]]}, {"text": "Unsere Staatskasse: zwanzig Euro... und eine Kokosnuss.", "start": 21.266, "end": 25.13, "spec": {"type": "treasury"}, "afx": null, "words": [["Unsere", 0.086, 0.302], ["Staatskasse", 0.302, 0.916], ["zwanzig", 1.239, 1.681], ["Euro", 1.681, 2.047], ["und", 2.446, 2.554], ["eine", 2.554, 2.737], ["Kokosnuss", 2.737, 3.534]]}, {"text": "Und für jeden Like kommen zehn Euro in die Kasse!", "start": 25.25, "end": 27.986, "spec": {"type": "likes"}, "afx": null, "words": [["Und", 0.086, 0.183], ["für", 0.183, 0.312], ["jeden", 0.323, 0.593], ["Like", 0.593, 0.733], ["kommen", 0.744, 1.002], ["zehn", 1.013, 1.325], ["Euro", 1.325, 1.767], ["in", 1.767, 1.864], ["die", 1.875, 1.961], ["Kasse", 1.972, 2.414]]}, {"text": "Also, was bauen wir zuerst? Einen Hafen oder eine Bank?", "start": 28.106, "end": 31.946, "spec": {"type": "choice"}, "afx": null, "words": [["Also", 0.097, 0.442], ["was", 0.776, 0.894], ["bauen", 0.894, 1.131], ["wir", 1.142, 1.25], ["zuerst", 1.25, 1.8], ["Einen", 2.155, 2.317], ["Hafen", 2.317, 2.802], ["oder", 2.812, 2.996], ["eine", 2.996, 3.168], ["Bank", 3.168, 3.513]]}, {"text": "Der Top-Kommentar entscheidet.", "start": 32.066, "end": 33.938, "spec": {"type": "comment"}, "afx": null, "words": [["Der", 0.086, 0.183], ["Top-Kommentar", 0.183, 0.894], ["entscheidet", 0.894, 1.519]]}], "dur": 35.34}