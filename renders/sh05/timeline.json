{"lines": [{"text": "Tag 5 auf Squarehead Island!", "start": 0.05, "end": 2.195, "spec": {"type": "map", "mood": "bright"}, "afx": null, "words": [["Tag", 0.0, 0.282], ["5", 0.306, 0.526], ["auf", 0.545, 0.827], ["Squarehead", 0.851, 1.571], ["Island!", 1.634, 2.104]]}, {"text": "Die Regeln: Folgen macht dich zum Bürger, jedes Like bringt 10 Euro, und im Kommentar darfst du dir was wünschen!", "start": 2.315, "end": 9.341, "spec": {"type": "regeln"}, "afx": null, "words": [["Die", 0.0, 0.225], ["Regeln:", 0.244, 0.619], ["Folgen", 0.651, 1.345], ["macht", 1.405, 1.73], ["dich", 1.758, 2.033], ["zum", 2.057, 2.281], ["Bürger,", 2.301, 2.675], ["jedes", 2.708, 3.032], ["Like", 3.06, 3.335], ["bringt", 3.359, 3.733], ["10", 3.766, 3.941], ["Euro,", 3.956, 4.23], ["und", 4.254, 4.479], ["im", 4.499, 4.827], ["Kommentar", 4.855, 5.379], ["darfst", 5.425, 5.799], ["du", 5.832, 6.007], ["dir", 6.022, 6.247], ["was", 6.266, 6.491], ["wünschen!", 6.51, 6.985]]}, {"text": "Ihr habt entschieden: Wir bauen die Praxis!", "start": 9.461, "end": 12.44, "spec": {"type": "vote", "mood": "bright"}, "afx": null, "words": [["Ihr", 0.0, 0.234], ["habt", 0.254, 0.54], ["entschieden:", 0.565, 1.591], ["Wir", 1.681, 1.915], ["bauen", 1.935, 2.273], ["die", 2.302, 2.536], ["Praxis!", 2.556, 2.946]]}, {"text": "8 neue Bürger! Wir sind jetzt 41.", "start": 12.56, "end": 15.94, "spec": {"type": "crowd", "mood": "bright"}, "afx": null, "words": [["8", 0.0, 0.262], ["neue", 0.285, 0.698], ["Bürger!", 0.733, 1.669], ["Wir", 1.751, 2.088], ["sind", 2.117, 2.53], ["jetzt", 2.565, 3.053], ["41.", 3.095, 3.358]]}, {"text": "Eure 20 Likes bringen 200 Euro. Macht 480 Euro in der Kasse!", "start": 16.06, "end": 20.794, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.0, 0.346], ["20", 0.376, 0.597], ["Likes", 0.616, 1.025], ["bringen", 1.061, 1.596], ["200", 1.643, 1.926], ["Euro.", 1.95, 2.297], ["Macht", 2.327, 2.999], ["480", 3.057, 3.34], ["Euro", 3.365, 3.711], ["in", 3.741, 3.962], ["der", 3.981, 4.264], ["Kasse!", 4.289, 4.698]]}, {"text": "Hier ist die Praxis! Sie kostet 400 Euro, bleiben 80 in der Kasse.", "start": 20.914, "end": 24.978, "spec": {"type": "build"}, "afx": null, "words": [["Hier", 0.0, 0.292], ["ist", 0.317, 0.556], ["die", 0.576, 0.815], ["Praxis!", 0.836, 1.234], ["Sie", 1.268, 1.507], ["kostet", 1.528, 1.925], ["400", 1.96, 2.199], ["Euro,", 2.22, 2.511], ["bleiben", 2.537, 2.987], ["80", 3.027, 3.212], ["in", 3.228, 3.414], ["der", 3.43, 3.669], ["Kasse.", 3.69, 4.034]]}, {"text": "Gaming+Motor eröffnet seine Pizzeria: Pizza Riha!", "start": 25.098, "end": 29.069, "spec": {"type": "pizza", "mood": "bright"}, "afx": null, "words": [["Gaming+Motor", 0.0, 0.843], ["eröffnet", 0.916, 1.557], ["seine", 1.613, 2.051], ["Pizzeria:", 2.089, 3.011], ["Pizza", 3.091, 3.529], ["Riha!", 3.567, 3.938]]}, {"text": "Elias wird Partner in Lucas' Burgerbude, und die Bude wird größer!", "start": 29.189, "end": 33.002, "spec": {"type": "burger"}, "afx": null, "words": [["Elias", 0.0, 0.328], ["wird", 0.357, 0.634], ["Partner", 0.658, 1.087], ["in", 1.125, 1.301], ["Lucas'", 1.317, 1.645], ["Burgerbude,", 1.673, 2.254], ["und", 2.304, 2.531], ["die", 2.551, 2.778], ["Bude", 2.798, 3.076], ["wird", 3.1, 3.377], ["größer!", 3.402, 3.78]]}, {"text": "Und Louie wird unser König!", "start": 33.122, "end": 35.144, "spec": {"type": "king", "mood": "bright"}, "afx": null, "words": [["Und", 0.0, 0.284], ["Louie", 0.308, 0.718], ["wird", 0.754, 1.101], ["unser", 1.131, 1.541], ["König!", 1.577, 1.986]]}, {"text": "Der Flugplatz war knapp dran: nur 45 Prozent!", "start": 35.264, "end": 38.614, "spec": {"type": "knapp", "mood": "calm"}, "afx": null, "words": [["Der", 0.0, 0.273], ["Flugplatz", 0.297, 0.934], ["war", 0.989, 1.262], ["knapp", 1.286, 1.85], ["dran:", 1.9, 2.233], ["nur", 2.262, 2.535], ["45", 2.559, 2.771], ["Prozent!", 2.79, 3.305]]}, {"text": "Bauen wir jetzt den Flugplatz für unseren Piloten?", "start": 38.734, "end": 40.973, "spec": {"type": "flug"}, "afx": null, "words": [["Bauen", 0.0, 0.248], ["wir", 0.269, 0.441], ["jetzt", 0.456, 0.704], ["den", 0.725, 0.897], ["Flugplatz", 0.912, 1.312], ["für", 1.347, 1.519], ["unseren", 1.534, 1.858], ["Piloten?", 1.886, 2.21]]}, {"text": "Oder ein Schloss für unseren König?", "start": 41.093, "end": 42.696, "spec": {"type": "schloss"}, "afx": null, "words": [["Oder", 0.0, 0.213], ["ein", 0.232, 0.407], ["Schloss", 0.422, 0.752], ["für", 0.781, 0.955], ["unseren", 0.97, 1.3], ["König?", 1.329, 1.581]]}, {"text": "Der Top-Kommentar entscheidet.", "start": 42.816, "end": 44.563, "spec": {"type": "comment"}, "afx": null, "words": [["Der", 0.0, 0.237], ["Top-Kommentar", 0.258, 0.969], ["entscheidet.", 1.031, 1.69]]}], "dur": 45.96}