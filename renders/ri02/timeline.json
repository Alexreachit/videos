{"lines": [{"text": "Tag zwei auf Roundhead Island!", "start": 0.05, "end": 1.922, "spec": {"type": "day", "mood": "bright"}, "afx": null, "words": [["Tag", 0.086, 0.28], ["zwei", 0.28, 0.614], ["auf", 0.614, 0.743], ["Roundhead", 0.754, 1.088], ["Island", 1.088, 1.39]]}, {"text": "Rückblick: Gestern habe ich mein eigenes Land gegründet.", "start": 2.042, "end": 4.97, "spec": {"type": "recap", "mood": "calm"}, "afx": null, "words": [["Rückblick", 0.097, 0.528], ["Gestern", 0.765, 1.067], ["habe", 1.067, 1.25], ["ich", 1.25, 1.325], ["mein", 1.336, 1.541], ["eigenes", 1.541, 1.864], ["Land", 1.864, 2.058], ["gegründet", 2.069, 2.608]]}, {"text": "Unser Ziel: das reichste Land der Welt.", "start": 5.09, "end": 7.682, "spec": {"type": "goal"}, "afx": null, "words": [["Unser", 0.097, 0.345], ["Ziel", 0.345, 0.765], ["das", 1.088, 1.228], ["reichste", 1.228, 1.606], ["Land", 1.616, 1.832], ["der", 1.843, 1.94], ["Welt", 1.94, 2.274]]}, {"text": "Und jeder Follower wird ein Einwohner der Insel.", "start": 7.802, "end": 10.562, "spec": {"type": "recap2"}, "afx": null, "words": [["Und", 0.086, 0.194], ["jeder", 0.194, 0.485], ["Follower", 0.496, 0.905], ["wird", 0.905, 1.067], ["ein", 1.067, 1.272], ["Einwohner", 1.272, 1.821], ["der", 1.821, 1.983], ["Insel", 1.983, 2.435]]}, {"text": "Dann habt ihr abgestimmt: Wir bauen einen Hafen!", "start": 10.682, "end": 13.418, "spec": {"type": "vote"}, "afx": null, "words": [["Dann", 0.086, 0.172], ["habt", 0.172, 0.345], ["ihr", 0.356, 0.474], ["abgestimmt", 0.474, 1.067], ["Wir", 1.39, 1.509], ["bauen", 1.509, 1.8], ["einen", 1.8, 2.004], ["Hafen", 2.004, 2.425]]}, {"text": "Und jetzt sind wir schon hundertacht Einwohner!", "start": 13.538, "end": 16.034, "spec": {"type": "crowd", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.183], ["jetzt", 0.183, 0.42], ["sind", 0.42, 0.593], ["wir", 0.603, 0.711], ["schon", 0.711, 0.937], ["hundertacht", 0.948, 1.562], ["Einwohner", 1.573, 2.187]]}, {"text": "Eure Likes bringen achthundertsechzig Euro!", "start": 16.154, "end": 18.626, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.097, 0.399], ["Likes", 0.399, 0.571], ["bringen", 0.582, 0.916], ["achthundertsechzig", 0.916, 1.724], ["Euro", 1.724, 2.144]]}, {"text": "Für einen großen Hafen reicht das nicht...", "start": 18.746, "end": 21.026, "spec": {"type": "bigharbor", "mood": "calm"}, "afx": null, "words": [["Für", 0.108, 0.205], ["einen", 0.205, 0.377], ["großen", 0.377, 0.711], ["Hafen", 0.722, 1.088], ["reicht", 1.088, 1.422], ["das", 1.422, 1.584], ["nicht", 1.584, 1.94]]}, {"text": "Aber für einen kleinen Steg und ein Boot!", "start": 21.146, "end": 23.618, "spec": {"type": "pier", "mood": "bright"}, "afx": null, "words": [["Aber", 0.086, 0.237], ["für", 0.248, 0.377], ["einen", 0.388, 0.571], ["kleinen", 0.582, 0.948], ["Steg", 0.959, 1.358], ["und", 1.369, 1.53], ["ein", 1.53, 1.735], ["Boot", 1.735, 2.144]]}, {"text": "Und wir haben ein Maskottchen: Ben Luca, die Krabbe!", "start": 23.738, "end": 27.002, "spec": {"type": "mascot"}, "afx": null, "words": [["Und", 0.086, 0.162], ["wir", 0.162, 0.248], ["haben", 0.259, 0.442], ["ein", 0.442, 0.55], ["Maskottchen", 0.55, 1.196], ["Ben", 1.433, 1.616], ["Luca", 1.616, 2.026], ["die", 2.36, 2.468], ["Krabbe", 2.468, 2.931]]}, {"text": "Nur ein Problem: Wir haben nichts zu essen.", "start": 27.122, "end": 29.762, "spec": {"type": "hunger", "mood": "calm"}, "afx": null, "words": [["Nur", 0.086, 0.183], ["ein", 0.183, 0.291], ["Problem", 0.291, 0.765], ["Wir", 1.142, 1.239], ["haben", 1.239, 1.487], ["nichts", 1.487, 1.724], ["zu", 1.724, 1.907], ["essen", 1.907, 2.317]]}, {"text": "Viele wollen einen Dönermann... aber wir haben nur eine Kokosnuss.", "start": 29.882, "end": 33.626, "spec": {"type": "doner"}, "afx": null, "words": [["Viele", 0.119, 0.366], ["wollen", 0.377, 0.603], ["einen", 0.614, 0.819], ["Dönermann", 0.83, 1.379], ["aber", 1.853, 1.983], ["wir", 1.994, 2.101], ["haben", 2.101, 2.284], ["nur", 2.284, 2.425], ["eine", 2.425, 2.597], ["Kokosnuss", 2.597, 3.427]]}, {"text": "Also: Fahren wir mit dem Boot fischen?", "start": 33.746, "end": 36.098, "spec": {"type": "fish", "mood": "bright"}, "afx": null, "words": [["Also", 0.086, 0.409], ["Fahren", 0.765, 1.078], ["wir", 1.088, 1.207], ["mit", 1.207, 1.304], ["dem", 1.304, 1.412], ["Boot", 1.412, 1.659], ["fischen", 1.67, 2.026]]}, {"text": "Oder rauben wir die Nachbarinseln aus?", "start": 36.218, "end": 38.498, "spec": {"type": "raid"}, "afx": null, "words": [["Oder", 0.097, 0.302], ["rauben", 0.312, 0.625], ["wir", 0.625, 0.7], ["die", 0.711, 0.787], ["Nachbarinseln", 0.797, 1.584], ["aus", 1.584, 1.972]]}, {"text": "Der Top-Kommentar entscheidet.", "start": 38.618, "end": 40.49, "spec": {"type": "comment"}, "afx": null, "words": [["Der", 0.086, 0.183], ["Top-Kommentar", 0.183, 0.894], ["entscheidet", 0.894, 1.519]]}], "dur": 41.89}