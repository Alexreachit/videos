{"lines": [{"text": "Tag zwei auf Roundhead Island!", "start": 0.05, "end": 1.922, "spec": {"type": "day", "mood": "bright"}, "afx": null, "words": [["Tag", 0.086, 0.28], ["zwei", 0.28, 0.614], ["auf", 0.614, 0.743], ["Roundhead", 0.754, 1.088], ["Island", 1.088, 1.39]]}, {"text": "Rückblick: Gestern habe ich mein eigenes Land gegründet.", "start": 2.042, "end": 4.97, "spec": {"type": "recap", "mood": "calm"}, "afx": null, "words": [["Rückblick", 0.097, 0.528], ["Gestern", 0.765, 1.067], ["habe", 1.067, 1.25], ["ich", 1.25, 1.325], ["mein", 1.336, 1.541], ["eigenes", 1.541, 1.864], ["Land", 1.864, 2.058], ["gegründet", 2.069, 2.608]]}, {"text": "Unser Ziel: das reichste Land der Welt.", "start": 5.09, "end": 7.682, "spec": {"type": "goal"}, "afx": null, "words": [["Unser", 0.097, 0.345], ["Ziel", 0.345, 0.765], ["das", 1.088, 1.228], ["reichste", 1.228, 1.606], ["Land", 1.616, 1.832], ["der", 1.843, 1.94], ["Welt", 1.94, 2.274]]}, {"text": "Jeder Follower wird ein Einwohner. Startkapital: zwanzig Euro und eine Kokosnuss.", "start": 7.802, "end": 13.442, "spec": {"type": "recap2"}, "afx": null, "words": [["Jeder", 0.097, 0.334], ["Follower", 0.345, 0.776], ["wird", 0.776, 0.938], ["ein", 0.938, 1.131], ["Einwohner", 1.131, 1.767], ["Startkapital", 2.123, 2.996], ["zwanzig", 3.287, 3.718], ["Euro", 3.728, 4.149], ["und", 4.149, 4.31], ["eine", 4.321, 4.504], ["Kokosnuss", 4.504, 5.323]]}, {"text": "Dann habt ihr abgestimmt: Wir bauen einen Hafen!", "start": 13.562, "end": 16.298, "spec": {"type": "vote"}, "afx": null, "words": [["Dann", 0.086, 0.172], ["habt", 0.172, 0.345], ["ihr", 0.356, 0.474], ["abgestimmt", 0.474, 1.067], ["Wir", 1.39, 1.509], ["bauen", 1.509, 1.8], ["einen", 1.8, 2.004], ["Hafen", 2.004, 2.425]]}, {"text": "Und jetzt sind wir schon hundertacht Einwohner!", "start": 16.418, "end": 18.914, "spec": {"type": "crowd", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.183], ["jetzt", 0.183, 0.42], ["sind", 0.42, 0.593], ["wir", 0.603, 0.711], ["schon", 0.711, 0.937], ["hundertacht", 0.948, 1.562], ["Einwohner", 1.573, 2.187]]}, {"text": "Eure Likes bringen achthundertsechzig Euro!", "start": 19.034, "end": 21.506, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.097, 0.399], ["Likes", 0.399, 0.571], ["bringen", 0.582, 0.916], ["achthundertsechzig", 0.916, 1.724], ["Euro", 1.724, 2.144]]}, {"text": "Für einen großen Hafen reicht das nicht...", "start": 21.626, "end": 23.906, "spec": {"type": "bigharbor", "mood": "calm"}, "afx": null, "words": [["Für", 0.108, 0.205], ["einen", 0.205, 0.377], ["großen", 0.377, 0.711], ["Hafen", 0.722, 1.088], ["reicht", 1.088, 1.422], ["das", 1.422, 1.584], ["nicht", 1.584, 1.94]]}, {"text": "Aber für einen kleinen Steg und ein Boot!", "start": 24.026, "end": 26.498, "spec": {"type": "pier", "mood": "bright"}, "afx": null, "words": [["Aber", 0.086, 0.237], ["für", 0.248, 0.377], ["einen", 0.388, 0.571], ["kleinen", 0.582, 0.948], ["Steg", 0.959, 1.358], ["und", 1.369, 1.53], ["ein", 1.53, 1.735], ["Boot", 1.735, 2.144]]}, {"text": "Und wir haben ein Maskottchen: Ben Luca, die Krabbe!", "start": 26.618, "end": 30.098, "spec": {"type": "mascot"}, "afx": null, "words": [["Und", 0.086, 0.151], ["wir", 0.151, 0.226], ["haben", 0.237, 0.42], ["ein", 0.42, 0.528], ["Maskottchen", 0.528, 1.185], ["Ben", 1.562, 1.767], ["Luca", 1.767, 2.188], ["die", 2.543, 2.662], ["Krabbe", 2.672, 3.157]]}, {"text": "Nur ein Problem: Wir haben nichts zu essen.", "start": 30.218, "end": 32.81, "spec": {"type": "hunger", "mood": "calm"}, "afx": null, "words": [["Nur", 0.086, 0.205], ["ein", 0.205, 0.302], ["Problem", 0.312, 0.787], ["Wir", 1.142, 1.239], ["haben", 1.25, 1.466], ["nichts", 1.466, 1.692], ["zu", 1.692, 1.875], ["essen", 1.875, 2.274]]}, {"text": "Viele wollen einen Dönermann... aber wir haben nur eine Kokosnuss.", "start": 32.93, "end": 36.602, "spec": {"type": "doner"}, "afx": null, "words": [["Viele", 0.119, 0.356], ["wollen", 0.356, 0.582], ["einen", 0.593, 0.765], ["Dönermann", 0.776, 1.304], ["aber", 1.735, 1.853], ["wir", 1.853, 1.94], ["haben", 1.94, 2.198], ["nur", 2.198, 2.349], ["eine", 2.349, 2.522], ["Kokosnuss", 2.522, 3.351]]}, {"text": "Also: Fahren wir mit dem Boot fischen?", "start": 36.722, "end": 39.098, "spec": {"type": "fish", "mood": "bright"}, "afx": null, "words": [["Also", 0.097, 0.431], ["Fahren", 0.776, 1.121], ["wir", 1.121, 1.239], ["mit", 1.239, 1.347], ["dem", 1.358, 1.476], ["Boot", 1.487, 1.724], ["fischen", 1.724, 2.047]]}, {"text": "Oder rauben wir die Nachbarinseln aus?", "start": 39.218, "end": 41.522, "spec": {"type": "raid"}, "afx": null, "words": [["Oder", 0.097, 0.312], ["rauben", 0.312, 0.636], ["wir", 0.636, 0.722], ["die", 0.733, 0.819], ["Nachbarinseln", 0.819, 1.584], ["aus", 1.584, 1.983]]}, {"text": "Der Top-Kommentar entscheidet.", "start": 41.642, "end": 43.514, "spec": {"type": "comment"}, "afx": null, "words": [["Der", 0.086, 0.183], ["Top-Kommentar", 0.183, 0.927], ["entscheidet", 0.927, 1.552]]}], "dur": 44.91}