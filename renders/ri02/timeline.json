{"lines": [{"text": "Tag zwei auf Roundhead Island!", "start": 0.05, "end": 1.922, "spec": {"type": "day", "mood": "bright"}, "afx": null, "words": [["Tag", 0.086, 0.28], ["zwei", 0.28, 0.614], ["auf", 0.614, 0.743], ["Roundhead", 0.754, 1.088], ["Island", 1.088, 1.39]]}, {"text": "Rückblick: Gestern habe ich mein eigenes Land gegründet.", "start": 2.042, "end": 4.97, "spec": {"type": "recap", "mood": "calm"}, "afx": null, "words": [["Rückblick", 0.097, 0.528], ["Gestern", 0.765, 1.067], ["habe", 1.067, 1.25], ["ich", 1.25, 1.325], ["mein", 1.336, 1.541], ["eigenes", 1.541, 1.864], ["Land", 1.864, 2.058], ["gegründet", 2.069, 2.608]]}, {"text": "Ein Einwohner, zwanzig Euro und eine Kokosnuss.", "start": 5.09, "end": 8.522, "spec": {"type": "recap2"}, "afx": null, "words": [["Ein", 0.097, 0.259], ["Einwohner", 0.259, 0.819], ["zwanzig", 1.099, 1.541], ["Euro", 1.541, 1.972], ["und", 1.972, 2.134], ["eine", 2.134, 2.317], ["Kokosnuss", 2.317, 3.114]]}, {"text": "Dann habt ihr abgestimmt: Wir bauen einen Hafen!", "start": 8.642, "end": 11.378, "spec": {"type": "vote"}, "afx": null, "words": [["Dann", 0.086, 0.172], ["habt", 0.172, 0.345], ["ihr", 0.356, 0.474], ["abgestimmt", 0.474, 1.067], ["Wir", 1.39, 1.509], ["bauen", 1.509, 1.8], ["einen", 1.8, 2.004], ["Hafen", 2.004, 2.425]]}, {"text": "Und jetzt sind wir schon hundertacht Einwohner!", "start": 11.498, "end": 13.994, "spec": {"type": "crowd", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.183], ["jetzt", 0.183, 0.42], ["sind", 0.42, 0.593], ["wir", 0.603, 0.711], ["schon", 0.711, 0.937], ["hundertacht", 0.948, 1.562], ["Einwohner", 1.573, 2.187]]}, {"text": "Eure Likes bringen achthundertsechzig Euro!", "start": 14.114, "end": 16.586, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.097, 0.399], ["Likes", 0.399, 0.571], ["bringen", 0.582, 0.916], ["achthundertsechzig", 0.916, 1.724], ["Euro", 1.724, 2.144]]}, {"text": "Für einen großen Hafen reicht das nicht...", "start": 16.706, "end": 18.986, "spec": {"type": "bigharbor", "mood": "calm"}, "afx": null, "words": [["Für", 0.108, 0.205], ["einen", 0.205, 0.377], ["großen", 0.377, 0.711], ["Hafen", 0.722, 1.088], ["reicht", 1.088, 1.422], ["das", 1.422, 1.584], ["nicht", 1.584, 1.94]]}, {"text": "Aber für einen kleinen Steg und ein Boot!", "start": 19.106, "end": 21.578, "spec": {"type": "pier", "mood": "bright"}, "afx": null, "words": [["Aber", 0.086, 0.237], ["für", 0.248, 0.377], ["einen", 0.388, 0.571], ["kleinen", 0.582, 0.948], ["Steg", 0.959, 1.358], ["und", 1.369, 1.53], ["ein", 1.53, 1.735], ["Boot", 1.735, 2.144]]}, {"text": "Und wir haben ein Maskottchen: Ben Luca!", "start": 21.698, "end": 24.17, "spec": {"type": "mascot"}, "afx": null, "words": [["Und", 0.086, 0.172], ["wir", 0.183, 0.259], ["haben", 0.259, 0.474], ["ein", 0.474, 0.593], ["Maskottchen", 0.593, 1.272], ["Ben", 1.509, 1.692], ["Luca", 1.703, 2.155]]}, {"text": "Nur ein Problem: Wir haben nichts zu essen.", "start": 24.29, "end": 26.882, "spec": {"type": "hunger", "mood": "calm"}, "afx": null, "words": [["Nur", 0.086, 0.215], ["ein", 0.226, 0.334], ["Problem", 0.334, 0.819], ["Wir", 1.056, 1.142], ["haben", 1.153, 1.412], ["nichts", 1.412, 1.649], ["zu", 1.659, 1.853], ["essen", 1.853, 2.252]]}, {"text": "Viele wollen einen Dönermann... aber wir haben nur eine Kokosnuss.", "start": 27.002, "end": 30.65, "spec": {"type": "doner"}, "afx": null, "words": [["Viele", 0.119, 0.345], ["wollen", 0.356, 0.603], ["einen", 0.614, 0.797], ["Dönermann", 0.808, 1.369], ["aber", 1.767, 1.897], ["wir", 1.897, 2.004], ["haben", 2.004, 2.209], ["nur", 2.22, 2.328], ["eine", 2.338, 2.511], ["Kokosnuss", 2.511, 3.308]]}, {"text": "Also, mit dem Boot: fischen gehen? Oder die Nachbarinseln ausrauben?", "start": 30.77, "end": 35.306, "spec": {"type": "choice", "mood": "bright"}, "afx": null, "words": [["Also", 0.097, 0.442], ["mit", 0.744, 0.84], ["dem", 0.841, 0.981], ["Boot", 0.981, 1.282], ["fischen", 1.627, 1.94], ["gehen", 1.95, 2.263], ["Oder", 2.619, 2.737], ["die", 2.737, 2.812], ["Nachbarinseln", 2.812, 3.556], ["ausrauben", 3.556, 4.224]]}, {"text": "Der Top-Kommentar entscheidet.", "start": 35.426, "end": 37.298, "spec": {"type": "comment"}, "afx": null, "words": [["Der", 0.086, 0.183], ["Top-Kommentar", 0.183, 0.905], ["entscheidet", 0.905, 1.519]]}], "dur": 38.7}