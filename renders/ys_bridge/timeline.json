{"lines": [{"text": "Why you should never buy a bridge from a stranger.", "start": 0.05, "end": 2.234, "spec": {"type": "hero"}, "afx": null, "words": [["Why", 0.086, 0.172], ["you", 0.183, 0.248], ["should", 0.248, 0.409], ["never", 0.409, 0.668], ["buy", 0.668, 0.819], ["a", 0.819, 0.862], ["bridge", 0.862, 1.207], ["from", 1.207, 1.315], ["a", 1.315, 1.347], ["stranger", 1.347, 1.853]]}, {"text": "In New York, one con man sold the Brooklyn Bridge. Not once. Over and over again.", "start": 2.334, "end": 7.446, "spec": {"type": "sold"}, "afx": null, "words": [["In", 0.086, 0.183], ["New", 0.183, 0.302], ["York", 0.312, 0.625], ["one", 0.83, 1.067], ["con", 1.067, 1.293], ["man", 1.293, 1.595], ["sold", 1.724, 1.983], ["the", 1.983, 2.037], ["Brooklyn", 2.037, 2.306], ["Bridge", 2.306, 2.726], ["Not", 3.071, 3.222], ["once", 3.222, 3.675], ["Over", 4.019, 4.203], ["and", 4.203, 4.289], ["over", 4.289, 4.494], ["again", 4.494, 4.795]]}, {"text": "He picked people who were new in town.", "start": 7.546, "end": 9.418, "spec": {"type": "dock"}, "afx": null, "words": [["He", 0.097, 0.14], ["picked", 0.14, 0.312], ["people", 0.312, 0.55], ["who", 0.55, 0.603], ["were", 0.614, 0.7], ["new", 0.7, 0.948], ["in", 0.948, 1.045], ["town", 1.045, 1.412]]}, {"text": "And showed them forged papers saying he owned the bridge.", "start": 9.518, "end": 12.374, "spec": {"type": "deed"}, "afx": null, "words": [["And", 0.086, 0.151], ["showed", 0.162, 0.377], ["them", 0.377, 0.496], ["forged", 0.496, 0.83], ["papers", 0.83, 1.25], ["saying", 1.422, 1.756], ["he", 1.767, 1.897], ["owned", 1.897, 2.004], ["the", 2.004, 2.047], ["bridge", 2.047, 2.522]]}, {"text": "His pitch: charge a toll on every wagon, and get rich.", "start": 12.474, "end": 15.906, "spec": {"type": "toll"}, "afx": null, "words": [["His", 0.086, 0.162], ["pitch", 0.172, 0.56], ["charge", 0.916, 1.142], ["a", 1.142, 1.175], ["toll", 1.175, 1.401], ["on", 1.412, 1.519], ["every", 1.562, 1.767], ["wagon", 1.767, 2.177], ["and", 2.371, 2.468], ["get", 2.478, 2.694], ["rich", 2.705, 3.103]]}, {"text": "One buyer paid a thousand dollars in cash, and promised four thousand more.", "start": 16.006, "end": 20.278, "spec": {"type": "cash"}, "afx": null, "words": [["One", 0.075, 0.269], ["buyer", 0.269, 0.506], ["paid", 0.506, 0.819], ["a", 0.938, 0.97], ["thousand", 0.97, 1.476], ["dollars", 1.476, 1.756], ["in", 1.756, 1.832], ["cash", 1.832, 2.328], ["and", 2.662, 2.769], ["promised", 2.78, 3.125], ["four", 3.125, 3.308], ["thousand", 3.308, 3.621], ["more", 3.631, 3.933]]}, {"text": "Some buyers even started building toll booths, until the police chased them off.", "start": 20.378, "end": 25.13, "spec": {"type": "police", "cut": true}, "afx": null, "words": [["Some", 0.086, 0.269], ["buyers", 0.269, 0.7], ["even", 0.819, 1.067], ["started", 1.067, 1.444], ["building", 1.444, 1.746], ["toll", 1.746, 2.037], ["booths", 2.037, 2.565], ["until", 2.888, 3.082], ["the", 3.082, 3.157], ["police", 3.157, 3.61], ["chased", 3.707, 3.987], ["them", 3.987, 4.073], ["off", 4.073, 4.429]]}, {"text": "In 1928, the con man got life in Sing Sing prison.", "start": 25.23, "end": 28.95, "spec": {"type": "prison"}, "afx": null, "words": [["In 1928", 0.075, 0.905], ["the", 1.131, 1.196], ["con", 1.196, 1.39], ["man", 1.39, 1.562], ["got", 1.573, 1.767], ["life", 1.767, 2.155], ["in", 2.371, 2.5], ["Sing", 2.5, 2.812], ["Sing", 2.812, 3.028], ["prison", 3.028, 3.394]]}, {"text": "Would you have bought it?", "start": 29.05, "end": 30.922, "spec": {"type": "end", "choice": true}, "afx": null, "words": [["Would", 0.086, 0.151], ["you", 0.151, 0.183], ["have", 0.183, 0.28], ["bought", 0.28, 0.474], ["it", 0.474, 0.582]]}], "dur": 31.32}