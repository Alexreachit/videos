{"lines": [{"text": "Tag 1: Wir graben bis zum Erdkern!", "start": 0.05, "end": 2.93, "spec": {"type": "intro", "mood": "bright"}, "afx": null, "words": [["Tag", 0.097, 0.356], ["eins", 0.366, 0.744], ["Wir", 1.067, 1.207], ["graben", 1.207, 1.562], ["bis", 1.573, 1.735], ["zum", 1.735, 1.94], ["Erdkern", 1.95, 2.554]]}, {"text": "Die Regeln: Folgen macht dich zum Arbeiter, jedes Herz gräbt einen Meter, und in der Umfrage entscheidest du mit!", "start": 3.05, "end": 9.674, "spec": {"type": "regeln"}, "afx": null, "words": [["Die", 0.075, 0.172], ["Regeln", 0.172, 0.571], ["Folgen", 0.916, 1.239], ["macht", 1.239, 1.422], ["dich", 1.433, 1.562], ["zum", 1.562, 1.735], ["Arbeiter", 1.746, 2.284], ["jedes", 2.608, 2.909], ["Herz", 2.92, 3.2], ["gräbt", 3.211, 3.642], ["einen", 3.642, 3.836], ["Meter", 3.836, 4.203], ["und", 4.569, 4.677], ["in", 4.677, 4.741], ["der", 4.741, 4.849], ["Umfrage", 4.849, 5.345], ["entscheidest", 5.356, 5.916], ["du", 5.927, 6.013], ["mit", 6.013, 6.293]]}, {"text": "Unsere ersten 5 Arbeiter legen los!", "start": 9.794, "end": 12.458, "spec": {"type": "dig", "mood": "bright"}, "afx": null, "words": [["Unsere", 0.086, 0.356], ["ersten", 0.356, 0.733], ["5", 0.733, 1.045], ["Arbeiter", 1.045, 1.606], ["legen", 1.616, 1.897], ["los", 1.907, 2.349]]}, {"text": "Bis zur Erdmitte sind es rund 6370 Kilometer.", "start": 12.578, "end": 16.514, "spec": {"type": "earth"}, "afx": null, "words": [["Bis", 0.086, 0.183], ["zur", 0.183, 0.323], ["Erdmitte", 0.334, 0.851], ["sind", 0.851, 1.013], ["es", 1.024, 1.121], ["rund", 1.121, 1.336], ["6370", 1.347, 2.963], ["Kilometer", 2.974, 3.621]]}, {"text": "Der Weltrekord liegt bei 12262 Metern. Den wollen wir knacken!", "start": 16.634, "end": 22.058, "spec": {"type": "record", "mood": "bright"}, "afx": null, "words": [["Der", 0.097, 0.183], ["Weltrekord", 0.183, 0.797], ["liegt", 0.808, 1.034], ["bei", 1.045, 1.25], ["12262", 1.25, 3.276], ["Metern", 3.276, 3.707], ["Den", 4.062, 4.16], ["wollen", 4.16, 4