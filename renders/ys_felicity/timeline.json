{"lines": [{"text": "This ship sank with four thousand luxury cars on board.", "start": 0.05, "end": 3.218, "spec": {"type": "hero"}, "words": [["This", 0.086, 0.248], ["ship", 0.248, 0.474], ["sank", 0.474, 0.959], ["with", 1.121, 1.25], ["four", 1.25, 1.509], ["thousand", 1.509, 1.864], ["luxury", 1.864, 2.134], ["cars", 2.134, 2.435], ["on", 2.435, 2.532], ["board", 2.543, 2.856]]}, {"text": "In February twenty twenty-two, the Felicity Ace left Germany for the United States.", "start": 3.298, "end": 7.834, "spec": {"type": "map", "stage": 1}, "words": [["In", 0.075, 0.162], ["February", 0.162, 0.603], ["twenty", 0.603, 0.808], ["twenty-two", 0.819, 1.39], ["the", 1.638, 1.724], ["Felicity", 1.735, 2.274], ["Ace", 2.338, 2.554], ["left", 2.565, 2.856], ["Germany", 2.856, 3.243], ["for", 3.244, 3.33], ["the", 3.33, 3.362], ["United", 3.373, 3.696], ["States", 3.707, 4.224]]}, {"text": "It was carrying Porsches, Bentleys and Lamborghinis worth about four hundred million dollars.", "start": 7.914, "end": 12.906, "spec": {"type": "cargo"}, "words": [["It", 0.075, 0.14], ["was", 0.14, 0.237], ["carrying", 0.237, 0.647], ["Porsches", 0.657, 1.325], ["Bentleys", 1.53, 2.004], ["and", 2.004, 2.101], ["Lamborghinis", 2.101, 2.791], ["worth", 2.802, 3.103], ["about", 3.114, 3.34], ["four", 3.351, 3.675], ["hundred", 3.675, 3.879], ["million", 3.879, 4.138], ["dollars", 4.149, 4.655]]}, {"text": "But near the Azores, a fire broke out.", "start": 12.986, "end": 15.434, "spec": {"type": "map", "stage": 2, "cut": true}, "words": [["But", 0.075, 0.162], ["near", 0.172, 0.345], ["the", 0.345, 0.42], ["Azores", 0.431, 1.078], ["a", 1.239, 1.293], ["fire", 1.293, 1.584], ["broke", 1.595, 1.832], ["out", 1.832, 2.112]]}, {"text": "All twenty-two crew members were rescued, but the ship kept burning for days.", "start": 15.514, "end": 19.714, "spec": {"type": "burn"}, "words": [["All", 0.086, 0.215], ["twenty-two", 0.215, 0.636], ["crew", 0.636, 0.894], ["members", 0.894, 1.207], ["we