{"lines": [{"text": "Why you should never laugh at a small idea.", "start": 0.05, "end": 2.186, "spec": {"type": "hero"}, "afx": null, "words": [["Why", 0.086, 0.172], ["you", 0.172, 0.248], ["should", 0.259, 0.42], ["never", 0.42, 0.711], ["laugh", 0.711, 1.067], ["at", 1.067, 1.121], ["a", 1.121, 1.153], ["small", 1.153, 1.433], ["idea", 1.433, 1.81]]}, {"text": "In two thousand, Netflix offered to sell itself to Blockbuster for fifty million dollars.", "start": 2.266, "end": 7.378, "spec": {"type": "offer"}, "afx": null, "words": [["In", 0.075, 0.172], ["two", 0.172, 0.345], ["thousand", 0.345, 0.819], ["Netflix", 1.056, 1.541], ["offered", 1.584, 1.875], ["to", 1.875, 1.918], ["sell", 1.929, 2.177], ["itself", 2.188, 2.565], ["to", 2.575, 2.651], ["Blockbuster", 2.651, 3.341], ["for", 3.524, 3.642], ["fifty", 3.653, 3.976], ["million", 3.976, 4.246], ["dollars", 4.246, 4.774]]}, {"text": "Blockbuster had nearly nine thousand stores.", "start": 7.458, "end": 10.218, "spec": {"type": "giant"}, "afx": null, "words": [["Blockbuster", 0.086, 0.582], ["had", 0.593, 0.7], ["nearly", 0.711, 1.067], ["nine", 1.121, 1.519], ["thousand", 1.53, 1.929], ["stores", 1.929, 2.425]]}, {"text": "Netflix mailed DVDs in red envelopes, and lost fifty-seven million that year.", "start": 10.298, "end": 15.266, "spec": {"type": "tiny"}, "afx": null, "words": [["Netflix", 0.086, 0.474], ["mailed", 0.474, 0.819], ["DVDs", 0.927, 1.659], ["in", 1.659, 1.907], ["red", 1.918, 2.101], ["envelopes", 2.101, 2.672], ["and", 2.834, 2.953], ["lost", 2.963, 3.254], ["fifty-seven", 3.254, 3.868], ["million", 3.869, 4.127], ["that", 4.138, 4.3], ["year", 4.3, 4.634]]}, {"text": "Blockbuster's CEO said no, and could barely keep from laughing.", "start": 15.346, "end": 18.778, "spec": {"type": "laugh"}, "afx": null, "words": [["Blockbuster's", 0.097, 0.614], ["CEO", 0.614, 0.884], ["said", 1.024, 1.239], ["no", 1.239, 1.509], ["and", 1.853, 1.918], ["could", 1.918, 2.112], ["barely", 2.123, 2.435], ["keep", 2.446, 2.64], ["from", 2.64, 2.759], ["laughing", 2.759, 3.114]]}, {"text": "In twenty ten, Blockbuster went bankrupt.", "start": 18.858, "end": 21.378, "spec": {"type": "bust"}, "afx": null, "words": [["In", 0.075, 0.14], ["twenty", 0.14, 0.366], ["ten", 0.366, 0.679], ["Blockbuster", 0.873, 1.498], ["went", 1.498, 1.659], ["bankrupt", 1.659, 2.209]]}, {"text": "Today, Netflix is worth about two hundred fifty billion dollars.", "start": 21.458, "end": 25.562, "spec": {"type": "boom", "cut": true}, "afx": null, "words": [["Today", 0.086, 0.356], ["Netflix", 0.7, 1.207], ["is", 1.401, 1.584], ["worth", 1.595, 1.907], ["about", 1.918, 2.231], ["two", 2.338, 2.532], ["hundred", 2.532, 2.726], ["fifty", 2.726, 3.017], ["billion", 3.017, 3.276], ["dollars", 3.276, 3.782]]}, {"text": "Would you have laughed too?", "start": 25.642, "end": 27.514, "spec": {"type": "hero", "choice": true}, "afx": null, "words": [["Would", 0.075, 0.151], ["you", 0.162, 0.194], ["have", 0.194, 0.302], ["laughed", 0.312, 0.55], ["too", 0.55, 0.787]]}], "dur": 27.61}