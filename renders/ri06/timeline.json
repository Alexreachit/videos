{"lines": [{"text": "Ein Bürger wollte Munition sein. Wunsch erfüllt!", "start": 0.05, "end": 3.194, "spec": {"type": "hook", "mood": "bright"}, "afx": null, "words": [["Ein", 0.097, 0.226], ["Bürger", 0.237, 0.539], ["wollte", 0.539, 0.83], ["Munition", 0.841, 1.412], ["sein", 1.422, 1.735], ["Wunsch", 2.101, 2.328], ["erfüllt", 2.328, 2.823]]}, {"text": "Tag 6 auf Roundhead Island!", "start": 3.314, "end": 5.042, "spec": {"type": "map", "mood": "bright"}, "afx": null, "words": [["Tag", 0.086, 0.28], ["6", 0.291, 0.582], ["auf", 0.593, 0.744], ["Roundhead", 0.754, 1.078], ["Island", 1.078, 1.401]]}, {"text": "Ihr habt entschieden: 72 Prozent für Handeln!", "start": 5.162, "end": 8.45, "spec": {"type": "vote", "mood": "bright"}, "afx": null, "words": [["Ihr", 0.097, 0.215], ["habt", 0.215, 0.485], ["entschieden", 0.485, 1.002], ["72", 1.293, 1.961], ["Prozent", 1.972, 2.414], ["für", 2.414, 2.532], ["Handeln", 2.543, 2.974]]}, {"text": "10 neue Bürger! Wir sind jetzt 151 Einwohner.", "start": 8.57, "end": 12.41, "spec": {"type": "crowd"}, "afx": null, "words": [["10", 0.097, 0.312], ["neue", 0.312, 0.56], ["Bürger", 0.571, 0.981], ["Wir", 1.325, 1.455], ["sind", 1.455, 1.627], ["jetzt", 1.627, 1.897], ["151", 1.907, 2.974], ["Einwohner", 2.974, 3.524]]}, {"text": "Eure 28 Herzen bringen 280 Euro.", "start": 12.53, "end": 15.962, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.097, 0.463], ["28", 0.463, 1.175], ["Herzen", 1.175, 1.509], ["bringen", 1.509, 1.821], ["280", 1.832, 2.716], ["Euro", 2.726, 3.114]]}, {"text": "Jetzt sind 550 Euro in der Kasse!", "start": 16.082, "end": 18.962, "spec": {"type": "money2"}, "afx": null, "words": [["Jetzt", 0.097, 0.291], ["sind", 0.291, 0.463], ["550", 0.463, 1.562], ["Euro", 1.562, 1.95], ["in", 1.961, 2.058], ["der", 2.058, 2.166], ["Kasse", 2.177, 2.565]]}, {"text": "Und der fliegende Bürger hatte Kokosnüsse dabei.", "start": 19.082, "end": 21.818, "spec": {"type": "coco", "mood": "calm"}, "afx": null, "words": [["Und", 0.086, 0.162], ["der", 0.172, 0.269], ["fliegende", 0.28, 0.657], ["Bürger", 0.668, 1.002], ["hatte", 1.002, 1.272], ["Kokosnüsse", 1.272, 1.94], ["dabei", 1.95, 2.414]]}, {"text": "Zurück kommt ein Boot voller Melonen!", "start": 21.938, "end": 24.17, "spec": {"type": "boat", "mood": "bright"}, "afx": null, "words": [["Zurück", 0.086, 0.377], ["kommt", 0.388, 0.636], ["ein", 0.636, 0.787], ["Boot", 0.787, 1.045], ["voller", 1.056, 1.422], ["Melonen", 1.433, 1.918]]}, {"text": "Ein anderer wollte ein Eckkopf sein. Jetzt ist er unser Botschafter drüben!", "start": 24.29, "end": 28.562, "spec": {"type": "eckkopf"}, "afx": null, "words": [["Ein", 0.086, 0.226], ["anderer", 0.226, 0.56], ["wollte", 0.56, 0.905], ["ein", 0.916, 1.11], ["Eckkopf", 1.11, 1.541], ["sein", 1.552, 1.886], ["Jetzt", 2.252, 2.489], ["ist", 2.5, 2.64], ["er", 2.64, 2.715], ["unser", 2.716, 2.963], ["Botschafter", 2.963, 3.545], ["drüben", 3.556, 3.933]]}, {"text": "Und wer ein Panzer sein wollte: Hier ist unser Schildkröten-Panzer!", "start": 28.682, "end": 32.306, "spec": {"type": "panzer", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.151], ["wer", 0.151, 0.237], ["ein", 0.248, 0.366], ["Panzer", 0.366, 0.744], ["sein", 0.744, 0.97], ["wollte", 0.97, 1.315], ["Hier", 1.692, 1.843], ["ist", 1.843, 1.95], ["unser", 1.95, 2.166], ["Schildkröten-Panzer", 2.177, 3.297]]}, {"text": "Mit 550 Euro bauen wir jetzt etwas Großes.", "start": 32.426, "end": 35.978, "spec": {"type": "plan", "mood": "calm"}, "afx": null, "words": [["Mit", 0.086, 0.194], ["550", 0.194, 1.293], ["Euro", 1.293, 1.681], ["bauen", 1.681, 1.94], ["wir", 1.94, 2.047], ["jetzt", 2.047, 2.381], ["etwas", 2.381, 2.629], ["Großes", 2.64, 3.233]]}, {"text": "Ein Rathaus für den Bürgermeister?", "start": 36.098, "end": 38.138, "spec": {"type": "rathaus"}, "afx": null, "words": [["Ein", 0.097, 0.248], ["Rathaus", 0.248, 0.776], ["für", 0.776, 0.873], ["den", 0.873, 0.981], ["Bürgermeister", 0.981, 1.713]]}, {"text": "Oder 10 Häuser für die Bürger?", "start": 38.258, "end": 40.178, "spec": {"type": "haeuser"}, "afx": null, "words": [["Oder", 0.097, 0.28], ["10", 0.28, 0.55], ["Häuser", 0.55, 0.959], ["für", 0.959, 1.078], ["die", 1.088, 1.175], ["Bürger", 1.175, 1.584]]}, {"text": "Stimmt in der Umfrage ab!", "start": 40.298, "end": 42.17, "spec": {"type": "poll", "mood": "bright"}, "afx": null, "words": [["Stimmt", 0.086, 0.399], ["in", 0.399, 0.453], ["der", 0.453, 0.56], ["Umfrage", 0.56, 1.121], ["ab", 1.131, 1.379]]}], "dur": 43.57}