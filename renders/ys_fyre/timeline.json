{"lines": [{"text": "Why you should never buy a festival ticket from an Instagram ad.", "start": 0.05, "end": 2.714, "spec": {"shot": "hero"}, "afx": null, "words": [["Why", 0.086, 0.162], ["you", 0.162, 0.226], ["should", 0.226, 0.366], ["never", 0.366, 0.582], ["buy", 0.582, 0.69], ["a", 0.7, 0.743], ["festival", 0.744, 1.25], ["ticket", 1.25, 1.53], ["from", 1.53, 1.638], ["an", 1.638, 1.692], ["Instagram", 1.692, 2.112], ["ad", 2.112, 2.338]]}, {"text": "In 2017, famous models promoted Fyre Festival, a luxury party in the Bahamas.", "start": 2.814, "end": 8.862, "spec": {"shot": "phone"}, "afx": null, "words": [["In 2017", 0.075, 1.347], ["famous", 1.692, 2.015], ["models", 2.015, 2.338], ["promoted", 2.338, 2.78], ["Fyre", 2.78, 3.114], ["Festival", 3.114, 3.642], ["a", 3.976, 4.009], ["luxury", 4.009, 4.429], ["party", 4.429, 4.871], ["in", 4.978, 5.065], ["the", 5.065, 5.119], ["Bahamas", 5.119, 5.711]]}, {"text": "It promised luxury villas and gourmet meals.", "start": 8.962, "end": 11.866, "spec": {"shot": "promise"}, "afx": null, "words": [["It", 0.075, 0.151], ["promised", 0.151, 0.571], ["luxury", 0.571, 0.948], ["villas", 0.959, 1.412], ["and", 1.519, 1.638], ["gourmet", 1.649, 2.026], ["meals", 2.026, 2.586]]}, {"text": "VIP packages with flights cost twelve thousand dollars.", "start": 11.966, "end": 15.398, "spec": {"shot": "price"}, "afx": null, "words": [["VIP", 0.086, 0.528], ["packages", 0.528, 1.002], ["with", 1.002, 1.11], ["flights", 1.121, 1.487], ["cost", 1.487, 1.918], ["twelve", 1.929, 2.295], ["thousand", 2.295, 2.629], ["dollars", 2.629, 3.093]]}, {"text": "But when the guests arrived, they found disaster-relief tents and soaking-wet mattresses.", "start": 15.498, "end": 20.322, "spec": {"shot": "tents"}, "afx": null, "words": [["But", 0.097, 0.162], ["when", 0.162, 0.248], ["the", 0.259, 0.323], ["guests", 0.323, 0.582], ["arrived", 0.593, 1.067], ["they", 1.261, 1.379], ["found", 1.379, 1.692], ["disaster-relief", 1.703, 2.489], ["tents", 2.489, 2.92], ["and", 3.05, 3.308], ["soaking-wet", 3.308, 3.869], ["mattresses", 3.869, 4.504]]}, {"text": "And dinner was a cheese sandwich in a foam box!", "start": 20.422, "end": 23.182, "spec": {"shot": "sandwich", "cut": true}, "afx": null, "words": [["And", 0.086, 0.151], ["dinner", 0.162, 0.377], ["was", 0.388, 0.496], ["a", 0.496, 0.539], ["cheese", 0.55, 0.916], ["sandwich", 0.916, 1.412], ["in", 1.519, 1.595], ["a", 1.595, 1.627], ["foam", 1.627, 1.95], ["box", 1.95, 2.435]]}, {"text": "By the next morning, the festival was called off, and guests were sent back to Miami.", "start": 23.282, "end": 27.722, "spec": {"shot": "airport"}, "afx": null, "words": [["By", 0.086, 0.14], ["the", 0.14, 0.194], ["next", 0.194, 0.399], ["morning", 0.399, 0.765], ["the", 0.991, 1.067], ["festival", 1.067, 1.519], ["was", 1.53, 1.649], ["called", 1.649, 1.929], ["off", 1.929, 2.263], ["and", 2.64, 2.705], ["guests", 2.705, 2.996], ["were", 3.006, 3.082], ["sent", 3.082, 3.319], ["back", 3.319, 3.534], ["to", 3.545, 3.61], ["Miami", 3.621, 4.106]]}, {"text": "Its founder pleaded guilty to fraud and got six years in prison.", "start": 27.822, "end": 31.446, "spec": {"shot": "prison"}, "afx": null, "words": [["Its", 0.086, 0.172], ["founder", 0.183, 0.474], ["pleaded", 0.474, 0.851], ["guilty", 0.905, 1.228], ["to", 1.228, 1.304], ["fraud", 1.304, 1.767], ["and", 1.983, 2.069], ["got", 2.069, 2.252], ["six", 2.252, 2.543], ["years", 2.554, 2.888], ["in", 2.888, 2.953], ["prison", 2.953, 3.308]]}, {"text": "Would you have bought a ticket?", "start": 31.546, "end": 33.418, "spec": {"shot": "end", "choice": true}, "afx": null, "words": [["Would", 0.086, 0.162], ["you", 0.162, 0.205], ["have", 0.205, 0.302], ["bought", 0.302, 0.442], ["a", 0.442, 0.474], ["ticket", 0.474, 0.819]]}], "dur": 33.82}