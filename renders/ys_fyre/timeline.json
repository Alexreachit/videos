{"lines": [{"text": "Why you should never buy a festival ticket from an Instagram ad.", "start": 0.05, "end": 2.714, "spec": {"shot": "hero"}, "afx": null, "words": [["Why", 0.086, 0.162], ["you", 0.162, 0.226], ["should", 0.226, 0.366], ["never", 0.366, 0.582], ["buy", 0.582, 0.69], ["a", 0.7, 0.743], ["festival", 0.744, 1.25], ["ticket", 1.25, 1.53], ["from", 1.53, 1.638], ["an", 1.638, 1.692], ["Instagram", 1.692, 2.112], ["ad", 2.112, 2.338]]}, {"text": "In 2017, famous models promoted Fyre Festival, a luxury party in the Bahamas.", "start": 2.814, "end": 8.862, "spec": {"shot": "phone"}, "afx": null, "words": [["In 2017", 0.075, 1.347], ["famous", 1.692, 2.015], ["models", 2.015, 2.338], ["promoted", 2.338, 2.78], ["Fyre", 2.78, 3.114], ["Festival", 3.114, 3.642], ["a", 3.976, 4.009], ["luxury", 4.009, 4.429], ["party", 4.429, 4.871], ["in", 4.978, 5.065], ["the", 5.065, 5.119], ["Bahamas", 5.119, 5.711]]}, {"text": "It promised luxury villas and gourmet meals.", "start": 8.962, "end": 11.914, "spec": {"shot": "promise"}, "afx": null, "words": [["It", 0.086, 0.151], ["promised", 0.151, 0.636], ["luxury", 0.647, 1.013], ["villas", 1.013, 1.509], ["and", 1.584, 1.703], ["gourmet", 1.703, 2.09], ["meals", 2.091, 2.629]]}, {"text": "VIP packages with flights cost twelve thousand dollars.", "start": 12.014, "end": 15.854, "spec": {"shot": "price"}, "afx": null, "words": [["VIP", 0.086, 0.571], ["packages", 0.571, 1.11], ["with", 1.11, 1.228], ["flights", 1.239, 1.692], ["cost", 1.897, 2.306], ["twelve", 2.36, 2.715], ["thousand", 2.716, 3.028], ["dollars", 3.028, 3.513]]}, {"text": "But when the guests arrived, they found disaster-relief tents and soaking-wet mattresses.", "start": 15.954, "end": 20.682, "spec": {"shot": "tents"}, "afx": null, "words": [["But", 0.086, 0.162], ["when", 0.172, 0.259], ["the", 0.259, 0.312], ["guests", 0.312, 0.614], ["arrived", 0.614, 1.099], ["they", 1.282, 1.401], ["found", 1.401, 1.681], ["disaster-relief", 1.681, 2.5], ["tents", 2.5, 2.899], ["and", 3.017, 3.19], ["soaking-wet", 3.2, 3.772], ["mattresses", 3.772, 4.407]]}, {"text": "And dinner was a cheese sandwich in a foam box!", "start": 20.782, "end": 23.518, "spec": {"shot": "sandwich", "cut": true}, "afx": null, "words": [["And", 0.086, 0.151], ["dinner", 0.162, 0.356], ["was", 0.366, 0.463], ["a", 0.463, 0.506], ["cheese", 0.506, 0.862], ["sandwich", 0.873, 1.422], ["in", 1.519, 1.573], ["a", 1.573, 1.606], ["foam", 1.606, 1.907], ["box", 1.907, 2.414]]}, {"text": "By the next morning, the festival was called off, and guests were sent back to Miami.", "start": 23.618, "end": 27.986, "spec": {"shot": "airport"}, "afx": null, "words": [["By", 0.086, 0.14], ["the", 0.14, 0.194], ["next", 0.194, 0.399], ["morning", 0.409, 0.787], ["the", 1.024, 1.099], ["festival", 1.099, 1.509], ["was", 1.509, 1.606], ["called", 1.616, 1.886], ["off", 1.886, 2.22], ["and", 2.575, 2.651], ["guests", 2.651, 2.92], ["were", 2.92, 2.996], ["sent", 2.996, 3.233], ["back", 3.233, 3.47], ["to", 3.47, 3.534], ["Miami", 3.534, 4.041]]}, {"text": "Its founder pleaded guilty to fraud and got six years in prison.", "start": 28.086, "end": 31.734, "spec": {"shot": "prison"}, "afx": null, "words": [["Its", 0.075, 0.162], ["founder", 0.172, 0.463], ["pleaded", 0.463, 0.83], ["guilty", 0.884, 1.185], ["to", 1.185, 1.282], ["fraud", 1.282, 1.746], ["and", 1.961, 2.047], ["got", 2.058, 2.231], ["six", 2.231, 2.565], ["years", 2.575, 2.909], ["in", 2.909, 2.974], ["prison", 2.974, 3.319]]}, {"text": "Would you have bought a ticket?", "start": 31.834, "end": 33.706, "spec": {"shot": "end", "choice": true}, "afx": null, "words": [["Would", 0.075, 0.151], ["you", 0.162, 0.205], ["have", 0.205, 0.291], ["bought", 0.291, 0.42], ["a", 0.42, 0.453], ["ticket", 0.463, 0.797]]}], "dur": 34.11}