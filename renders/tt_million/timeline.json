{"lines": [{"text": "If everyone on Earth got one million dollars, this coffee could cost four hundred dollars.", "start": 0.15, "end": 4.902, "spec": {"img": 1, "ov": "hook"}, "words": [["If", 0.091, 0.182], ["everyone", 0.182, 0.477], ["on", 0.489, 0.591], ["Earth", 0.591, 0.852], ["got", 0.864, 1.08], ["one", 1.17, 1.466], ["million", 1.466, 1.784], ["dollars", 1.795, 2.364], ["this", 2.432, 2.602], ["coffee", 2.602, 2.989], ["could", 2.989, 3.148], ["cost", 3.159, 3.557], ["four", 3.557, 3.761], ["hundred", 3.761, 3.92], ["dollars", 3.92, 4.42]]}, {"text": "Imagine you wake up, check your bank account, and there it is: one million dollars.", "start": 5.202, "end": 9.954, "spec": {"img": 2, "ov": "phone"}, "words": [["Imagine", 0.08, 0.42], ["you", 0.42, 0.511], ["wake", 0.511, 0.716], ["up", 0.716, 0.943], ["check", 1.159, 1.341], ["your", 1.341, 1.432], ["bank", 1.443, 1.716], ["account", 1.716, 2.102], ["and", 2.477, 2.545], ["there", 2.557, 2.705], ["it", 2.705, 2.761], ["is", 2.761, 3.08], ["one", 3.307, 3.523], ["million", 3.523, 3.852], ["dollars", 3.852, 4.42]]}, {"text": "Not just you. Your neighbor, your boss, the barista. Every single person on Earth.", "start": 10.254, "end": 15.486, "spec": {"img": 3, "ov": "everyone"}, "words": [["Not", 0.08, 0.205], ["just", 0.205, 0.398], ["you", 0.398, 0.58], ["Your", 0.943, 1.034], ["neighbor", 1.045, 1.511], ["your", 1.864, 1.932], ["boss", 1.932, 2.511], ["the", 2.67, 2.761], ["barista", 2.773, 3.307], ["Every", 3.67, 3.875], ["single", 3.875, 4.102], ["person", 4.114, 4.409], ["on", 4.409, 4.534], ["Earth", 4.545, 4.898]]}, {"text": "For a few days, everyone feels rich. People buy new cars, phones and vacations.", "start": 15.786, "end": 21.594, "spec": {"img": 4, "ov": "spree"}, "words": [["For", 0.114, 0.17], ["a", 0.17, 0.205], ["few", 0.216, 0.432], ["days", 0.432, 0.898], ["everyone", 1.136, 1.489], ["feels", 1.5, 1.864], ["rich", 1.864, 2.341], ["People", 2.705, 2.875], ["buy", 2.875, 2.977], ["new", 2.