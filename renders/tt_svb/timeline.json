{"lines": [{"text": "Why you should never keep all your money in one bank.", "start": 0.05, "end": 2.186, "spec": {"type": "hero", "title": ["WHY YOU SHOULD NEVER", "KEEP ALL YOUR MONEY", "IN ONE BANK"], "mood": "tense"}, "words": [["Why", 0.097, 0.172], ["you", 0.183, 0.237], ["should", 0.237, 0.356], ["never", 0.356, 0.517], ["keep", 0.517, 0.7], ["all", 0.776, 0.894], ["your", 0.894, 0.991], ["money", 0.991, 1.207], ["in", 1.207, 1.282], ["one", 1.293, 1.455], ["bank", 1.455, 1.821]]}, {"text": "In twenty twenty-three, forty-two billion dollars left Silicon Valley Bank in one day.", "start": 2.266, "end": 7.162, "spec": {"type": "map", "cam": [-98, 39, 2.0], "cam2": [-121.5, 37.0, 10], "pins": [{"at": [-121.96, 37.35], "label": "Silicon Valley Bank", "col": "red", "delay": 0.3}]}, "words": [["In", 0.075, 0.14], ["twenty", 0.14, 0.366], ["twenty-three", 0.366, 0.959], ["forty-two", 1.175, 1.681], ["billion", 1.746, 2.047], ["dollars", 2.047, 2.425], ["left", 2.435, 2.64], ["Silicon", 2.651, 3.071], ["Valley", 3.071, 3.362], ["Bank", 3.373, 3.696], ["in", 3.879, 4.019], ["one", 4.019, 4.235], ["day", 4.246, 4.558]]}, {"text": "It started with a one-point-eight-billion-dollar loss.", "start": 7.242, "end": 9.954, "spec": {"type": "loss"}, "words": [["It", 0.075, 0.129], ["started", 0.14, 0.431], ["with", 0.442, 0.539], ["a", 0.539, 0.603], ["one-point-eight-billion-dollar", 0.614, 1.897], ["loss", 1.907, 2.392]]}, {"text": "Founders panicked in group chats and pulled everything out.", "start": 10.034, "end": 13.514, "spec": {"type": "panic"}, "words": [["Founders", 0.14, 0.431], ["panicked", 0.431, 0.787], ["in", 0.797, 0.84], ["group", 0.841, 1.067], ["chats", 1.067, 1.476], ["and", 1.724, 1.843], ["pulled", 1.853, 2.306], ["everything", 2.457, 2.845], ["out", 2.856, 3.147]]}, {"text": "Less than two days later, the bank was shut down.", "start": 13.594, "end": 16.33, "spec": {"type": "closed", "cut": true}, "words": [["Less", 0.075, 0.215], ["than", 0.226, 0.334],