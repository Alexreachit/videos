{"lines": [{"text": "Tag 1: Wir graben ein Loch bis zum Erdkern!", "start": 0.05, "end": 3.266, "spec": {"type": "intro", "mood": "bright"}, "afx": null, "words": [["Tag", 0.086, 0.334], ["eins", 0.345, 0.733], ["Wir", 1.056, 1.196], ["graben", 1.196, 1.541], ["ein", 1.552, 1.724], ["Loch", 1.724, 1.95], ["bis", 1.961, 2.123], ["zum", 2.123, 2.317], ["Erdkern", 2.317, 2.877]]}, {"text": "Noch grabe ich ganz allein.", "start": 3.386, "end": 5.258, "spec": {"type": "alone", "mood": "calm"}, "afx": null, "words": [["Noch", 0.086, 0.194], ["grabe", 0.194, 0.517], ["ich", 0.517, 0.603], ["ganz", 0.603, 0.862], ["allein", 0.862, 1.25]]}, {"text": "Jeder Follower wird ein neuer Arbeiter am Loch.", "start": 5.378, "end": 7.97, "spec": {"type": "ghost"}, "afx": null, "words": [["Jeder", 0.097, 0.345], ["Follower", 0.356, 0.733], ["wird", 0.733, 0.894], ["ein", 0.894, 1.056], ["neuer", 1.067, 1.315], ["Arbeiter", 1.315, 1.767], ["am", 1.767, 1.907], ["Loch", 1.907, 2.263]]}, {"text": "Jedes Like: Jeder Arbeiter schaufelt einmal. Jeder Share: fünfmal!", "start": 8.09, "end": 12.698, "spec": {"type": "rules"}, "afx": null, "words": [["Jedes", 0.097, 0.42], ["Like", 0.42, 0.636], ["Jeder", 0.948, 1.239], ["Arbeiter", 1.25, 1.67], ["schaufelt", 1.67, 2.198], ["einmal", 2.198, 2.651], ["Jeder", 3.006, 3.2], ["Share", 3.211, 3.502], ["fünfmal", 3.739, 4.289]]}, {"text": "Und so weit ist es bis zum Erdkern:", "start": 12.818, "end": 14.93, "spec": {"type": "zoom"}, "afx": null, "words": [["Und", 0.086, 0.183], ["so", 0.194, 0.312], ["weit", 0.312, 0.657], ["ist", 0.657, 0.797], ["es", 0.808, 0.884], ["bis", 0.884, 1.034], ["zum", 1.034, 1.218], ["Erdkern", 1.228, 1.789]]}, {"text": "6370 Kilometer!", "start": 15.05, "end": 17.93, "spec": {"type": "earth", "mood": "bright"}, "afx": null, "words": [["6370", 0.086, 1.832], ["Kilometer", 1.843, 2.543]]}, {"text": "Mit 10 Zentimetern pro Schaufel sind das 63,7 Millionen Mal schaufeln.", "start": 18.05, "end": 23.042, "spec": {"type": "number"}, "afx": null, "words": [["Mit", 0.086, 0.215], ["10", 0.215, 0.431], ["Zentimetern", 0.431, 1.045], ["pro", 1.056, 1.293], ["Schaufel", 1.304, 1.843], ["sind", 1.843, 2.069], ["das", 2.069, 2.209], ["63,7", 2.209, 2.974], ["Komma", 2.974, 3.211], ["sieben", 3.222, 3.556], ["Millionen", 3.556, 3.933], ["Mal", 3.944, 4.149], ["schaufeln", 4.16, 4.666]]}, {"text": "Also folg mir, damit ich nicht allein graben muss!", "start": 23.162, "end": 26.354, "spec": {"type": "follow", "mood": "bright"}, "afx": null, "words": [["Also", 0.097, 0.345], ["folg", 0.345, 0.711], ["mir", 0.711, 0.97], ["damit", 1.272, 1.476], ["ich", 1.487, 1.584], ["nicht", 1.595, 1.8], ["allein", 1.81, 2.144], ["graben", 2.144, 2.5], ["muss", 2.5, 2.866]]}, {"text": "Welches Werkzeug brauchen wir?", "start": 26.474, "end": 28.466, "spec": {"type": "comment"}, "afx": null, "words": [["Welches", 0.097, 0.431], ["Werkzeug", 0.431, 0.97], ["brauchen", 0.981, 1.358], ["wir", 1.358, 1.67]]}], "dur": 29.87}