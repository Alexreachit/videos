{"lines": [{"text": "Tag 10 auf Roundhead Island!", "start": 0.05, "end": 1.754, "spec": {"type": "map", "mood": "bright"}, "afx": null, "words": [["Tag", 0.086, 0.28], ["10", 0.291, 0.56], ["auf", 0.56, 0.722], ["Roundhead", 0.733, 1.078], ["Island", 1.078, 1.39]]}, {"text": "Die Regeln: Folgen macht dich zum Einwohner, jedes Herz bringt 10 Euro, und im Kommentar darfst du dir was wünschen!", "start": 1.874, "end": 8.402, "spec": {"type": "regeln"}, "afx": null, "words": [["Die", 0.097, 0.183], ["Regeln", 0.183, 0.571], ["Folgen", 0.884, 1.164], ["macht", 1.164, 1.336], ["dich", 1.336, 1.465], ["zum", 1.476, 1.681], ["Einwohner", 1.692, 2.263], ["jedes", 2.619, 2.899], ["Herz", 2.899, 3.19], ["bringt", 3.2, 3.459], ["10", 3.47, 3.815], ["Euro", 3.815, 4.192], ["und", 4.537, 4.634], ["im", 4.634, 4.72], ["Kommentar", 4.731, 5.237], ["darfst", 5.237, 5.506], ["du", 5.506, 5.571], ["dir", 5.571, 5.679], ["was", 5.69, 5.819], ["wünschen", 5.83, 6.196]]}, {"text": "5 neue Bürger! Wir sind jetzt 176 Einwohner.", "start": 8.522, "end": 12.554, "spec": {"type": "crowd", "mood": "bright"}, "afx": null, "words": [["5", 0.119, 0.291], ["neue", 0.291, 0.539], ["Bürger", 0.539, 0.937], ["Wir", 1.293, 1.412], ["sind", 1.412, 1.562], ["jetzt", 1.562, 1.843], ["176", 1.853, 3.114], ["Einwohner", 3.114, 3.696]]}, {"text": "Eure 22 Herzen bringen 220 Euro. Macht 680 Euro.", "start": 12.674, "end": 18.074, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.086, 0.366], ["22", 0.377, 1.207], ["Herzen", 1.207, 1.509], ["bringen", 1.519, 1.853], ["220", 1.864, 2.953], ["Euro", 2.953, 3.319], ["Macht", 3.642, 3.847], ["680", 3.847, 4.666], ["Euro", 4.677, 5.075]]}, {"text": "Für die Polizeistation fehlen nur noch 40 Euro!", "start": 18.194, "end": 21.506, "spec": {"type": "gap", "mood": "calm"}, "afx": null, "words": [["Für", 0.108, 0.194], ["die", 0.194, 0.259], ["Polizeistation", 0.269, 1.218], ["fehlen", 1.228, 1.659], ["nur", 1.778, 1.907], ["noch", 1.907, 2.069], ["40", 2.069, 2.565], ["Euro", 2.565, 2.996]]}, {"text": "Da hilft Always Team Dog: Sein Kinderpunsch-Stand verdient die 40 Euro!", "start": 21.626, "end": 26.09, "spec": {"type": "punch", "mood": "bright"}, "afx": null, "words": [["Da", 0.097, 0.28], ["hilft", 0.28, 0.593], ["Always", 0.603, 0.873], ["Team", 0.884, 1.11], ["Dog", 1.11, 1.401], ["Sein", 1.724, 1.918], ["Kinderpunsch-Stand", 1.918, 2.672], ["verdient", 2.672, 3.071], ["die", 3.071, 3.2], ["40", 3.2, 3.707], ["Euro", 3.718, 4.149]]}, {"text": "Die Polizeistation ist fertig!", "start": 26.21, "end": 28.418, "spec": {"type": "station", "mood": "bright"}, "afx": null, "words": [["Die", 0.086, 0.151], ["Polizeistation", 0.162, 1.142], ["ist", 1.142, 1.282], ["fertig", 1.293, 1.886]]}, {"text": "Und unser neuer Polizeichef ist Mex!", "start": 28.538, "end": 31.034, "spec": {"type": "chief"}, "afx": null, "words": [["Und", 0.086, 0.215], ["unser", 0.215, 0.442], ["neuer", 0.442, 0.733], ["Polizeichef", 0.744, 1.509], ["ist", 1.519, 1.692], ["Mex", 1.703, 2.166]]}, {"text": "Alina wird unsere Inselärztin im Krankenhaus.", "start": 31.154, "end": 34.346, "spec": {"type": "wish"}, "afx": null, "words": [["Alina", 0.097, 0.442], ["wird", 0.442, 0.657], ["unsere", 0.657, 1.013], ["Inselärztin", 1.024, 1.918], ["im", 1.929, 2.058], ["Krankenhaus", 2.069, 2.877]]}, {"text": "Kai wird Soldat und bewacht den Strand.", "start": 34.466, "end": 36.746, "spec": {"type": "wish"}, "afx": null, "words": [["Kai", 0.086, 0.248], ["wird", 0.248, 0.388], ["Soldat", 0.399, 0.937], ["und", 0.938, 1.088], ["bewacht", 1.099, 1.401], ["den", 1.412, 1.53], ["Strand", 1.53, 1.95]]}, {"text": "Und Edition bekommt einen Dönerladen!", "start": 36.866, "end": 38.954, "spec": {"type": "wish", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.183], ["Edition", 0.183, 0.442], ["bekommt", 0.442, 0.873], ["einen", 0.873, 1.121], ["Dönerladen", 1.121, 1.767]]}, {"text": "Bei 200 Einwohnern wartet die Überraschung. Nur noch 24!", "start": 39.074, "end": 43.298, "spec": {"type": "surprise", "mood": "bright"}, "afx": null, "words": [["Bei", 0.097, 0.194], ["200", 0.194, 0.679], ["Einwohnern", 0.69, 1.207], ["wartet", 1.207, 1.595], ["die", 1.595, 1.724], ["Überraschung", 1.724, 2.284], ["Nur", 2.629, 2.726], ["noch", 2.726, 2.866], ["24", 2.866, 3.912]]}, {"text": "Was bauen wir als Nächstes: Flugplatz oder Freibad?", "start": 43.418, "end": 46.61, "spec": {"type": "chef"}, "afx": null, "words": [["Was", 0.097, 0.205], ["bauen", 0.205, 0.442], ["wir", 0.442, 0.539], ["als", 0.539, 0.668], ["Nächstes", 0.679, 1.282], ["Flugplatz", 1.476, 2.047], ["oder", 2.058, 2.263], ["Freibad", 2.263, 2.856]]}, {"text": "Stimmt in der Umfrage ab!", "start": 46.73, "end": 48.602, "spec": {"type": "poll", "mood": "bright"}, "afx": null, "words": [["Stimmt", 0.086, 0.409], ["in", 0.409, 0.474], ["der", 0.474, 0.593], ["Umfrage", 0.603, 1.121], ["ab", 1.131, 1.369]]}], "dur": 50.0}