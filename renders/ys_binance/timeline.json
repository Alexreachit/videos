{"lines": [{"text": "Why you should never keep all your crypto on one exchange.", "start": 0.05, "end": 2.786, "spec": {"type": "hero"}, "afx": null, "words": [["Why", 0.086, 0.162], ["you", 0.162, 0.226], ["should", 0.226, 0.366], ["never", 0.366, 0.539], ["keep", 0.539, 0.776], ["all", 0.894, 1.024], ["your", 1.024, 1.131], ["crypto", 1.131, 1.509], ["on", 1.519, 1.659], ["one", 1.659, 1.767], ["exchange", 1.767, 2.403]]}, {"text": "On October twenty-ninth, hackers broke into Binance, the world's biggest crypto exchange.", "start": 2.866, "end": 8.05, "spec": {"type": "breakin"}, "afx": null, "words": [["On", 0.075, 0.162], ["October", 0.162, 0.517], ["twenty-ninth", 0.517, 1.142], ["hackers", 1.336, 1.724], ["broke", 1.735, 2.058], ["into", 2.069, 2.209], ["Binance", 2.209, 2.791], ["the", 2.985, 3.06], ["world's", 3.06, 3.416], ["biggest", 3.491, 3.89], ["crypto", 3.901, 4.246], ["exchange", 4.246, 4.871]]}, {"text": "Early findings point to one engineer's hacked laptop.", "start": 8.13, "end": 11.49, "spec": {"type": "laptop"}, "afx": null, "words": [["Early", 0.086, 0.302], ["findings", 0.302, 0.797], ["point", 0.894, 1.207], ["to", 1.272, 1.369], ["one", 1.369, 1.595], ["engineer's", 1.595, 2.101], ["hacked", 2.22, 2.511], ["laptop", 2.511, 3.039]]}, {"text": "Within about twenty minutes, six point three billion dollars were drained.", "start": 11.57, "end": 15.482, "spec": {"type": "drain", "cut": true}, "afx": null, "words": [["Within", 0.086, 0.28], ["about", 0.28, 0.496], ["twenty", 0.506, 0.776], ["minutes", 0.776, 1.196], ["six", 1.422, 1.638], ["point", 1.638, 1.907], ["three", 1.918, 2.295], ["billion", 2.36, 2.715], ["dollars", 2.716, 3.028], ["were", 3.039, 3.147], ["drained", 3.147, 3.578]]}, {"text": "WAIT!!! FOLLOW for more stories like this!!!", "start": 15.562, "end": 18.082, "spec": {"type": "samyell"}, "afx": "acompressor=threshold=-22dB:ratio=4:attack=4:release=80:makeup=4,volume=3dB", "words": [["WAIT", 0.082, 0.338], ["FOLLOW", 0.707, 0.90