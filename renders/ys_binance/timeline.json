{"lines": [{"text": "Why you should never keep all your crypto on one exchange.", "start": 0.05, "end": 2.786, "spec": {"type": "hero"}, "afx": null, "words": [["Why", 0.086, 0.162], ["you", 0.162, 0.226], ["should", 0.226, 0.366], ["never", 0.366, 0.539], ["keep", 0.539, 0.776], ["all", 0.894, 1.024], ["your", 1.024, 1.131], ["crypto", 1.131, 1.509], ["on", 1.519, 1.659], ["one", 1.659, 1.767], ["exchange", 1.767, 2.403]]}, {"text": "On October twenty-ninth, hackers broke into Binance, the world's biggest crypto exchange.", "start": 2.866, "end": 7.858, "spec": {"type": "breakin"}, "afx": null, "words": [["On", 0.075, 0.14], ["October", 0.14, 0.474], ["twenty-ninth", 0.474, 1.099], ["hackers", 1.282, 1.649], ["broke", 1.649, 1.95], ["into", 1.961, 2.08], ["Binance", 2.08, 2.619], ["the", 2.856, 2.931], ["world's", 2.931, 3.276], ["biggest", 3.384, 3.707], ["crypto", 3.707, 4.041], ["exchange", 4.052, 4.666]]}, {"text": "Early findings point to one engineer's hacked laptop.", "start": 7.938, "end": 11.37, "spec": {"type": "laptop"}, "afx": null, "words": [["Early", 0.075, 0.28], ["findings", 0.28, 0.733], ["point", 0.819, 1.142], ["to", 1.25, 1.358], ["one", 1.358, 1.627], ["engineer's", 1.638, 2.144], ["hacked", 2.295, 2.608], ["laptop", 2.619, 3.114]]}, {"text": "Within about twenty minutes, six point three billion dollars were drained.", "start": 11.45, "end": 15.194, "spec": {"type": "drain", "cut": true}, "afx": null, "words": [["Within", 0.086, 0.28], ["about", 0.28, 0.506], ["twenty", 0.517, 0.787], ["minutes", 0.797, 1.196], ["six", 1.444, 1.627], ["point", 1.627, 1.843], ["three", 1.853, 2.187], ["billion", 2.241, 2.575], ["dollars", 2.575, 2.888], ["were", 2.888, 2.974], ["drained", 2.974, 3.438]]}, {"text": "WAIT!!! FOLLOW for more stories like this!!!", "start": 15.274, "end": 17.794, "spec": {"type": "samyell"}, "afx": "acompressor=threshold=-22dB:ratio=4:attack=4:release=80:makeup=4,volume=3dB", "words": [["WAIT", 0.082, 0.338], ["FOLLOW", 0.707, 0.912