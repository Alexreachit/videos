{"lines": [{"text": "In the summer of 1920, thousands of people in Boston lined up in the street to hand their savings to one man.", "start": 0.5, "end": 7.868, "spec": {"shot": "street_wide", "ui": "date1920"}, "afx": null, "words": [["In", 0.072, 0.132], ["the", 0.144, 0.216], ["summer", 0.216, 0.541], ["of", 0.541, 0.613], ["1920", 0.625, 1.466], ["thousands", 1.719, 2.2], ["of", 2.212, 2.272], ["people", 2.272, 2.572], ["in", 2.572, 2.644], ["Boston", 2.656, 3.233], ["lined", 3.522, 3.882], ["up", 3.882, 4.05], ["in", 4.062, 4.111], ["the", 4.111, 4.171], ["street", 4.183, 4.603], ["to", 4.784, 4.88], ["hand", 4.892, 5.228], ["their", 5.24, 5.385], ["savings", 5.385, 6.07], ["to", 6.262, 6.37], ["one", 6.37, 6.659], ["man", 6.671, 7.007]]}, {"text": "He promised them fifty percent profit in just forty-five days.", "start": 8.288, "end": 12.344, "spec": {"shot": "office_door", "ui": "promise"}, "afx": null, "words": [["He", 0.084, 0.144], ["promised", 0.156, 0.565], ["them", 0.565, 0.733], ["fifty", 0.805, 1.13], ["percent", 1.13, 1.466], ["profit", 1.466, 1.911], ["in", 2.151, 2.248], ["just", 2.248, 2.452], ["forty-five", 2.464, 3.197], ["days", 3.197, 3.702]]}, {"text": "Banks were paying about five percent. Per year.", "start": 12.764, "end": 15.644, "spec": {"shot": "bank_compare", "ui": "compare"}, "afx": null, "words": [["Banks", 0.096, 0.288], ["were", 0.288, 0.385], ["paying", 0.385, 0.661], ["about", 0.661, 0.865], ["five", 0.865, 1.19], ["percent", 1.19, 1.671], ["Per", 2.079, 2.224], ["year", 2.236, 2.524]]}, {"text": "At his peak, he was taking in up to two hundred and fifty thousand dollars a day.", "start": 16.064, "end": 20.168, "spec": {"shot": "money_rain", "ui": "perday"}, "afx": null, "words": [["At", 0.096, 0.168], ["his", 0.168, 0.337], ["peak", 0.337, 0.829], ["he", 1.082, 1.142], ["was", 1.142, 1.262], ["taking", 1.262, 1.514], ["in", 1.514, 1.587], ["up", 1.587, 1.707], ["to", 1.707, 1.851], ["two", 1.863, 2.103], ["hundred", 2.103, 2.284], ["and", 2.284, 2.332], ["fifty", 2.344, 2.68], ["thousand", 2.68, 3.065], ["dollars", 3.065, 3.329], ["a", 3.329, 3.365], ["day", 3.377, 3.75]]}, {"text": "And a few weeks later, it all came crashing down.", "start": 20.588, "end": 23.756, "spec": {"shot": "crash_teaser", "mood": "dark"}, "afx": null, "words": [["And", 0.096, 0.144], ["a", 0.144, 0.18], ["few", 0.18, 0.349], ["weeks", 0.361, 0.565], ["later", 0.565, 0.901], ["it", 1.274, 1.358], ["all", 1.358, 1.611], ["came", 1.611, 1.887], ["crashing", 1.887, 2.392], ["down", 2.404, 2.8]]}, {"text": "His name was Charles Ponzi. And this is how one man turned postage stamps into the most famous scam in history.", "start": 24.176, "end": 31.184, "spec": {"shot": "title", "ui": "title"}, "afx": null, "words": [["His", 0.084, 0.156], ["name", 0.156, 0.3], ["was", 0.3, 0.397], ["Charles", 0.397, 0.697], ["Ponzi", 0.709, 1.214], ["And", 1.587, 1.671], ["this", 1.683, 1.839], ["is", 1.851, 1.947], ["how", 1.959, 2.175], ["one", 2.188, 2.536], ["man", 2.536, 2.957], ["turned", 3.029, 3.305], ["postage", 3.317, 3.774], ["stamps", 3.786, 4.291], ["into", 4.387, 4.507], ["the", 4.519, 4.579], ["most", 4.579, 4.844], ["famous", 4.856, 5.361], ["scam", 5.361, 5.829], ["in", 5.998, 6.082], ["history", 6.094, 6.647]]}, {"text": "Ponzi was born in Italy in 1882.", "start": 31.604, "end": 34.772, "spec": {"shot": "map_italy", "cut": true, "ui": "ch1"}, "afx": null, "words": [["Ponzi", 0.096, 0.397], ["was", 0.397, 0.541], ["born", 0.541, 0.805], ["in", 0.817, 0.913], ["Italy", 1.01, 1.418], ["in 1882", 1.538, 2.812]]}, {"text": "In November 1903, he stepped off a ship in Boston with just two dollars and fifty cents in his pocket. He had gambled away the rest on the way over.", "start": 35.192, "end": 44.168, "spec": {"shot": "ship", "ui": "cash250"}, "afx": null, "words": [["In", 0.084, 0.168], ["November 1903", 0.168, 1.587], ["he", 1.815, 1.887], ["stepped", 1.899, 2.151], ["off", 2.151, 2.272], ["a", 2.272, 2.308], ["ship", 2.308, 2.572], ["in", 2.572, 2.632], ["Boston", 2.632, 3.101], ["with", 3.113, 3.233], ["just", 3.233, 3.413], ["two", 3.425, 3.666], ["dollars", 3.666, 4.075], ["and", 4.074, 4.171], ["fifty", 4.231, 4.651], ["cents", 4.651, 5.096], ["in", 5.108, 5.18], ["his", 5.18, 5.264], ["pocket", 5.264, 5.721], ["He", 6.13, 6.19], ["had", 6.19, 6.37], ["gambled", 6.514, 6.875], ["away", 6.875, 7.079], ["the", 7.079, 7.163], ["rest", 7.163, 7.704], ["on", 7.873, 7.945], ["the", 7.957, 8.017], ["way", 8.017, 8.209], ["over", 8.209, 8.642]]}, {"text": "He washed dishes. He waited tables. And he got fired for short-changing customers and for stealing.", "start": 44.588, "end": 51.092, "spec": {"shot": "diner", "ui": "fired"}, "afx": null, "words": [["He", 0.108, 0.168], ["washed", 0.168, 0.541], ["dishes", 0.553, 1.094], ["He", 1.502, 1.574], ["waited", 1.575, 1.863], ["tables", 1.863, 2.464], ["And", 2.837, 2.909], ["he", 2.909, 2.993], ["got", 2.993, 3.173], ["fired", 3.173, 3.63], ["for", 3.642, 3.798], ["short-changing", 3.894, 4.579], ["customers", 4.579, 5.204], ["and", 5.397, 5.517], ["for", 5.517, 5.649], ["stealing", 5.661, 6.166]]}, {"text": "In 1907, he moved to Montreal and got a job at a small bank run by a man named Luigi Zarossi.", "start": 51.512, "end": 57.968, "spec": {"shot": "bank_ext", "ui": "montreal"}, "afx": null, "words": [["In 1907", 0.096, 1.094], ["he", 1.466, 1.526], ["moved", 1.526, 1.719], ["to", 1.719, 1.779], ["Montreal", 1.791, 2.476], ["and", 2.656, 2.728], ["got", 2.728, 2.921], ["a", 2.921, 2.957], ["job", 2.969, 3.353], ["at", 3.462, 3.51], ["a", 3.51, 3.546], ["small", 3.546, 3.894], ["bank", 3.894, 4.171], ["run", 4.171, 4.399], ["by", 4.411, 4.555], ["a", 4.555, 4.579], ["man", 4.579, 4.916], ["named", 4.916, 5.12], ["Luigi", 5.12, 5.469], ["Zarossi", 5.469, 6.094]]}, {"text": "The bank paid six percent interest on deposits, double the normal rate. Customers loved it.", "start": 58.388, "end": 63.812, "spec": {"shot": "bank_queue", "ui": "sixpct"}, "afx": null, "words": [["The", 0.096, 0.168], ["bank", 0.168, 0.457], ["paid", 0.457, 0.805], ["six", 0.817, 1.07], ["percent", 1.082, 1.526], ["interest", 1.611, 1.995], ["on", 1.995, 2.067], ["deposits", 2.067, 2.728], ["double", 2.885, 3.137], ["the", 3.137, 3.197], ["normal", 3.197, 3.546], ["rate", 3.558, 3.87], ["Customers", 4.255, 4.603], ["loved", 4.603, 4.88], ["it", 4.892, 5.06]]}, {"text": "But the interest wasn't coming from profits. It was paid with money from new deposits.", "start": 64.232, "end": 69.056, "spec": {"shot": "bank_flow", "ui": "flow1"}, "afx": null, "words": [["But", 0.096, 0.18], ["the", 0.18, 0.276], ["interest", 0.288, 0.781], ["wasn't", 0.793, 1.082], ["coming", 1.094, 1.298], ["from", 1.298, 1.43], ["profits", 1.43, 2.139], ["It", 2.536, 2.596], ["was", 2.596, 2.692], ["paid", 2.692, 2.909], ["with", 2.921, 3.053], ["money", 3.053, 3.449], ["from", 3.462, 3.63], ["new", 3.63, 3.762], ["deposits", 3.762, 4.459]]}, {"text": "The bank collapsed, and Zarossi fled to Mexico with a large part of the customers' money.", "start": 69.476, "end": 75.14, "spec": {"shot": "bank_crash", "mood": "dark", "ui": "mexico"}, "afx": null, "words": [["The", 0.096, 0.18], ["bank", 0.192, 0.517], ["collapsed", 0.529, 1.226], ["and", 1.671, 1.731], ["Zarossi", 1.731, 2.248], ["fled", 2.248, 2.5], ["to", 2.512, 2.584], ["Mexico", 2.596, 3.317], ["with", 3.558, 3.69], ["a", 3.69, 3.726], ["large", 3.726, 4.207], ["part", 4.207, 4.423], ["of", 4.423, 4.459], ["the", 4.471, 4.543], ["customers'", 4.543, 4.976], ["money", 4.988, 5.312]]}, {"text": "Ponzi was watching. And he took notes.", "start": 75.56, "end": 78.104, "spec": {"shot": "silhouette_close"}, "afx": null, "words": [["Ponzi", 0.096, 0.385], ["was", 0.385, 0.505], ["watching", 0.505, 0.949], ["And", 1.334, 1.382], ["he", 1.394, 1.478], ["took", 1.478, 1.647], ["notes", 1.647, 2.2]]}, {"text": "Soon after, he forged a check for four hundred and twenty-three dollars and fifty-eight cents, and went to prison in Canada.", "start": 78.524, "end": 85.292, "spec": {"shot": "prison", "ui": "check"}, "afx": null, "words": [["Soon", 0.096, 0.385], ["after", 0.385, 0.865], ["he", 1.226, 1.298], ["forged", 1.31, 1.611], ["a", 1.611, 1.659], ["check", 1.671, 1.947], ["for", 1.959, 2.103], ["four", 2.103, 2.416], ["hundred", 2.416, 2.608], ["and", 2.608, 2.644], ["twenty-three", 2.656, 3.161], ["dollars", 3.161, 3.618], ["and", 3.618, 3.714], ["fifty-eight", 3.726, 4.327], ["cents", 4.327, 4.82], ["and", 5.204, 5.325], ["went", 5.337, 5.469], ["to", 5.469, 5.529], ["prison", 5.541, 5.829], ["in", 5.829, 5.901], ["Canada", 5.901, 6.43]]}, {"text": "After that came a second prison term in Atlanta, for helping to smuggle immigrants into the United States.", "start": 85.712, "end": 91.736, "spec": {"shot": "prison2", "ui": "atlanta"}, "afx": null, "words": [["After", 0.096, 0.349], ["that", 0.349, 0.529], ["came", 0.529, 0.745], ["a", 0.757, 0.805], ["second", 0.805, 1.238], ["prison", 1.25, 1.575], ["term", 1.575, 1.863], ["in", 1.863, 1.935], ["Atlanta", 1.935, 2.62], ["for", 2.981, 3.125], ["helping", 3.125, 3.462], ["to", 3.462, 3.558], ["smuggle", 3.558, 4.038], ["immigrants", 4.051, 4.531], ["into", 4.543, 4.711], ["the", 4.712, 4.76], ["United", 4.76, 5.108], ["States", 5.108, 5.661]]}, {"text": "By 1919, Ponzi was back in Boston, with a small office on School Street.", "start": 92.156, "end": 97.22, "spec": {"shot": "office_ext", "cut": true, "mood": "calm", "ui": "ch2"}, "afx": null, "words": [["By 1919", 0.096, 1.034], ["Ponzi", 1.382, 1.815], ["was", 1.815, 1.971], ["back", 1.971, 2.224], ["in", 2.224, 2.284], ["Boston", 2.296, 2.837], ["with", 3.113, 3.233], ["a", 3.245, 3.281], ["small", 3.281, 3.594], ["office", 3.594, 3.954], ["on", 3.966, 4.074], ["School Street", 4.074, 4.7]]}, {"text": "One day, a letter arrived from Spain. Inside was something called an international reply coupon.", "start": 97.64, "end": 103.232, "spec": {"shot": "desk_letter", "ui": "letter"}, "afx": null, "words": [["One", 0.096, 0.252], ["day", 0.252, 0.577], ["a", 0.962, 1.022], ["letter", 1.022, 1.286], ["arrived", 1.298, 1.623], ["from", 1.623, 1.743], ["Spain", 1.743, 2.151], ["Inside", 2.548, 2.969], ["was", 2.969, 3.125], ["something", 3.125, 3.486], ["called", 3.498, 3.702], ["an", 3.702, 3.774], ["international", 3.786, 4.327], ["reply", 4.339, 4.724], ["coupon", 4.736, 5.24]]}, {"text": "The idea was simple. You buy a coupon in one country and mail it abroad, and the receiver trades it for a local stamp to send a reply.", "start": 103.652, "end": 111.716, "spec": {"shot": "desk_coupon", "ui": "irc_how"}, "afx": null, "words": [["The", 0.084, 0.144], ["idea", 0.144, 0.577], ["was", 0.577, 0.709], ["simple", 0.709, 1.19], ["You", 1.575, 1.671], ["buy", 1.671, 1.827], ["a", 1.827, 1.875], ["coupon", 1.875, 2.38], ["in", 2.392, 2.488], ["one", 2.488, 2.74], ["country", 2.74, 3.317], ["and", 3.389, 3.546], ["mail", 3.546, 3.786], ["it", 3.786, 3.834], ["abroad", 3.834, 4.279], ["and", 4.748, 4.82], ["the", 4.82, 4.892], ["receiver", 4.892, 5.349], ["trades", 5.349, 5.673], ["it", 5.685, 5.781], ["for", 5.793, 5.938], ["a", 5.938, 5.998], ["local", 6.01, 6.406], ["stamp", 6.418, 6.827], ["to", 6.839, 6.923], ["send", 6.923, 7.127], ["a", 7.127, 7.139], ["reply", 7.139, 7.716]]}, {"text": "But after the First World War, prices in Europe had exploded. In Italy, the coupons had become cheap.", "start": 112.136, "end": 118.448, "spec": {"shot": "map_europe", "ui": "inflation"}, "afx": null, "words": [["But", 0.12, 0.192], ["after", 0.192, 0.349], ["the", 0.349, 0.421], ["First", 0.421, 0.757], ["World", 0.769, 1.022], ["War", 1.034, 1.43], ["prices", 1.671, 2.079], ["in", 2.079, 2.187], ["Europe", 2.188, 2.452], ["had", 2.512, 2.656], ["exploded", 2.656, 3.281], ["In", 3.654, 3.738], ["Italy", 3.75, 4.171], ["the", 4.447, 4.567], ["coupons", 4.567, 5.12], ["had", 5.12, 5.204], ["become", 5.204, 5.517], ["cheap", 5.529, 5.949]]}, {"text": "Buy coupons cheap in Italy, trade them for more valuable stamps in America, and pocket the difference.", "start": 118.868, "end": 124.772, "spec": {"shot": "desk_arb", "ui": "arb"}, "afx": null, "words": [["Buy", 0.096, 0.204], ["coupons", 0.216, 0.697], ["cheap", 0.709, 0.998], ["in", 1.01, 1.082], ["Italy", 1.094, 1.514], ["trade", 1.779, 2.043], ["them", 2.055, 2.163], ["for", 2.175, 2.296], ["more", 2.308, 2.5], ["valuable", 2.5, 3.005], ["stamps", 3.005, 3.377], ["in", 3.389, 3.449], ["America", 3.45, 3.978], ["and", 4.363, 4.483], ["pocket", 4.495, 4.904], ["the", 4.904, 4.976], ["difference", 4.976, 5.553]]}, {"text": "On paper, this was legal. Ponzi claimed it could make a profit of over four hundred percent.", "start": 125.192, "end": 131.024, "spec": {"shot": "desk_arb2", "ui": "pct400"}, "afx": null, "words": [["On", 0.096, 0.216], ["paper", 0.228, 0.769], ["this", 0.986, 1.118], ["was", 1.118, 1.25], ["legal", 1.262, 1.731], ["Ponzi", 2.127, 2.524], ["claimed", 2.536, 2.861], ["it", 2.873, 2.957], ["could", 2.969, 3.101], ["make", 3.101, 3.257], ["a", 3.257, 3.305], ["profit", 3.305, 3.858], ["of", 4.002, 4.123], ["over", 4.123, 4.351], ["four", 4.363, 4.712], ["hundred", 4.712, 4.952], ["percent", 4.952, 5.481]]}, {"text": "But there was a catch. Each coupon traded for a stamp worth just a few cents. To make real money, you would need mountains of them.", "start": 131.444, "end": 139.004, "spec": {"shot": "coupon_mountain", "ui": "catch"}, "afx": null, "words": [["But", 0.096, 0.156], ["there", 0.168, 0.24], ["was", 0.24, 0.349], ["a", 0.349, 0.397], ["catch", 0.397, 0.938], ["Each", 1.322, 1.49], ["coupon", 1.49, 1.947], ["traded", 1.947, 2.284], ["for", 2.296, 2.416], ["a", 2.416, 2.464], ["stamp", 2.464, 2.861], ["worth", 2.873, 3.125], ["just", 3.137, 3.317], ["a", 3.317, 3.353], ["few", 3.365, 3.63], ["cents", 3.63, 4.195], ["To", 4.591, 4.663], ["make", 4.663, 4.904], ["real", 4.904, 5.252], ["money", 5.264, 5.649], ["you", 6.034, 6.094], ["would", 6.094, 6.19], ["need", 6.19, 6.454], ["mountains", 6.466, 6.899], ["of", 6.899, 6.983], ["them", 6.995, 7.212]]}, {"text": "Ponzi didn't care. He didn't need the stamps to work. He just needed people to believe they did.", "start": 139.424, "end": 144.656, "spec": {"shot": "silhouette_close2"}, "afx": null, "words": [["Ponzi", 0.096, 0.385], ["didn't", 0.385, 0.553], ["care", 0.565, 0.937], ["He", 1.334, 1.382], ["didn't", 1.394, 1.55], ["need", 1.55, 1.707], ["the", 1.707, 1.755], ["stamps", 1.767, 2.224], ["to", 2.236, 2.308], ["work", 2.308, 2.716], ["He", 3.113, 3.149], ["just", 3.149, 3.293], ["needed", 3.293, 3.546], ["people", 3.558, 3.858], ["to", 3.858, 3.942], ["believe", 3.942, 4.375], ["they", 4.387, 4.519], ["did", 4.519, 4.868]]}, {"text": "He founded the Securities Exchange Company, and made a simple promise: fifty percent profit in forty-five days, or double your money in ninety.", "start": 145.076, "end": 154.148, "spec": {"shot": "office_sign", "cut": true, "ui": "ch3"}, "afx": null, "words": [["He", 0.108, 0.18], ["founded", 0.18, 0.517], ["the", 0.517, 0.565], ["Securities", 0.577, 1.118], ["Exchange", 1.13, 1.562], ["Company", 1.575, 1.959], ["and", 2.32, 2.404], ["made", 2.404, 2.572], ["a", 2.572, 2.632], ["simple", 2.632, 3.137], ["promise", 3.149, 3.786], ["fifty", 4.135, 4.423], ["percent", 4.423, 4.784], ["profit", 4.796, 5.216], ["in", 5.216, 5.361], ["forty-five", 5.361, 6.058], ["days", 6.058, 6.562], ["or", 6.779, 6.911], ["double", 7.055, 7.332], ["your", 7.344, 7.476], ["money", 7.476, 7.885], ["in", 8.053, 8.197], ["ninety", 8.197, 8.726]]}, {"text": "His first investors were friends and neighbors. And to their surprise, they actually got paid.", "start": 154.568, "end": 159.752, "spec": {"shot": "first_inv", "ui": "paid"}, "afx": null, "words": [["His", 0.096, 0.192], ["first", 0.204, 0.445], ["investors", 0.445, 0.962], ["were", 0.974, 1.082], ["friends", 1.082, 1.562], ["and", 1.562, 1.659], ["neighbors", 1.659, 2.248], ["And", 2.62, 2.68], ["to", 2.692, 2.764], ["their", 2.776, 2.921], ["surprise", 2.933, 3.666], ["they", 3.846, 3.966], ["actually", 3.978, 4.243], ["got", 4.255, 4.459], ["paid", 4.459, 4.844]]}, {"text": "But that money wasn't coming from stamps. It came from the next investors.", "start": 160.172, "end": 164.396, "spec": {"shot": "flow2", "ui": "flow2"}, "afx": null, "words": [["But", 0.108, 0.204], ["that", 0.204, 0.397], ["money", 0.397, 0.733], ["wasn't", 0.733, 1.034], ["coming", 1.046, 1.274], ["from", 1.274, 1.406], ["stamps", 1.406, 2.079], ["It", 2.464, 2.536], ["came", 2.548, 2.752], ["from", 2.764, 2.861], ["the", 2.861, 2.909], ["next", 2.909, 3.197], ["investors", 3.197, 3.858]]}, {"text": "That's the whole trick. Old investors get paid with new investors' money. As long as more comes in than goes out, everything looks perfect.", "start": 164.816, "end": 172.592, "spec": {"shot": "pyr_1", "ui": "trick"}, "afx": null, "words": [["That's", 0.096, 0.228], ["the", 0.228, 0.288], ["whole", 0.288, 0.505], ["trick", 0.517, 0.913], ["Old", 1.31, 1.478], ["investors", 1.478, 2.043], ["get", 2.103, 2.272], ["paid", 2.272, 2.644], ["with", 2.656, 2.812], ["new", 2.812, 3.125], ["investors'", 3.125, 3.618], ["money", 3.618, 3.942], ["As", 4.339, 4.459], ["long", 4.459, 4.688], ["as", 4.688, 4.784], ["more", 4.784, 5.072], ["comes", 5.084, 5.337], ["in", 5.337, 5.385], ["than", 5.385, 5.493], ["goes", 5.493, 5.745], ["out", 5.745, 6.046], ["everything", 6.274, 6.671], ["looks", 6.671, 6.827], ["perfect", 6.839, 7.428]]}, {"text": "Imagine ten people put in a hundred dollars each. Forty-five days later, they want one hundred and fifty back. That's fifteen hundred dollars. So you need fifteen new people just to pay the first ten.", "start": 173.012, "end": 184.268, "spec": {"shot": "pyr_2", "ui": "example"}, "afx": null, "words": [["Imagine", 0.072, 0.529], ["ten", 0.529, 0.793], ["people", 0.793, 1.262], ["put", 1.358, 1.55], ["in", 1.55, 1.659], ["a", 1.659, 1.695], ["hundred", 1.695, 1.983], ["dollars", 1.983, 2.344], ["each", 2.356, 2.776], ["Forty-five", 3.221, 3.69], ["days", 3.69, 3.93], ["later", 3.93, 4.279], ["they", 4.483, 4.579], ["want", 4.579, 4.772], ["one", 4.772, 4.88], ["hundred", 4.88, 5.12], ["and", 5.12, 5.156], ["fifty", 5.168, 5.433], ["back", 5.433, 5.853], ["That's", 6.25, 6.418], ["fifteen", 6.43, 6.827], ["hundred", 6.839, 7.055], ["dollars", 7.067, 7.668], ["So", 8.065, 8.197], ["you", 8.197, 8.317], ["need", 8.317, 8.474], ["fifteen", 8.486, 8.918], ["new", 8.918, 9.135], ["people", 9.147, 9.615], ["just", 9.82, 9.988], ["to", 10.0, 10.06], ["pay", 10.06, 10.228], ["the", 10.228, 10.3], ["first", 10.312, 10.625], ["ten", 10.625, 10.913]]}, {"text": "And those fifteen will soon want their money too. Every round, the pyramid has to grow.", "start": 184.688, "end": 189.728, "spec": {"shot": "pyr_3", "ui": "grow"}, "afx": null, "words": [["And", 0.096, 0.168], ["those", 0.168, 0.373], ["fifteen", 0.385, 0.805], ["will", 0.817, 0.925], ["soon", 0.938, 1.298], ["want", 1.298, 1.442], ["their", 1.442, 1.538], ["money", 1.538, 1.755], ["too", 1.767, 2.175], ["Every", 2.56, 2.776], ["round", 2.776, 3.257], ["the", 3.486, 3.582], ["pyramid", 3.594, 4.002], ["has", 4.002, 4.207], ["to", 4.207, 4.279], ["grow", 4.279, 4.675]]}, {"text": "And the happy investors did his marketing for him. They told everyone they knew.", "start": 190.148, "end": 195.14, "spec": {"shot": "word_mouth"}, "afx": null, "words": [["And", 0.096, 0.168], ["the", 0.168, 0.228], ["happy", 0.228, 0.649], ["investors", 0.661, 1.322], ["did", 1.575, 1.791], ["his", 1.791, 1.923], ["marketing", 1.923, 2.464], ["for", 2.464, 2.68], ["him", 2.68, 2.897], ["They", 3.281, 3.329], ["told", 3.329, 3.57], ["everyone", 3.702, 4.074], ["they", 4.087, 4.207], ["knew", 4.219, 4.639]]}, {"text": "Wait! If you're enjoying this, hit subscribe. It's free. Unlike Ponzi's company.", "start": 195.56, "end": 200.24, "spec": {"shot": "sam_shout", "ui": "shout"}, "afx": "volume=4dB", "words": [["Wait", 0.082, 0.348], ["If", 0.676, 0.758], ["you're", 0.768, 0.84], ["enjoying", 0.84, 1.168], ["this", 1.168, 1.475], ["hit", 1.629, 1.732], ["subscribe", 1.732, 2.285], ["It's", 2.613, 2.695], ["free", 2.695, 3.023], ["Unlike", 3.35, 3.607], ["Ponzi's", 3.607, 4.006], ["company", 4.006, 4.375]]}, {"text": "By the summer of 1920, Boston had Ponzi fever. Crowds lined up outside his office on School Street.", "start": 200.66, "end": 206.996, "spec": {"shot": "street_crowd", "cut": true, "mood": "bright", "ui": "ch4"}, "afx": null, "words": [["By", 0.096, 0.18], ["the", 0.18, 0.252], ["summer", 0.264, 0.553], ["of", 0.565, 0.613], ["1920", 0.613, 1.418], ["Boston", 1.671, 2.127], ["had", 2.127, 2.308], ["Ponzi", 2.308, 2.764], ["fever", 2.764, 3.365], ["Crowds", 3.726, 4.014], ["lined", 4.014, 4.255], ["up", 4.255, 4.339], ["outside", 4.339, 4.844], ["his", 4.844, 4.952], ["office", 4.952, 5.288], ["on", 5.301, 5.409], ["School Street", 5.409, 5.998]]}, {"text": "At his peak, he was taking in up to two hundred and fifty thousand dollars a day.", "start": 207.416, "end": 211.52, "spec": {"shot": "money_room", "ui": "perday2"}, "afx": null, "words": [["At", 0.096, 0.168], ["his", 0.168, 0.337], ["peak", 0.337, 0.829], ["he", 1.082, 1.142], ["was", 1.142, 1.262], ["taking", 1.262, 1.514], ["in", 1.514, 1.587], ["up", 1.587, 1.707], ["to", 1.707, 1.851], ["two", 1.863, 2.103], ["hundred", 2.103, 2.284], ["and", 2.284, 2.332], ["fifty", 2.344, 2.68], ["thousand", 2.68, 3.065], ["dollars", 3.065, 3.329], ["a", 3.329, 3.365], ["day", 3.377, 3.75]]}, {"text": "He bought a mansion in Lexington, and brought his mother over from Italy, first class.", "start": 211.94, "end": 217.124, "spec": {"shot": "mansion", "ui": "mansion"}, "afx": null, "words": [["He", 0.108, 0.156], ["bought", 0.156, 0.312], ["a", 0.312, 0.337], ["mansion", 0.337, 0.769], ["in", 0.769, 0.865], ["Lexington", 0.865, 1.478], ["and", 1.923, 1.995], ["brought", 2.007, 2.236], ["his", 2.236, 2.344], ["mother", 2.344, 2.74], ["over", 2.752, 2.921], ["from", 2.933, 3.089], ["Italy", 3.209, 3.606], ["first", 3.846, 4.171], ["class", 4.183, 4.844]]}, {"text": "He even bought a controlling stake in the Hanover Trust bank. The same bank whose manager had refused to lend him money.", "start": 217.544, "end": 224.096, "spec": {"shot": "hanover", "ui": "hanover"}, "afx": null, "words": [["He", 0.096, 0.144], ["even", 0.156, 0.337], ["bought", 0.337, 0.577], ["a", 0.577, 0.613], ["controlling", 0.613, 1.178], ["stake", 1.19, 1.599], ["in", 1.695, 1.779], ["the", 1.779, 1.839], ["Hanover", 1.851, 2.32], ["Trust", 2.332, 2.68], ["bank", 2.68, 3.065], ["The", 3.438, 3.498], ["same", 3.51, 3.786], ["bank", 3.786, 4.219], ["whose", 4.231, 4.423], ["manager", 4.423, 4.88], ["had", 4.88, 5.012], ["refused", 5.012, 5.553], ["to", 5.553, 5.613], ["lend", 5.613, 5.793], ["him", 5.793, 5.877], ["money", 5.877, 6.214]]}, {"text": "The man who arrived with two dollars and fifty cents was now living like a millionaire.", "start": 224.516, "end": 229.316, "spec": {"shot": "mansion_night", "ui": "rich"}, "afx": null, "words": [["The", 0.096, 0.144], ["man", 0.144, 0.361], ["who", 0.361, 0.445], ["arrived", 0.445, 0.937], ["with", 0.938, 1.094], ["two", 1.106, 1.37], ["dollars", 1.37, 1.779], ["and", 1.779, 1.839], ["fifty", 1.839, 2.163], ["cents", 2.163, 2.632], ["was", 2.728, 2.885], ["now", 2.897, 3.197], ["living", 3.197, 3.498], ["like", 3.498, 3.642], ["a", 3.642, 3.678], ["millionaire", 3.69, 4.447]]}, {"text": "But one newspaper started asking questions. On July 24th, 1920, the Boston Post put Ponzi on its front page.", "start": 229.736, "end": 237.632, "spec": {"shot": "newspaper", "cut": true, "mood": "dark", "ui": "ch5"}, "afx": null, "words": [["But", 0.108, 0.216], ["one", 0.228, 0.529], ["newspaper", 0.529, 1.07], ["started", 1.082, 1.37], ["asking", 1.37, 1.683], ["questions", 1.695, 2.368], ["On", 2.764, 2.849], ["July 24th, 1920", 2.861, 4.928], ["the", 5.12, 5.216], ["Boston", 5.216, 5.565], ["Post", 5.565, 5.901], ["put", 5.913, 6.13], ["Ponzi", 6.13, 6.647], ["on", 6.647, 6.731], ["its", 6.731, 6.827], ["front", 6.839, 7.079], ["page", 7.079, 7.548]]}, {"text": "The Post brought in Clarence Barron, a famous financial journalist. And he did some simple math.", "start": 238.052, "end": 243.716, "spec": {"shot": "math_desk", "ui": "barron"}, "afx": null, "words": [["The", 0.108, 0.168], ["Post", 0.168, 0.481], ["brought", 0.493, 0.781], ["in", 0.781, 0.901], ["Clarence", 0.913, 1.406], ["Barron", 1.406, 1.755], ["a", 2.115, 2.151], ["famous", 2.151, 2.584], ["financial", 2.584, 3.005], ["journalist", 3.005, 3.618], ["And", 4.002, 4.05], ["he", 4.051, 4.147], ["did", 4.159, 4.291], ["some", 4.291, 4.435], ["simple", 4.435, 4.832], ["math", 4.832, 5.325]]}, {"text": "To cover all the money people had invested, Ponzi would need around one hundred and sixty million reply coupons.", "start": 244.136, "end": 250.544, "spec": {"shot": "coupon_math", "ui": "c160m"}, "afx": null, "words": [["To", 0.096, 0.168], ["cover", 0.168, 0.565], ["all", 0.673, 0.889], ["the", 0.889, 0.949], ["money", 0.95, 1.214], ["people", 1.214, 1.538], ["had", 1.538, 1.683], ["invested", 1.695, 2.212], ["Ponzi", 2.584, 2.981], ["would", 2.981, 3.113], ["need", 3.125, 3.269], ["around", 3.269, 3.57], ["one", 3.57, 3.654], ["hundred", 3.654, 3.966], ["and", 3.966, 4.014], ["sixty", 4.014, 4.447], ["million", 4.447, 4.868], ["reply", 4.88, 5.264], ["coupons", 5.276, 6.046]]}, {"text": "But only about twenty-seven thousand were actually in circulation.", "start": 250.964, "end": 254.54, "spec": {"shot": "coupon_math2", "ui": "c27k"}, "afx": null, "words": [["But", 0.108, 0.192], ["only", 0.192, 0.481], ["about", 0.493, 0.757], ["twenty-seven", 0.769, 1.346], ["thousand", 1.346, 1.851], ["were", 1.851, 2.019], ["actually", 2.019, 2.44], ["in", 2.44, 2.524], ["circulation", 2.524, 3.233]]}, {"text": "Investors panicked and rushed to get their money back. Ponzi paid out two million dollars in just three days.", "start": 254.96, "end": 261.44, "spec": {"shot": "bank_run", "ui": "run2m"}, "afx": null, "words": [["Investors", 0.084, 0.553], ["panicked", 0.553, 1.058], ["and", 1.25, 1.442], ["rushed", 1.442, 1.719], ["to", 1.719, 1.791], ["get", 1.803, 1.935], ["their", 1.935, 2.031], ["money", 2.043, 2.236], ["back", 2.248, 2.668], ["Ponzi", 3.065, 3.413], ["paid", 3.413, 3.654], ["out", 3.654, 3.822], ["two", 3.834, 4.099], ["million", 4.099, 4.447], ["dollars", 4.447, 4.856], ["in", 4.856, 5.024], ["just", 5.036, 5.312], ["three", 5.312, 5.649], ["days", 5.649, 6.142]]}, {"text": "On August 2nd, his own former publicist, William McMasters, went public. Ponzi was deep in debt, robbing Peter to pay Paul.", "start": 261.86, "end": 270.908, "spec": {"shot": "newspaper2", "ui": "mcmasters"}, "afx": null, "words": [["On", 0.084, 0.204], ["August 2nd", 0.216, 1.106], ["his", 1.454, 1.623], ["own", 1.635, 1.827], ["former", 1.827, 2.127], ["publicist", 2.127, 2.776], ["William", 3.017, 3.341], ["McMasters", 3.341, 4.147], ["went", 4.351, 4.555], ["public", 4.567, 5.048], ["Ponzi", 5.445, 5.793], ["was", 5.793, 6.022], ["deep", 6.118, 6.334], ["in", 6.334, 6.442], ["debt", 6.442, 6.779], ["robbing", 7.26, 7.596], ["Peter", 7.596, 7.993], ["to", 7.993, 8.077], ["pay", 8.089, 8.293], ["Paul", 8.293, 8.69]]}, {"text": "On August 11th, the Post revealed his old forgery conviction from Montreal.", "start": 271.328, "end": 276.56, "spec": {"shot": "newspaper3", "ui": "forgery"}, "afx": null, "words": [["On", 0.084, 0.228], ["August 11th", 0.24, 1.094], ["the", 1.334, 1.418], ["Post", 1.43, 1.767], ["revealed", 1.779, 2.199], ["his", 2.2, 2.476], ["old", 2.488, 2.752], ["forgery", 2.752, 3.365], ["conviction", 3.365, 3.918], ["from", 4.135, 4.279], ["Montreal", 4.279, 4.88]]}, {"text": "The next day, Charles Ponzi turned himself in to federal authorities.", "start": 276.98, "end": 282.116, "spec": {"shot": "arrest", "ui": "aug12"}, "afx": null, "words": [["The", 0.096, 0.144], ["next", 0.156, 0.385], ["day", 0.385, 0.769], ["Charles", 1.01, 1.334], ["Ponzi", 1.334, 1.995], ["turned", 2.163, 2.416], ["himself", 2.416, 2.957], ["in", 3.269, 3.534], ["to", 3.654, 3.738], ["federal", 3.738, 4.087], ["authorities", 4.099, 4.796]]}, {"text": "Auditors found that his company owed millions of dollars more than it had.", "start": 282.536, "end": 286.928, "spec": {"shot": "audit", "ui": "audit"}, "afx": null, "words": [["Auditors", 0.096, 0.505], ["found", 0.505, 0.901], ["that", 0.901, 0.986], ["his", 0.986, 1.118], ["company", 1.118, 1.611], ["owed", 1.623, 1.863], ["millions", 1.875, 2.536], ["of", 2.536, 2.596], ["dollars", 2.596, 3.089], ["more", 3.101, 3.474], ["than", 3.486, 3.594], ["it", 3.606, 3.666], ["had", 3.666, 4.038]]}, {"text": "Investors lost about twenty million dollars. Many got back less than thirty cents for every dollar.", "start": 287.348, "end": 293.612, "spec": {"shot": "pyr_crash", "cut": true, "ui": "ch6"}, "afx": null, "words": [["Investors", 0.096, 0.565], ["lost", 0.565, 0.986], ["about", 0.986, 1.25], ["twenty", 1.262, 1.55], ["million", 1.562, 1.875], ["dollars", 1.875, 2.476], ["Many", 2.861, 3.005], ["got", 3.005, 3.209], ["back", 3.209, 3.558], ["less", 3.57, 3.798], ["than", 3.798, 3.978], ["thirty", 3.99, 4.327], ["cents", 4.327, 4.796], ["for", 4.808, 5.048], ["every", 5.24, 5.457], ["dollar", 5.469, 5.913]]}, {"text": "The state seized his bank, Hanover Trust.", "start": 294.032, "end": 296.792, "spec": {"shot": "hanover_closed", "ui": "seized"}, "afx": null, "words": [["The", 0.084, 0.132], ["state", 0.144, 0.421], ["seized", 0.421, 0.829], ["his", 0.829, 0.962], ["bank", 0.962, 1.406], ["Hanover", 1.575, 1.887], ["Trust", 1.887, 2.416]]}, {"text": "Ponzi faced eighty-six counts of mail fraud. He pleaded guilty to one, and went to federal prison.", "start": 297.212, "end": 303.86, "spec": {"shot": "prison", "ui": "counts"}, "afx": null, "words": [["Ponzi", 0.096, 0.433], ["faced", 0.433, 0.817], ["eighty-six", 0.938, 1.418], ["counts", 1.418, 1.755], ["of", 1.767, 1.815], ["mail", 1.815, 2.067], ["fraud", 2.067, 2.524], ["He", 2.909, 2.969], ["pleaded", 2.969, 3.425], ["guilty", 3.534, 4.123], ["to", 4.255, 4.411], ["one", 4.411, 4.832], ["and", 5.24, 5.337], ["went", 5.337, 5.481], ["to", 5.481, 5.529], ["federal", 5.541, 5.877], ["prison", 5.877, 6.322]]}, {"text": "After about three and a half years, he was out. But Massachusetts put him on trial again.", "start": 304.28, "end": 309.56, "spec": {"shot": "court", "ui": "state"}, "afx": null, "words": [["After", 0.096, 0.337], ["about", 0.337, 0.565], ["three", 0.577, 0.829], ["and", 0.829, 0.889], ["a", 0.901, 0.925], ["half", 0.925, 1.214], ["years", 1.214, 1.671], ["he", 1.719, 1.803], ["was", 1.803, 1.971], ["out", 1.971, 2.272], ["But", 2.668, 2.752], ["Massachusetts", 2.764, 3.774], ["put", 3.906, 4.075], ["him", 4.074, 4.147], ["on", 4.147, 4.255], ["trial", 4.255, 4.603], ["again", 4.603, 4.94]]}, {"text": "Out on bail, he went to Florida and started selling swampland, promising two hundred percent in sixty days.", "start": 309.98, "end": 316.868, "spec": {"shot": "swamp", "ui": "florida"}, "afx": null, "words": [["Out", 0.096, 0.204], ["on", 0.204, 0.349], ["bail", 0.349, 0.805], ["he", 1.046, 1.118], ["went", 1.118, 1.238], ["to", 1.238, 1.286], ["Florida", 1.286, 1.923], ["and", 2.115, 2.284], ["started", 2.296, 2.704], ["selling", 2.716, 3.065], ["swampland", 3.065, 3.798], ["promising", 4.051, 4.543], ["two", 4.543, 4.748], ["hundred", 4.76, 4.94], ["percent", 4.94, 5.433], ["in", 5.637, 5.721], ["sixty", 5.721, 6.07], ["days", 6.07, 6.538]]}, {"text": "He was caught again, and spent years more behind bars.", "start": 317.288, "end": 320.576, "spec": {"shot": "prison2", "ui": "again"}, "afx": null, "words": [["He", 0.108, 0.156], ["was", 0.156, 0.276], ["caught", 0.276, 0.505], ["again", 0.505, 0.829], ["and", 1.202, 1.25], ["spent", 1.25, 1.514], ["years", 1.514, 1.959], ["more", 1.971, 2.139], ["behind", 2.139, 2.452], ["bars", 2.452, 2.921]]}, {"text": "In 1934, he was deported to Italy. Later, he moved to Brazil.", "start": 320.996, "end": 326.108, "spec": {"shot": "map_brazil", "ui": "deport"}, "afx": null, "words": [["In 1934", 0.084, 1.298], ["he", 1.731, 1.779], ["was", 1.779, 1.899], ["deported", 1.899, 2.344], ["to", 2.344, 2.44], ["Italy", 2.452, 2.885], ["Later", 3.257, 3.594], ["he", 4.026, 4.087], ["moved", 4.099, 4.291], ["to", 4.291, 4.339], ["Brazil", 4.339, 4.784]]}, {"text": "In 1949, Charles Ponzi died in a charity hospital in Rio de Janeiro. He left behind about seventy-five dollars.", "start": 326.528, "end": 334.616, "spec": {"shot": "rio", "mood": "calm", "ui": "dollars75"}, "afx": null, "words": [["In 1949", 0.096, 1.178], ["Charles", 1.442, 1.767], ["Ponzi", 1.767, 2.296], ["died", 2.308, 2.716], ["in", 2.716, 2.837], ["a", 2.849, 2.885], ["charity", 2.885, 3.269], ["hospital", 3.281, 3.846], ["in", 3.954, 4.135], ["Rio", 4.135, 4.435], ["de", 4.447, 4.567], ["Janeiro", 4.579, 5.144], ["He", 5.517, 5.565], ["left", 5.565, 5.757], ["behind", 5.769, 6.202], ["about", 6.202, 6.43], ["seventy-five", 6.442, 7.139], ["dollars", 7.151, 7.74]]}, {"text": "And the Boston Post? It won the Pulitzer Prize for exposing him.", "start": 335.036, "end": 339.188, "spec": {"shot": "newspaper_prize", "ui": "pulitzer"}, "afx": null, "words": [["And", 0.084, 0.144], ["the", 0.144, 0.216], ["Boston", 0.216, 0.637], ["Post", 0.637, 1.178], ["It", 1.562, 1.635], ["won", 1.647, 1.767], ["the", 1.779, 1.863], ["Pulitzer", 1.863, 2.272], ["Prize", 2.272, 2.764], ["for", 2.909, 3.065], ["exposing", 3.077, 3.558], ["him", 3.57, 3.798]]}, {"text": "A hundred years later, the trick still works. In 2009, Bernie Madoff pleaded guilty to a Ponzi scheme worth about sixty-five billion dollars.", "start": 339.608, "end": 349.112, "spec": {"shot": "pyr_big", "cut": true, "ui": "madoff"}, "afx": null, "words": [["A", 0.096, 0.144], ["hundred", 0.156, 0.445], ["years", 0.445, 0.661], ["later", 0.661, 1.034], ["the", 1.394, 1.466], ["trick", 1.466, 1.743], ["still", 1.743, 2.067], ["works", 2.079, 2.572], ["In 2009", 2.945, 3.882], ["Bernie", 4.111, 4.387], ["Madoff", 4.387, 4.844], ["pleaded", 4.856, 5.228], ["guilty", 5.24, 5.709], ["to", 5.889, 6.022], ["a", 6.022, 6.106], ["Ponzi", 6.106, 6.562], ["scheme", 6.562, 6.863], ["worth", 6.863, 7.164], ["about", 7.224, 7.488], ["sixty-five", 7.5, 8.293], ["billion", 8.305, 8.558], ["dollars", 8.558, 9.135]]}, {"text": "So here is how to spot one.", "start": 349.532, "end": 351.404, "spec": {"shot": "sam_studio", "ui": "spot"}, "afx": null, "words": [["So", 0.096, 0.216], ["here", 0.228, 0.361], ["is", 0.361, 0.433], ["how", 0.433, 0.517], ["to", 0.517, 0.565], ["spot", 0.577, 0.853], ["one", 0.853, 1.082]]}, {"text": "One: high returns that are almost guaranteed.", "start": 351.824, "end": 354.728, "spec": {"shot": "sam_studio", "ui": "spot1"}, "afx": null, "words": [["One", 0.108, 0.409], ["high", 0.829, 0.937], ["returns", 0.95, 1.418], ["that", 1.418, 1.526], ["are", 1.526, 1.635], ["almost", 1.647, 1.971], ["guaranteed", 1.983, 2.56]]}, {"text": "Two: a secret strategy that nobody can really explain.", "start": 355.148, "end": 359.3, "spec": {"shot": "sam_studio", "ui": "spot2"}, "afx": null, "words": [["Two", 0.096, 0.433], ["a", 0.853, 0.901], ["secret", 0.901, 1.334], ["strategy", 1.346, 1.983], ["that", 1.995, 2.224], ["nobody", 2.224, 2.752], ["can", 2.764, 2.993], ["really", 2.993, 3.257], ["explain", 3.257, 3.81]]}, {"text": "Three: you get paid with money from people who join after you.", "start": 359.72, "end": 363.032, "spec": {"shot": "sam_studio", "ui": "spot3"}, "afx": null, "words": [["Three", 0.12, 0.385], ["you", 0.745, 0.805], ["get", 0.817, 0.949], ["paid", 0.95, 1.13], ["with", 1.13, 1.238], ["money", 1.238, 1.55], ["from", 1.55, 1.695], ["people", 1.707, 2.055], ["who", 2.055, 2.127], ["join", 2.139, 2.464], ["after", 2.476, 2.764], ["you", 2.764, 2.957]]}, {"text": "Because in a Ponzi scheme, the last people in always pay for the first.", "start": 363.452, "end": 367.7, "spec": {"shot": "pyr_end"}, "afx": null, "words": [["Because", 0.096, 0.349], ["in", 0.349, 0.421], ["a", 0.421, 0.481], ["Ponzi", 0.481, 0.95], ["scheme", 0.95, 1.418], ["the", 1.611, 1.707], ["last", 1.707, 2.019], ["people", 2.019, 2.308], ["in", 2.32, 2.404], ["always", 2.416, 2.861], ["pay", 2.861, 3.137], ["for", 3.149, 3.245], ["the", 3.245, 3.305], ["first", 3.317, 3.882]]}, {"text": "Subscribe to Roundhead Stories for more money stories like this one.", "start": 368.12, "end": 372.368, "spec": {"shot": "sam_end", "mood": "bright", "ui": "end"}, "afx": null, "words": [["Subscribe", 0.096, 0.637], ["to", 0.637, 0.733], ["Roundhead", 0.733, 1.25], ["Stories", 1.25, 1.767], ["for", 1.959, 2.127], ["more", 2.127, 2.524], ["money", 2.536, 2.897], ["stories", 2.909, 3.305], ["like", 3.305, 3.45], ["this", 3.462, 3.63], ["one", 3.63, 3.882]]}], "dur": 375.37}