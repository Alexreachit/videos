{"lines": [{"text": "Why you should never buy something that's too good to be true. A man once bought the Eiffel Tower.", "start": 0.05, "end": 4.466, "spec": {"type": "hero"}, "words": [["Why", 0.086, 0.183], ["you", 0.183, 0.248], ["should", 0.259, 0.409], ["never", 0.409, 0.668], ["buy", 0.668, 0.765], ["something", 0.776, 1.131], ["that's", 1.131, 1.293], ["too", 1.293, 1.562], ["good", 1.573, 1.778], ["to", 1.778, 1.821], ["be", 1.821, 1.918], ["true", 1.918, 2.317], ["A", 2.662, 2.694], ["man", 2.705, 2.92], ["once", 2.931, 3.103], ["bought", 3.114, 3.319], ["the", 3.33, 3.416], ["Eiffel", 3.427, 3.707], ["Tower", 3.707, 4.095]]}, {"text": "In nineteen twenty-five, con man Victor Lustig posed as a French government official.", "start": 4.546, "end": 9.442, "spec": {"type": "map"}, "words": [["In", 0.075, 0.14], ["nineteen", 0.151, 0.453], ["twenty-five", 0.453, 1.088], ["con", 1.412, 1.606], ["man", 1.606, 1.832], ["Victor", 1.843, 2.177], ["Lustig", 2.177, 2.651], ["posed", 2.651, 3.233], ["as", 3.308, 3.416], ["a", 3.416, 3.448], ["French", 3.448, 3.793], ["government", 3.793, 4.062], ["official", 4.062, 4.569]]}, {"text": "He told scrap dealers the tower would be torn down for its seven thousand tons of iron.", "start": 9.522, "end": 14.13, "spec": {"type": "iron"}, "words": [["He", 0.097, 0.162], ["told", 0.162, 0.388], ["scrap", 0.388, 0.797], ["dealers", 0.873, 1.175], ["the", 1.175, 1.239], ["tower", 1.25, 1.616], ["would", 1.627, 1.735], ["be", 1.735, 1.853], ["torn", 1.853, 2.155], ["down", 2.155, 2.532], ["for", 2.532, 2.672], ["its", 2.672, 2.823], ["seven", 2.834, 3.2], ["thousand", 3.2, 3.642], ["tons", 3.653, 3.933], ["of", 3.933, 3.987], ["iron", 3.987, 4.278]]}, {"text": "One dealer paid him, plus a secret bribe.", "start": 14.21, "end": 16.658, "spec": {"type": "bribe"}, "words": [["One", 0.086, 0.259], ["dealer", 0.259, 0.485], ["paid", 0.485, 0.7], ["him", 0.7, 0.884], ["plus", 1.099, 1.315], ["a", 1.315, 1.358], ["secret", 1.369, 1.756], ["bribe", 1.756, 2.112]]}, {"text": "Then Lustig vanished with the money.", "start": 16.738, "end": 18.658, "spec": {"type": "vanish", "cut": true}, "words": [["Then", 0.086, 0.259], ["Lustig", 0.259, 0.625], ["vanished", 0.625, 1.121], ["with", 1.131, 1.207], ["the", 1.207, 1.261], ["money", 1.261, 1.584]]}, {"text": "The buyer was too embarrassed to call the police, so Lustig came back to try again.", "start": 18.738, "end": 22.842, "spec": {"type": "shame"}, "words": [["The", 0.097, 0.151], ["buyer", 0.151, 0.42], ["was", 0.42, 0.539], ["too", 0.539, 0.7], ["embarrassed", 0.7, 1.121], ["to", 1.131, 1.185], ["call", 1.196, 1.379], ["the", 1.379, 1.444], ["police", 1.455, 1.897], ["so", 2.231, 2.349], ["Lustig", 2.36, 2.759], ["came", 2.769, 2.963], ["back", 2.963, 3.222], ["to", 3.222, 3.276], ["try", 3.276, 3.502], ["again", 3.502, 3.782]]}, {"text": "Would you have fallen for it?", "start": 22.922, "end": 24.794, "spec": {"type": "hero", "choice": true}, "words": [["Would", 0.086, 0.162], ["you", 0.162, 0.215], ["have", 0.226, 0.345], ["fallen", 0.345, 0.636], ["for", 0.647, 0.808], ["it", 0.808, 0.905]]}], "dur": 24.89}