{"lines": [{"text": "Why you should never buy something that's too good to be true. A man once bought the Eiffel Tower.", "start": 0.05, "end": 4.466, "spec": {"type": "hero"}, "words": [["Why", 0.086, 0.183], ["you", 0.183, 0.248], ["should", 0.259, 0.409], ["never", 0.409, 0.668], ["buy", 0.668, 0.765], ["something", 0.776, 1.131], ["that's", 1.131, 1.293], ["too", 1.293, 1.562], ["good", 1.573, 1.778], ["to", 1.778, 1.821], ["be", 1.821, 1.918], ["true", 1.918, 2.317], ["A", 2.662, 2.694], ["man", 2.705, 2.92], ["once", 2.931, 3.103], ["bought", 3.114, 3.319], ["the", 3.33, 3.416], ["Eiffel", 3.427, 3.707], ["Tower", 3.707, 4.095]]}, {"text": "In nineteen twenty-five, con man Victor Lustig posed as a French government official.", "start": 4.546, "end": 9.442, "spec": {"type": "official"}, "words": [["In", 0.075, 0.14], ["nineteen", 0.151, 0.453], ["twenty-five", 0.453, 1.088], ["con", 1.412, 1.606], ["man", 1.606, 1.832], ["Victor", 1.843, 2.177], ["Lustig", 2.177, 2.651], ["posed", 2.651, 3.233], ["as", 3.308, 3.416], ["a", 3.416, 3.448], ["French", 3.448, 3.793], ["government", 3.793, 4.062], ["official", 4.062, 4.569]]}, {"text": "He told scrap dealers the tower would be torn down for its seven thousand tons of iron.", "start": 9.522, "end": 14.202, "spec": {"type": "iron"}, "words": [["He", 0.086, 0.14], ["told", 0.14, 0.356], ["scrap", 0.366, 0.765], ["dealers", 0.862, 1.153], ["the", 1.153, 1.218], ["tower", 1.228, 1.616], ["would", 1.703, 1.81], ["be", 1.81, 1.94], ["torn", 1.94, 2.274], ["down", 2.274, 2.651], ["for", 2.662, 2.791], ["its", 2.791, 2.92], ["seven", 2.931, 3.308], ["thousand", 3.319, 3.75], ["tons", 3.75, 4.019], ["of", 4.019, 4.073], ["iron", 4.073, 4.364]]}, {"text": "One dealer paid him, plus a secret bribe.", "start": 14.282, "end": 16.634, "spec": {"type": "bribe"}, "words": [["One", 0.086, 0.215], ["dealer", 0.215, 0.42], ["paid", 0.42, 0.636], ["him", 0.636, 0.841], ["plus", 1.056, 1.272], ["a", 1.272, 1.315], ["secret", 1.315, 1.703], ["bribe", 1.703, 2.037]]}, {"text": "Then Lustig vanished with the money.", "start": 16.714, "end": 18.778, "spec": {"type": "vanish", "cut": true}, "words": [["Then", 0.086, 0.269], ["Lustig", 0.28, 0.679], ["vanished", 0.679, 1.218], ["with", 1.228, 1.315], ["the", 1.315, 1.379], ["money", 1.39, 1.724]]}, {"text": "The buyer was too embarrassed to call the police, so Lustig came back to try again.", "start": 18.858, "end": 23.106, "spec": {"type": "shame"}, "words": [["The", 0.097, 0.14], ["buyer", 0.151, 0.442], ["was", 0.442, 0.55], ["too", 0.55, 0.744], ["embarrassed", 0.744, 1.207], ["to", 1.207, 1.261], ["call", 1.261, 1.444], ["the", 1.444, 1.509], ["police", 1.509, 1.983], ["so", 2.317, 2.446], ["Lustig", 2.446, 2.866], ["came", 2.866, 3.05], ["back", 3.05, 3.33], ["to", 3.33, 3.384], ["try", 3.384, 3.621], ["again", 3.621, 3.922]]}, {"text": "Would you have fallen for it?", "start": 23.186, "end": 25.058, "spec": {"type": "hero", "choice": true}, "words": [["Would", 0.086, 0.162], ["you", 0.162, 0.226], ["have", 0.226, 0.334], ["fallen", 0.345, 0.636], ["for", 0.647, 0.808], ["it", 0.808, 0.916]]}], "dur": 25.16}