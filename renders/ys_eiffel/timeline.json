{"lines": [{"text": "Why you should never buy something that's too good to be true. A man once bought the Eiffel Tower.", "start": 0.05, "end": 4.466, "spec": {"type": "hero"}, "words": [["Why", 0.086, 0.183], ["you", 0.183, 0.248], ["should", 0.259, 0.409], ["never", 0.409, 0.668], ["buy", 0.668, 0.765], ["something", 0.776, 1.131], ["that's", 1.131, 1.293], ["too", 1.293, 1.562], ["good", 1.573, 1.778], ["to", 1.778, 1.821], ["be", 1.821, 1.918], ["true", 1.918, 2.317], ["A", 2.662, 2.694], ["man", 2.705, 2.92], ["once", 2.931, 3.103], ["bought", 3.114, 3.319], ["the", 3.33, 3.416], ["Eiffel", 3.427, 3.707], ["Tower", 3.707, 4.095]]}, {"text": "In nineteen twenty-five, con man Victor Lustig posed as a French government official.", "start": 4.546, "end": 9.442, "spec": {"type": "map"}, "words": [["In", 0.075, 0.14], ["nineteen", 0.151, 0.453], ["twenty-five", 0.453, 1.088], ["con", 1.412, 1.606], ["man", 1.606, 1.832], ["Victor", 1.843, 2.177], ["Lustig", 2.177, 2.651], ["posed", 2.651, 3.233], ["as", 3.308, 3.416], ["a", 3.416, 3.448], ["French", 3.448, 3.793], ["government", 3.793, 4.062], ["official", 4.062, 4.569]]}, {"text": "He told scrap dealers the tower would be torn down for its seven thousand tons of iron.", "start": 9.522, "end": 14.13, "spec": {"type": "iron"}, "words": [["He", 0.086, 0.14], ["told", 0.151, 0.377], ["scrap", 0.388, 0.787], ["dealers", 0.841, 1.153], ["the", 1.153, 1.218], ["tower", 1.228, 1.616], ["would", 1.713, 1.832], ["be", 1.832, 1.95], ["torn", 1.95, 2.274], ["down", 2.274, 2.651], ["for", 2.651, 2.78], ["its", 2.78, 2.909], ["seven", 2.92, 3.254], ["thousand", 3.254, 3.685], ["tons", 3.685, 3.944], ["of", 3.944, 4.009], ["iron", 4.009, 4.3]]}, {"text": "One dealer paid him, plus a secret bribe.", "start": 14.21, "end": 16.61, "spec": {"type": "bribe"}, "words": [["One", 0.086, 0.215], ["dealer", 0.215, 0.431], ["paid", 0.442, 0.657], ["him", 0.657, 0.851], ["plus", 1.056, 1.261], ["a", 1.261, 1.304], ["secret", 1.304, 1.713], ["bribe", 1.713, 2.069]]}, {"text": "Then Lustig vanished with the money.", "start": 16.69, "end": 18.634, "spec": {"type": "vanish", "cut": true}, "words": [["Then", 0.086, 0.259], ["Lustig", 0.269, 0.625], ["vanished", 0.625, 1.121], ["with", 1.121, 1.207], ["the", 1.207, 1.272], ["money", 1.282, 1.606]]}, {"text": "The buyer was too embarrassed to call the police, so Lustig came back to try again.", "start": 18.714, "end": 22.842, "spec": {"type": "shame"}, "words": [["The", 0.097, 0.151], ["buyer", 0.162, 0.453], ["was", 0.453, 0.56], ["too", 0.56, 0.711], ["embarrassed", 0.711, 1.131], ["to", 1.131, 1.175], ["call", 1.175, 1.369], ["the", 1.369, 1.433], ["police", 1.433, 1.907], ["so", 2.241, 2.381], ["Lustig", 2.381, 2.769], ["came", 2.769, 2.953], ["back", 2.963, 3.254], ["to", 3.254, 3.308], ["try", 3.308, 3.534], ["again", 3.534, 3.804]]}, {"text": "Would you have fallen for it?", "start": 22.922, "end": 24.794, "spec": {"type": "hero", "choice": true}, "words": [["Would", 0.086, 0.162], ["you", 0.162, 0.215], ["have", 0.215, 0.312], ["fallen", 0.312, 0.603], ["for", 0.603, 0.765], ["it", 0.776, 0.884]]}], "dur": 24.89}