{"lines": [{"text": "Why the FBI never found this man.", "start": 0.05, "end": 1.922, "spec": {"type": "hero"}, "afx": null, "words": [["Why", 0.086, 0.205], ["the", 0.215, 0.28], ["FBI", 0.28, 0.647], ["never", 0.657, 0.894], ["found", 0.894, 1.131], ["this", 1.131, 1.25], ["man", 1.261, 1.552]]}, {"text": "In 1971, a quiet man in a suit boarded a flight to Seattle.", "start": 2.022, "end": 6.51, "spec": {"type": "cabin"}, "afx": null, "words": [["In 1971", 0.075, 1.056], ["a", 1.422, 1.465], ["quiet", 1.476, 1.853], ["man", 1.853, 2.144], ["in", 2.144, 2.231], ["a", 2.231, 2.274], ["suit", 2.274, 2.619], ["boarded", 2.619, 2.888], ["a", 2.899, 2.931], ["flight", 2.942, 3.362], ["to", 3.513, 3.588], ["Seattle", 3.588, 4.17]]}, {"text": "He handed the flight attendant a note. He had a bomb.", "start": 6.61, "end": 9.442, "spec": {"type": "note"}, "afx": null, "words": [["He", 0.097, 0.172], ["handed", 0.172, 0.409], ["the", 0.409, 0.463], ["flight", 0.463, 0.83], ["attendant", 0.959, 1.272], ["a", 1.282, 1.304], ["note", 1.304, 1.67], ["He", 2.026, 2.058], ["had", 2.058, 2.155], ["a", 2.155, 2.187], ["bomb", 2.198, 2.522]]}, {"text": "He wanted two hundred thousand dollars, and four parachutes.", "start": 9.542, "end": 12.71, "spec": {"type": "demand"}, "afx": null, "words": [["He", 0.097, 0.151], ["wanted", 0.162, 0.366], ["two", 0.377, 0.56], ["hundred", 0.56, 0.733], ["thousand", 0.733, 1.045], ["dollars", 1.045, 1.498], ["and", 1.692, 1.843], ["four", 1.853, 2.177], ["parachutes", 2.177, 2.834]]}, {"text": "In Seattle, he swapped the passengers for the money.", "start": 12.81, "end": 15.642, "spec": {"type": "runway"}, "afx": null, "words": [["In", 0.075, 0.172], ["Seattle", 0.172, 0.679], ["he", 0.991, 1.067], ["swapped", 1.078, 1.465], ["the", 1.476, 1.552], ["passengers", 1.552, 2.069], ["for", 2.069, 2.166], ["the", 2.166, 2.209], ["money", 2.209, 2.511]]}, {"text": "Then, at night, in a storm, he jumped out of the back of the plane.", "start": 15.742, "end"