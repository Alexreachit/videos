{"lines": [{"text": "Einer wollte ein Stein sein. Wunsch erfüllt!", "start": 0.05, "end": 2.882, "spec": {"type": "hook", "mood": "bright"}, "afx": null, "words": [["Einer", 0.097, 0.28], ["wollte", 0.291, 0.582], ["ein", 0.593, 0.744], ["Stein", 0.754, 1.088], ["sein", 1.099, 1.422], ["Wunsch", 1.778, 2.015], ["erfüllt", 2.015, 2.532]]}, {"text": "Tag 7 auf Roundhead Island!", "start": 3.002, "end": 4.898, "spec": {"type": "map", "mood": "bright"}, "afx": null, "words": [["Tag", 0.086, 0.302], ["7", 0.312, 0.711], ["auf", 0.722, 0.905], ["Roundhead", 0.916, 1.282], ["Island", 1.282, 1.584]]}, {"text": "Ihr habt entschieden: 10 Häuser für die Bürger!", "start": 5.018, "end": 7.946, "spec": {"type": "vote", "mood": "bright"}, "afx": null, "words": [["Ihr", 0.097, 0.237], ["habt", 0.248, 0.496], ["entschieden", 0.506, 1.034], ["10", 1.379, 1.627], ["Häuser", 1.627, 1.994], ["für", 1.994, 2.112], ["die", 2.123, 2.198], ["Bürger", 2.209, 2.619]]}, {"text": "9 neue Bürger! Wir sind jetzt 160 Einwohner.", "start": 8.066, "end": 11.57, "spec": {"type": "crowd"}, "afx": null, "words": [["9", 0.097, 0.334], ["neue", 0.334, 0.582], ["Bürger", 0.582, 1.002], ["Wir", 1.369, 1.498], ["sind", 1.498, 1.659], ["jetzt", 1.659, 1.897], ["160", 1.897, 2.608], ["Einwohner", 2.608, 3.179]]}, {"text": "Eure 31 Herzen bringen 310 Euro.", "start": 11.69, "end": 14.954, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.086, 0.409], ["31", 0.42, 1.11], ["Herzen", 1.11, 1.455], ["bringen", 1.466, 1.778], ["310", 1.789, 2.511], ["Euro", 2.511, 2.931]]}, {"text": "Jetzt sind 860 Euro in der Kasse!", "start": 15.074, "end": 17.666, "spec": {"type": "money2"}, "afx": null, "words": [["Jetzt", 0.097, 0.312], ["sind", 0.323, 0.571], ["860", 0.571, 1.304], ["Euro", 1.304, 1.703], ["in", 1.703, 1.778], ["der", 1.778, 1.875], ["Kasse", 1.875, 2.263]]}, {"text": "Also bauen wir: 10 Häuser!", "start": 17.786, "end": 20.282, "spec": {"type": "build", "mood": "bright"}, "afx": null, "words": [["Also", 0.086, 0.366], ["bauen", 0.377, 0.722], ["wir", 0.722, 1.034], ["10", 1.379, 1.638], ["Häuser", 1.649, 2.166]]}, {"text": "Und die Bürger ziehen sofort ein.", "start": 20.402, "end": 22.37, "spec": {"type": "movein"}, "afx": null, "words": [["Und", 0.086, 0.183], ["die", 0.183, 0.28], ["Bürger", 0.291, 0.647], ["ziehen", 0.647, 0.905], ["sofort", 0.905, 1.379], ["ein", 1.39, 1.649]]}, {"text": "Ein Bürger macht drüben eine Poststation auf.", "start": 22.49, "end": 25.25, "spec": {"type": "post", "mood": "calm"}, "afx": null, "words": [["Ein", 0.097, 0.215], ["Bürger", 0.215, 0.517], ["macht", 0.528, 0.754], ["drüben", 0.754, 1.153], ["eine", 1.153, 1.315], ["Poststation", 1.315, 2.112], ["auf", 2.123, 2.435]]}, {"text": "Und schon fliegt der erste Brief zu uns!", "start": 25.37, "end": 27.746, "spec": {"type": "letter", "mood": "bright"}, "afx": null, "words": [["Und", 0.075, 0.172], ["schon", 0.172, 0.388], ["fliegt", 0.399, 0.7], ["der", 0.7, 0.819], ["erste", 0.819, 1.121], ["Brief", 1.121, 1.433], ["zu", 1.444, 1.627], ["uns", 1.638, 2.058]]}, {"text": "Ein anderer wollte Lehrer sein: Hier ist unsere Schule!", "start": 27.866, "end": 31.25, "spec": {"type": "school"}, "afx": null, "words": [["Ein", 0.097, 0.259], ["anderer", 0.259, 0.614], ["wollte", 0.614, 0.948], ["Lehrer", 0.959, 1.336], ["sein", 1.347, 1.67], ["Hier", 1.983, 2.123], ["ist", 2.134, 2.252], ["unsere", 2.263, 2.586], ["Schule", 2.597, 3.06]]}, {"text": "Und wer sich sucht: Hier bist du!", "start": 31.37, "end": 33.506, "spec": {"type": "find", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.183], ["wer", 0.183, 0.291], ["sich", 0.291, 0.442], ["sucht", 0.442, 0.84], ["Hier", 1.175, 1.325], ["bist", 1.325, 1.541], ["du", 1.541, 1.821]]}, {"text": "Wir haben jetzt Häuser, eine Schule und eine Post.", "start": 33.626, "end": 36.77, "spec": {"type": "overview", "mood": "calm"}, "afx": null, "words": [["Wir", 0.097, 0.205], ["haben", 0.205, 0.442], ["jetzt", 0.442, 0.668], ["Häuser", 0.679, 1.078], ["eine", 1.325, 1.487], ["Schule", 1.487, 2.004], ["und", 2.004, 2.144], ["eine", 2.144, 2.338], ["Post", 2.338, 2.812]]}, {"text": "Aber keine Polizei und kein Krankenhaus.", "start": 36.89, "end": 39.578, "spec": {"type": "missing"}, "afx": null, "words": [["Aber", 0.086, 0.259], ["keine", 0.259, 0.506], ["Polizei", 0.517, 1.121], ["und", 1.131, 1.325], ["kein", 1.325, 1.595], ["Krankenhaus", 1.595, 2.36]]}, {"text": "Bauen wir eine Polizeistation?", "start": 39.698, "end": 41.666, "spec": {"type": "polizei"}, "afx": null, "words": [["Bauen", 0.097, 0.323], ["wir", 0.323, 0.453], ["eine", 0.453, 0.636], ["Polizeistation", 0.636, 1.638]]}, {"text": "Oder ein Krankenhaus für alle?", "start": 41.786, "end": 43.682, "spec": {"type": "krankenhaus"}, "afx": null, "words": [["Oder", 0.086, 0.248], ["ein", 0.248, 0.377], ["Krankenhaus", 0.388, 1.045], ["für", 1.056, 1.218], ["alle", 1.228, 1.573]]}, {"text": "Stimmt in der Umfrage ab!", "start": 43.802, "end": 45.674, "spec": {"type": "poll", "mood": "bright"}, "afx": null, "words": [["Stimmt", 0.086, 0.399], ["in", 0.399, 0.453], ["der", 0.453, 0.56], ["Umfrage", 0.56, 1.121], ["ab", 1.131, 1.379]]}], "dur": 47.07}