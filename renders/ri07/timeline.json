{"lines": [{"text": "Einer wollte ein Stein sein. Wunsch erfüllt!", "start": 0.05, "end": 2.834, "spec": {"type": "hook", "mood": "bright"}, "afx": null, "words": [["Einer", 0.097, 0.269], ["wollte", 0.269, 0.56], ["ein", 0.56, 0.7], ["Stein", 0.7, 1.034], ["sein", 1.034, 1.358], ["Wunsch", 1.713, 1.961], ["erfüllt", 1.961, 2.468]]}, {"text": "Tag 7 auf Roundhead Island!", "start": 2.954, "end": 4.826, "spec": {"type": "map", "mood": "bright"}, "afx": null, "words": [["Tag", 0.086, 0.302], ["7", 0.312, 0.679], ["auf", 0.679, 0.841], ["Roundhead", 0.841, 1.185], ["Island", 1.196, 1.53]]}, {"text": "Ihr habt entschieden: 10 Häuser für die Bürger!", "start": 4.946, "end": 7.85, "spec": {"type": "vote", "mood": "bright"}, "afx": null, "words": [["Ihr", 0.097, 0.237], ["habt", 0.237, 0.506], ["entschieden", 0.517, 1.024], ["10", 1.358, 1.595], ["Häuser", 1.606, 1.961], ["für", 1.961, 2.069], ["die", 2.08, 2.155], ["Bürger", 2.166, 2.565]]}, {"text": "9 neue Bürger! Wir sind jetzt 160 Einwohner.", "start": 7.97, "end": 11.522, "spec": {"type": "crowd"}, "afx": null, "words": [["9", 0.097, 0.366], ["neue", 0.377, 0.636], ["Bürger", 0.636, 1.045], ["Wir", 1.401, 1.519], ["sind", 1.519, 1.67], ["jetzt", 1.67, 1.918], ["160", 1.929, 2.651], ["Einwohner", 2.651, 3.233]]}, {"text": "Eure 31 Herzen bringen 310 Euro.", "start": 11.642, "end": 14.93, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.086, 0.431], ["31", 0.442, 1.142], ["Herzen", 1.142, 1.466], ["bringen", 1.466, 1.778], ["310", 1.789, 2.543], ["Euro", 2.543, 2.974]]}, {"text": "Jetzt sind 860 Euro in der Kasse!", "start": 15.05, "end": 17.642, "spec": {"type": "money2"}, "afx": null, "words": [["Jetzt", 0.097, 0.302], ["sind", 0.302, 0.539], ["860", 0.539, 1.293], ["Euro", 1.293, 1.703], ["in", 1.703, 1.778], ["der", 1.778, 1.864], ["Kasse", 1.875, 2.274]]}, {"text": "Also bauen wir: 10 Häuser!", "start": 17.762, "end": 20.138, "spec": {"type": "build", "mood": "bright"}, "afx": null, "words": [["Also", 0.097, 0.345], ["bauen", 0.356, 0.668], ["wir", 0.668, 0.948], ["10", 1.282, 1.552], ["Häuser", 1.552, 2.058]]}, {"text": "Und die Bürger ziehen sofort ein.", "start": 20.258, "end": 22.25, "spec": {"type": "movein"}, "afx": null, "words": [["Und", 0.097, 0.194], ["die", 0.205, 0.312], ["Bürger", 0.312, 0.668], ["ziehen", 0.668, 0.937], ["sofort", 0.938, 1.401], ["ein", 1.401, 1.67]]}, {"text": "Ein Bürger macht drüben eine Poststation auf.", "start": 22.37, "end": 25.25, "spec": {"type": "post", "mood": "calm"}, "afx": null, "words": [["Ein", 0.097, 0.226], ["Bürger", 0.237, 0.528], ["macht", 0.539, 0.808], ["drüben", 0.819, 1.218], ["eine", 1.228, 1.39], ["Poststation", 1.39, 2.187], ["auf", 2.188, 2.543]]}, {"text": "Und schon fliegt der erste Brief zu uns!", "start": 25.37, "end": 27.842, "spec": {"type": "letter", "mood": "bright"}, "afx": null, "words": [["Und", 0.075, 0.162], ["schon", 0.172, 0.399], ["fliegt", 0.409, 0.69], ["der", 0.69, 0.808], ["erste", 0.819, 1.131], ["Brief", 1.131, 1.476], ["zu", 1.487, 1.703], ["uns", 1.703, 2.134]]}, {"text": "Ein anderer wollte Lehrer sein: Hier ist unsere Schule!", "start": 27.962, "end": 31.394, "spec": {"type": "school"}, "afx": null, "words": [["Ein", 0.097, 0.259], ["anderer", 0.259, 0.657], ["wollte", 0.668, 1.013], ["Lehrer", 1.013, 1.379], ["sein", 1.379, 1.681], ["Hier", 2.015, 2.144], ["ist", 2.144, 2.284], ["unsere", 2.284, 2.629], ["Schule", 2.64, 3.114]]}, {"text": "Und wer sich sucht: Hier bist du!", "start": 31.514, "end": 33.626, "spec": {"type": "find", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.172], ["wer", 0.172, 0.302], ["sich", 0.312, 0.463], ["sucht", 0.463, 0.851], ["Hier", 1.196, 1.315], ["bist", 1.315, 1.519], ["du", 1.53, 1.8]]}, {"text": "Wir haben jetzt Häuser, eine Schule und eine Post.", "start": 33.746, "end": 36.89, "spec": {"type": "overview", "mood": "calm"}, "afx": null, "words": [["Wir", 0.086, 0.205], ["haben", 0.215, 0.453], ["jetzt", 0.453, 0.69], ["Häuser", 0.7, 1.131], ["eine", 1.379, 1.541], ["Schule", 1.541, 2.026], ["und", 2.037, 2.188], ["eine", 2.198, 2.371], ["Post", 2.371, 2.834]]}, {"text": "Aber keine Polizei und keinen Hafen.", "start": 37.01, "end": 39.29, "spec": {"type": "missing"}, "afx": null, "words": [["Aber", 0.086, 0.269], ["keine", 0.28, 0.528], ["Polizei", 0.528, 1.11], ["und", 1.121, 1.282], ["keinen", 1.282, 1.573], ["Hafen", 1.573, 1.961]]}, {"text": "Bauen wir eine Polizeistation?", "start": 39.41, "end": 41.402, "spec": {"type": "polizei"}, "afx": null, "words": [["Bauen", 0.097, 0.334], ["wir", 0.345, 0.485], ["eine", 0.496, 0.679], ["Polizeistation", 0.69, 1.681]]}, {"text": "Oder einen Hafen für Handelsschiffe?", "start": 41.522, "end": 43.682, "spec": {"type": "hafen"}, "afx": null, "words": [["Oder", 0.097, 0.366], ["einen", 0.377, 0.582], ["Hafen", 0.593, 0.937], ["für", 0.938, 1.078], ["Handelsschiffe", 1.088, 1.832]]}, {"text": "Stimmt in der Umfrage ab!", "start": 43.802, "end": 45.674, "spec": {"type": "poll", "mood": "bright"}, "afx": null, "words": [["Stimmt", 0.086, 0.409], ["in", 0.409, 0.474], ["der", 0.485, 0.603], ["Umfrage", 0.603, 1.131], ["ab", 1.131, 1.379]]}], "dur": 47.07}