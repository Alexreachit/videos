{"lines": [{"text": "Einer will Kampfjet-Pilot werden. Abheben!", "start": 0.05, "end": 2.81, "spec": {"type": "hook", "mood": "bright"}, "afx": null, "words": [["Einer", 0.086, 0.28], ["will", 0.28, 0.463], ["Kampfjet-", 0.463, 1.013], ["Pilot", 1.024, 1.315], ["werden", 1.315, 1.67], ["Abheben", 2.026, 2.435]]}, {"text": "Tag 8 auf Roundhead Island!", "start": 2.93, "end": 4.802, "spec": {"type": "map", "mood": "bright"}, "afx": null, "words": [["Tag", 0.097, 0.323], ["8", 0.323, 0.528], ["auf", 0.539, 0.69], ["Roundhead", 0.69, 1.024], ["Island", 1.024, 1.325]]}, {"text": "Ihr habt entschieden: Wir bauen ein Krankenhaus!", "start": 4.922, "end": 7.874, "spec": {"type": "vote", "mood": "bright"}, "afx": null, "words": [["Ihr", 0.097, 0.194], ["habt", 0.194, 0.431], ["entschieden", 0.431, 0.937], ["Wir", 1.282, 1.39], ["bauen", 1.39, 1.67], ["ein", 1.681, 1.81], ["Krankenhaus", 1.81, 2.651]]}, {"text": "7 neue Bürger! Wir sind jetzt 167 Einwohner.", "start": 7.994, "end": 12.122, "spec": {"type": "crowd"}, "afx": null, "words": [["7", 0.086, 0.323], ["neue", 0.323, 0.582], ["Bürger", 0.582, 1.013], ["Wir", 1.358, 1.476], ["sind", 1.476, 1.627], ["jetzt", 1.627, 1.907], ["167", 1.918, 3.19], ["Einwohner", 3.19, 3.804]]}, {"text": "Eure 36 Herzen bringen 360 Euro.", "start": 12.242, "end": 15.602, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.086, 0.356], ["36", 0.366, 1.099], ["Herzen", 1.099, 1.422], ["bringen", 1.433, 1.724], ["360", 1.735, 2.629], ["Euro", 2.629, 3.039]]}, {"text": "Jetzt sind 1220 Euro in der Kasse!", "start": 15.722, "end": 18.986, "spec": {"type": "money2"}, "afx": null, "words": [["Jetzt", 0.097, 0.269], ["sind", 0.269, 0.442], ["1220", 0.453, 1.907], ["Euro", 1.907, 2.317], ["in", 2.317, 2.425], ["der", 2.435, 2.522], ["Kasse", 2.532, 2.931]]}, {"text": "Und da steht es: unser Krankenhaus!", "start": 19.106, "end": 21.65, "spec": {"type": "build", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.162], ["da", 0.162, 0.302], ["steht", 0.302, 0.593], ["es", 0.603, 0.819], ["unser", 1.153, 1.433], ["Krankenhaus", 1.433, 2.209]]}, {"text": "Christos bekommt seinen Schuhladen!", "start": 21.77, "end": 23.81, "spec": {"type": "shoe"}, "afx": null, "words": [["Christos", 0.086, 0.474], ["bekommt", 0.474, 0.851], ["seinen", 0.851, 1.088], ["Schuhladen", 1.099, 1.713]]}, {"text": "Damian holt einen Zirkus auf die Insel!", "start": 23.93, "end": 26.498, "spec": {"type": "circus", "mood": "bright"}, "afx": null, "words": [["Damian", 0.086, 0.431], ["holt", 0.431, 0.765], ["einen", 0.765, 0.959], ["Zirkus", 0.959, 1.509], ["auf", 1.519, 1.659], ["die", 1.67, 1.821], ["Insel", 1.821, 2.241]]}, {"text": "Und Mex wird unser erster Polizist. Nur eine Wache hat er noch nicht.", "start": 26.618, "end": 30.698, "spec": {"type": "mex"}, "afx": null, "words": [["Und", 0.086, 0.215], ["Mex", 0.215, 0.496], ["wird", 0.496, 0.733], ["unser", 0.733, 0.948], ["erster", 0.959, 1.282], ["Polizist", 1.293, 1.929], ["Nur", 2.295, 2.468], ["eine", 2.468, 2.662], ["Wache", 2.672, 2.92], ["hat", 2.92, 3.114], ["er", 3.125, 3.19], ["noch", 3.2, 3.373], ["nicht", 3.373, 3.761]]}, {"text": "Bauen wir jetzt eine Polizeistation für Mex?", "start": 30.818, "end": 33.602, "spec": {"type": "polizei"}, "afx": null, "words": [["Bauen", 0.097, 0.323], ["wir", 0.323, 0.42], ["jetzt", 0.42, 0.744], ["eine", 0.744, 0.905], ["Polizeistation", 0.916, 1.853], ["für", 1.853, 1.994], ["Mex", 1.994, 2.468]]}, {"text": "Oder einen Flugplatz für unseren Piloten?", "start": 33.722, "end": 36.146, "spec": {"type": "flug"}, "afx": null, "words": [["Oder", 0.097, 0.28], ["einen", 0.28, 0.474], ["Flugplatz", 0.474, 1.013], ["für", 1.013, 1.196], ["unseren", 1.207, 1.53], ["Piloten", 1.53, 2.112]]}, {"text": "Stimmt in der Umfrage ab!", "start": 36.266, "end": 38.138, "spec": {"type": "poll", "mood": "bright"}, "afx": null, "words": [["Stimmt", 0.086, 0.409], ["in", 0.409, 0.485], ["der", 0.496, 0.603], ["Umfrage", 0.614, 1.153], ["ab", 1