{"lines": [{"text": "Einer will Kampfjet-Pilot werden. Abheben!", "start": 0.05, "end": 2.978, "spec": {"type": "hook", "mood": "bright"}, "afx": null, "words": [["Einer", 0.097, 0.302], ["will", 0.302, 0.571], ["Kampfjet-", 0.571, 1.153], ["Pilot", 1.153, 1.444], ["werden", 1.455, 1.821], ["Abheben", 2.166, 2.608]]}, {"text": "Tag 8 auf Roundhead Island!", "start": 3.098, "end": 4.97, "spec": {"type": "map", "mood": "bright"}, "afx": null, "words": [["Tag", 0.097, 0.323], ["8", 0.323, 0.528], ["auf", 0.539, 0.679], ["Roundhead", 0.679, 1.013], ["Island", 1.013, 1.368]]}, {"text": "Ihr habt entschieden: Wir bauen ein Krankenhaus!", "start": 5.09, "end": 8.042, "spec": {"type": "vote", "mood": "bright"}, "afx": null, "words": [["Ihr", 0.097, 0.194], ["habt", 0.194, 0.431], ["entschieden", 0.431, 0.937], ["Wir", 1.282, 1.39], ["bauen", 1.39, 1.67], ["ein", 1.681, 1.81], ["Krankenhaus", 1.81, 2.651]]}, {"text": "7 neue Bürger! Wir sind jetzt 167 Einwohner.", "start": 8.162, "end": 12.266, "spec": {"type": "crowd"}, "afx": null, "words": [["7", 0.086, 0.366], ["neue", 0.366, 0.636], ["Bürger", 0.647, 1.078], ["Wir", 1.444, 1.552], ["sind", 1.552, 1.713], ["jetzt", 1.713, 1.983], ["167", 1.983, 3.179], ["Einwohner", 3.179, 3.772]]}, {"text": "Eure 36 Herzen bringen 360 Euro.", "start": 12.386, "end": 15.914, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.097, 0.399], ["36", 0.399, 1.153], ["Herzen", 1.164, 1.498], ["bringen", 1.498, 1.821], ["360", 1.832, 2.802], ["Euro", 2.802, 3.2]]}, {"text": "Jetzt sind 1220 Euro in der Kasse!", "start": 16.034, "end": 19.274, "spec": {"type": "money2"}, "afx": null, "words": [["Jetzt", 0.097, 0.28], ["sind", 0.28, 0.463], ["1220", 0.463, 1.929], ["Euro", 1.929, 2.306], ["in", 2.306, 2.414], ["der", 2.414, 2.511], ["Kasse", 2.522, 2.92]]}, {"text": "Und da steht es: unser Krankenhaus!", "start": 19.394, "end": 21.914, "spec": {"type": "build", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.183], ["da", 0.194, 0.334], ["steht", 0.334, 0.636], ["es", 0.647, 0.884], ["unser", 1.164, 1.412], ["Krankenhaus", 1.412, 2.188]]}, {"text": "Das Krankenhaus hat 1000 Euro gekostet. Bleiben 220 Euro in der Kasse.", "start": 22.034, "end": 27.266, "spec": {"type": "kosten", "mood": "calm"}, "afx": null, "words": [["Das", 0.086, 0.194], ["Krankenhaus", 0.194, 0.797], ["hat", 0.797, 0.948], ["1000", 0.948, 1.39], ["Euro", 1.39, 1.649], ["gekostet", 1.649, 2.241], ["Bleiben", 2.597, 2.877], ["220", 2.888, 3.944], ["Euro", 3.944, 4.332], ["in", 4.332, 4.418], ["der", 4.418, 4.515], ["Kasse", 4.526, 4.914]]}, {"text": "Christos bekommt seinen Schuhladen!", "start": 27.386, "end": 29.426, "spec": {"type": "shoe"}, "afx": null, "words": [["Christos", 0.086, 0.474], ["bekommt", 0.474, 0.851], ["seinen", 0.851, 1.088], ["Schuhladen", 1.099, 1.713]]}, {"text": "Damian holt einen Zirkus auf die Insel!", "start": 29.546, "end": 32.114, "spec": {"type": "circus", "mood": "bright"}, "afx": null, "words": [["Damian", 0.086, 0.431], ["holt", 0.431, 0.765], ["einen", 0.765, 0.959], ["Zirkus", 0.959, 1.509], ["auf", 1.519, 1.659], ["die", 1.67, 1.821], ["Insel", 1.821, 2.241]]}, {"text": "Und Mex wird unser erster Polizist. Nur eine Wache hat er noch nicht.", "start": 32.234, "end": 36.314, "spec": {"type": "mex"}, "afx": null, "words": [["Und", 0.086, 0.215], ["Mex", 0.215, 0.496], ["wird", 0.496, 0.733], ["unser", 0.733, 0.948], ["erster", 0.959, 1.282], ["Polizist", 1.293, 1.929], ["Nur", 2.295, 2.468], ["eine", 2.468, 2.662], ["Wache", 2.672, 2.92], ["hat", 2.92, 3.114], ["er", 3.125, 3.19], ["noch", 3.2, 3.373], ["nicht", 3.373, 3.761]]}, {"text": "Bauen wir jetzt eine Polizeistation für Mex?", "start": 36.434, "end": 39.218, "spec": {"type": "polizei"}, "afx": null, "words": [["Bauen", 0.097, 0.323], ["wir", 0.323, 0.42], ["jetzt", 0.42, 0.744], ["eine", 0.744, 0.905], ["Polizeistation", 0.916, 1.853], ["für", 1.853, 1.994], ["Mex", 1.994, 2.468]]}, {"text": "Oder einen Flugplatz für unseren Piloten?", "start": 39.338, "end": 41.81, "spec": {"type": "flug"}, "afx": null, "words": [["Oder", 0.097, 0.291], ["einen", 0.302, 0.506], ["Flugplatz", 0.517, 1.078], ["für", 1.078, 1.25], ["unseren", 1.261, 1.584], ["Piloten", 1.595, 2.166]]}, {"text": "Beide kosten 720 Euro. Dafür brauchen wir 50 Herzen!", "start": 41.93, "end": 46.754, "spec": {"type": "ziel"}, "afx": null, "words": [["Beide", 0.097, 0.312], ["kosten", 0.323, 0.819], ["720", 0.83, 1.713], ["Euro", 1.713, 2.091], ["Dafür", 2.446, 2.791], ["brauchen", 2.802, 3.265], ["wir", 3.265, 3.491], ["50", 3.502, 4.062], ["Herzen", 4.062, 4.504]]}, {"text": "Und bei 200 Einwohnern wartet eine riesige Überraschung!", "start": 46.874, "end": 50.402, "spec": {"type": "surprise", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.162], ["bei", 0.162, 0.302], ["200", 0.312, 0.851], ["Einwohnern", 0.862, 1.379], ["wartet", 1.379, 1.8], ["eine", 1.8, 2.037], ["riesige", 2.037, 2.575], ["Überraschung", 2.575, 3.211]]}, {"text": "Stimmt in der Umfrage ab!", "start": 50.522, "end": 52.394, "spec": {"type": "poll", "mood": "bright"}, "afx": null, "words": [["Stimmt", 0.086, 0.409], ["in", 0.409, 0.485], ["der", 0.496, 0.603], ["Umfrage", 0.614, 1.153], ["ab", 1.164, 1.412]]}], "dur": 53.79}