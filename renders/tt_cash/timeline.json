{"lines": [{"text": "This hundred dollar bill lost twenty-three dollars. And nobody touched it.", "start": 0.1, "end": 4.42, "spec": {"img": 1, "ov": "hook"}, "words": [["This", 0.08, 0.205], ["hundred", 0.205, 0.409], ["dollar", 0.409, 0.716], ["bill", 0.92, 1.114], ["lost", 1.114, 1.568], ["twenty-three", 1.659, 2.159], ["dollars", 2.159, 2.739], ["And", 3.114, 3.205], ["nobody", 3.216, 3.523], ["touched", 3.523, 3.841], ["it", 3.841, 3.989]]}, {"text": "In 2020, Sam put one hundred dollars in a drawer.", "start": 4.62, "end": 7.668, "spec": {"img": 2, "ov": "drawer"}, "words": [["In 2020", 0.08, 0.75], ["Sam", 1.182, 1.455], ["put", 1.455, 1.58], ["one", 1.58, 1.67], ["hundred", 1.67, 1.92], ["dollars", 1.932, 2.227], ["in", 2.227, 2.284], ["a", 2.284, 2.318], ["drawer", 2.318, 2.716]]}, {"text": "Today, it only buys what seventy-seven dollars bought back then.", "start": 7.868, "end": 11.468, "spec": {"img": 3, "ov": "buys"}, "words": [["Today", 0.091, 0.455], ["it", 0.648, 0.727], ["only", 0.739, 0.943], ["buys", 0.943, 1.386], ["what", 1.398, 1.545], ["seventy-seven", 1.545, 2.216], ["dollars", 2.227, 2.534], ["bought", 2.534, 2.773], ["back", 2.773, 3.023], ["then", 3.023, 3.261]]}, {"text": "Because prices are up about thirty-one percent.", "start": 11.668, "end": 14.26, "spec": {"img": 4, "ov": "cpi"}, "words": [["Because", 0.102, 0.364], ["prices", 0.364, 0.773], ["are", 0.773, 0.875], ["up", 0.875, 0.955], ["about", 0.955, 1.25], ["thirty-one", 1.261, 1.75], ["percent", 1.75, 2.261]]}, {"text": "A pound of coffee went from four dollars to over nine.", "start": 14.46, "end": 17.58, "spec": {"img": 4, "ov": "coffee"}, "words": [["A", 0.08, 0.114], ["pound", 0.114, 0.33], ["of", 0.33, 0.398], ["coffee", 0.398, 0.807], ["went", 0.818, 1.023], ["from", 1.034, 1.182], ["four", 1.182, 1.557], ["dollars", 1.568, 2.057], ["to", 2.239, 2.341], ["over", 2.341, 2.5], ["nine", 2.5, 2.795]]}, {"text": "The bill did not shrink. Its buying power did.", "start": 17.78, "e