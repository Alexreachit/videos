{"lines": [{"text": "This hundred-dollar bill just lost twenty-three bucks. And nobody touched it.", "start": 0.1, "end": 4.348, "spec": {"img": 1, "ov": "hook"}, "words": [["This", 0.091, 0.205], ["hundred-dollar", 0.205, 0.659], ["bill", 0.659, 0.955], ["just", 1.125, 1.386], ["lost", 1.398, 1.682], ["twenty-three", 1.682, 2.182], ["bucks", 2.193, 2.693], ["And", 3.068, 3.159], ["nobody", 3.17, 3.477], ["touched", 3.489, 3.773], ["it", 3.773, 3.909]]}, {"text": "In 2020, Sam put one hundred dollars in a drawer.", "start": 4.548, "end": 7.596, "spec": {"img": 2, "ov": "drawer"}, "words": [["In 2020", 0.08, 0.75], ["Sam", 1.182, 1.455], ["put", 1.455, 1.58], ["one", 1.58, 1.67], ["hundred", 1.67, 1.92], ["dollars", 1.932, 2.227], ["in", 2.227, 2.284], ["a", 2.284, 2.318], ["drawer", 2.318, 2.716]]}, {"text": "Today, it only buys what seventy-seven dollars bought back then.", "start": 7.796, "end": 11.396, "spec": {"img": 3, "ov": "buys"}, "words": [["Today", 0.091, 0.455], ["it", 0.648, 0.727], ["only", 0.739, 0.943], ["buys", 0.943, 1.386], ["what", 1.398, 1.545], ["seventy-seven", 1.545, 2.216], ["dollars", 2.227, 2.534], ["bought", 2.534, 2.773], ["back", 2.773, 3.023], ["then", 3.023, 3.261]]}, {"text": "Because prices are up about thirty-one percent.", "start": 11.596, "end": 14.188, "spec": {"img": 4, "ov": "cpi"}, "words": [["Because", 0.102, 0.364], ["prices", 0.364, 0.773], ["are", 0.773, 0.875], ["up", 0.875, 0.955], ["about", 0.955, 1.25], ["thirty-one", 1.261, 1.75], ["percent", 1.75, 2.261]]}, {"text": "A pound of coffee went from four dollars to over nine.", "start": 14.388, "end": 17.508, "spec": {"img": 4, "ov": "coffee"}, "words": [["A", 0.08, 0.114], ["pound", 0.114, 0.33], ["of", 0.33, 0.398], ["coffee", 0.398, 0.807], ["went", 0.818, 1.023], ["from", 1.034, 1.182], ["four", 1.182, 1.557], ["dollars", 1.568, 2.057], ["to", 2.239, 2.341], ["over", 2.341, 2.5], ["nine", 2.5, 2.795]]}, {"text": "The bill did not shrink. Its buying power did.", "start