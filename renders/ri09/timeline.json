{"lines": [{"text": "Tag 9 auf Roundhead Island!", "start": 0.05, "end": 1.922, "spec": {"type": "map", "mood": "bright"}, "afx": null, "words": [["Tag", 0.097, 0.302], ["9", 0.302, 0.517], ["auf", 0.528, 0.657], ["Roundhead", 0.657, 1.002], ["Island", 1.013, 1.336]]}, {"text": "Die Regeln: Folgen macht dich zum Einwohner, jedes Herz bringt 10 Euro, und im Kommentar darfst du dir was wünschen!", "start": 2.042, "end": 8.57, "spec": {"type": "regeln"}, "afx": null, "words": [["Die", 0.097, 0.183], ["Regeln", 0.183, 0.571], ["Folgen", 0.884, 1.164], ["macht", 1.164, 1.336], ["dich", 1.336, 1.465], ["zum", 1.476, 1.681], ["Einwohner", 1.692, 2.263], ["jedes", 2.619, 2.899], ["Herz", 2.899, 3.19], ["bringt", 3.2, 3.459], ["10", 3.47, 3.815], ["Euro", 3.815, 4.192], ["und", 4.537, 4.634], ["im", 4.634, 4.72], ["Kommentar", 4.731, 5.237], ["darfst", 5.237, 5.506], ["du", 5.506, 5.571], ["dir", 5.571, 5.679], ["was", 5.69, 5.819], ["wünschen", 5.83, 6.196]]}, {"text": "Ihr habt entschieden: Wir bauen die Polizeistation!", "start": 8.69, "end": 11.69, "spec": {"type": "vote", "mood": "bright"}, "afx": null, "words": [["Ihr", 0.097, 0.194], ["habt", 0.205, 0.442], ["entschieden", 0.442, 0.959], ["Wir", 1.207, 1.315], ["bauen", 1.315, 1.595], ["die", 1.606, 1.692], ["Polizeistation", 1.692, 2.683]]}, {"text": "4 neue Bürger! Wir sind jetzt 171 Einwohner.", "start": 11.81, "end": 15.89, "spec": {"type": "crowd"}, "afx": null, "words": [["4", 0.14, 0.323], ["neue", 0.334, 0.603], ["Bürger", 0.614, 1.034], ["Wir", 1.39, 1.498], ["sind", 1.509, 1.681], ["jetzt", 1.681, 2.004], ["171", 2.015, 3.168], ["Einwohner", 3.168, 3.75]]}, {"text": "Eure 24 Herzen bringen 240 Euro. Macht 460 Euro.", "start": 16.01, "end": 21.506, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.097, 0.42], ["24", 0.431, 1.315], ["Herzen", 1.315, 1.659], ["bringen", 1.659, 1.983], ["240", 1.994, 2.909], ["Euro", 2.909, 3.287], ["Macht", 3.631, 3.847], ["460", 3.847, 4.774], ["Euro", 4.774, 5.162]]}, {"text": "Aber die Polizeistation kostet 720 Euro. Es fehlen noch 260!", "start": 21.626, "end": 26.882, "spec": {"type": "gap", "mood": "calm"}, "afx": null, "words": [["Aber", 0.086, 0.248], ["die", 0.248, 0.345], ["Polizeistation", 0.345, 1.315], ["kostet", 1.315, 1.724], ["720", 1.735, 2.575], ["Euro", 2.575, 2.953], ["Es", 3.319, 3.437], ["fehlen", 3.448, 3.728], ["noch", 3.728, 3.858], ["260", 3.858, 4.935]]}, {"text": "Die Baustelle steht schon!", "start": 27.002, "end": 28.874, "spec": {"type": "site", "mood": "bright"}, "afx": null, "words": [["Die", 0.086, 0.162], ["Baustelle", 0.162, 0.69], ["steht", 0.7, 0.937], ["schon", 0.938, 1.207]]}, {"text": "Unser neuer Architekt plant alles!", "start": 28.994, "end": 31.322, "spec": {"type": "arch"}, "afx": null, "words": [["Unser", 0.086, 0.28], ["neuer", 0.28, 0.593], ["Architekt", 0.593, 1.164], ["plant", 1.164, 1.552], ["alles", 1.552, 2.004]]}, {"text": "Simon wird Sicherheitschef und bewacht die Baustelle.", "start": 31.442, "end": 34.274, "spec": {"type": "security"}, "afx": null, "words": [["Simon", 0.086, 0.388], ["wird", 0.388, 0.506], ["Sicherheitschef", 0.506, 1.39], ["und", 1.401, 1.53], ["bewacht", 1.541, 1.843], ["die", 1.843, 1.918], ["Baustelle", 1.918, 2.511]]}, {"text": "Mit 26 Herzen ist die Wache fertig!", "start": 34.394, "end": 37.202, "spec": {"type": "ziel"}, "afx": null, "words": [["Mit", 0.086, 0.205], ["26", 0.205, 0.884], ["Herzen", 0.884, 1.282], ["ist", 1.293, 1.433], ["die", 1.433, 1.562], ["Wache", 1.562, 1.853], ["fertig", 1.853, 2.478]]}, {"text": "Und bei 200 Einwohnern wartet die Überraschung. Nur noch 29!", "start": 37.322, "end": 41.714, "spec": {"type": "surprise", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.162], ["bei", 0.172, 0.312], ["200", 0.323, 0.851], ["Einwohnern", 0.851, 1.379], ["wartet", 1.379, 1.8], ["die", 1.81, 1.94], ["Überraschung", 1.94, 2.543], ["Nur", 2.899, 2.996], ["noch", 2.996, 3.136], ["29", 3.136, 4.073]]}, {"text": "Wer wird Polizeichef: Mex oder Simon?", "start": 41.834, "end": 44.762, "spec": {"type": "chef"}, "afx": null, "words": [["Wer", 0.097, 0.259], ["wird", 0.269, 0.388], ["Polizeichef", 0.388, 1.185], ["Mex", 1.53, 1.95], ["oder", 1.961, 2.177], ["Simon", 2.177, 2.608]]}, {"text": "Stimmt in der Umfrage ab!", "start": 44.882, "end": 46.754, "spec": {"type": "poll", "mood": "bright"}, "afx": null, "words": [["Stimmt", 0.086, 0.399], ["in", 0.399, 0.463], ["der", 0.474, 0.582], ["Umfrage", 0.582, 1.131], ["ab", 1.131, 1.401]]}], "dur": 48.15}