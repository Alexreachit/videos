{"lines": [{"text": "Tag 9 auf Roundhead Island!", "start": 0.05, "end": 1.706, "spec": {"type": "map", "mood": "bright"}, "afx": null, "words": [["Tag", 0.097, 0.302], ["9", 0.302, 0.517], ["auf", 0.528, 0.657], ["Roundhead", 0.657, 1.002], ["Island", 1.013, 1.336]]}, {"text": "Die Regeln: Folgen macht dich zum Einwohner, jedes Herz bringt 10 Euro, und im Kommentar darfst du dir was wünschen!", "start": 1.826, "end": 8.354, "spec": {"type": "regeln"}, "afx": null, "words": [["Die", 0.086, 0.183], ["Regeln", 0.183, 0.571], ["Folgen", 0.894, 1.185], ["macht", 1.185, 1.369], ["dich", 1.369, 1.487], ["zum", 1.498, 1.649], ["Einwohner", 1.649, 2.209], ["jedes", 2.532, 2.812], ["Herz", 2.812, 3.093], ["bringt", 3.103, 3.351], ["10", 3.351, 3.696], ["Euro", 3.696, 4.073], ["und", 4.429, 4.547], ["im", 4.558, 4.644], ["Kommentar", 4.644, 5.162], ["darfst", 5.172, 5.442], ["du", 5.442, 5.517], ["dir", 5.517, 5.657], ["was", 5.657, 5.797], ["wünschen", 5.808, 6.207]]}, {"text": "Ihr habt entschieden: Wir bauen die Polizeistation!", "start": 8.474, "end": 11.57, "spec": {"type": "vote", "mood": "bright"}, "afx": null, "words": [["Ihr", 0.097, 0.205], ["habt", 0.215, 0.431], ["entschieden", 0.431, 0.97], ["Wir", 1.228, 1.358], ["bauen", 1.358, 1.649], ["die", 1.649, 1.746], ["Polizeistation", 1.756, 2.769]]}, {"text": "4 neue Bürger! Wir sind jetzt 171 Einwohner.", "start": 11.69, "end": 15.65, "spec": {"type": "crowd"}, "afx": null, "words": [["4", 0.151, 0.323], ["neue", 0.323, 0.582], ["Bürger", 0.582, 0.991], ["Wir", 1.336, 1.433], ["sind", 1.433, 1.595], ["jetzt", 1.595, 1.864], ["171", 1.864, 3.028], ["Einwohner", 3.028, 3.621]]}, {"text": "Eure 24 Herzen bringen 240 Euro. Macht 460 Euro.", "start": 15.77, "end": 21.122, "spec": {"type": "money"}, "afx": null, "words": [["Eure", 0.097, 0.42], ["24", 0.42, 1.282], ["Herzen", 1.282, 1.606], ["bringen", 1.616, 1.94], ["240", 1.95, 2.845], ["Euro", 2.845, 3.222], ["Macht", 3.567, 3.782], ["460", 3.782, 4.634], ["Euro", 4.634, 5.022]]}, {"text": "Aber die Polizeistation kostet 720 Euro. Es fehlen noch 260!", "start": 21.242, "end": 26.546, "spec": {"type": "gap", "mood": "calm"}, "afx": null, "words": [["Aber", 0.097, 0.259], ["die", 0.259, 0.345], ["Polizeistation", 0.356, 1.358], ["kostet", 1.358, 1.81], ["720", 1.81, 2.662], ["Euro", 2.662, 3.006], ["Es", 3.362, 3.47], ["fehlen", 3.47, 3.793], ["noch", 3.793, 3.933], ["260", 3.933, 4.989]]}, {"text": "Die Baustelle steht schon!", "start": 26.666, "end": 28.538, "spec": {"type": "site", "mood": "bright"}, "afx": null, "words": [["Die", 0.075, 0.14], ["Baustelle", 0.14, 0.647], ["steht", 0.647, 0.884], ["schon", 0.894, 1.175]]}, {"text": "Unser neuer Architekt plant alles!", "start": 28.658, "end": 31.13, "spec": {"type": "arch"}, "afx": null, "words": [["Unser", 0.086, 0.312], ["neuer", 0.312, 0.657], ["Architekt", 0.668, 1.282], ["plant", 1.282, 1.681], ["alles", 1.692, 2.144]]}, {"text": "Simon wird Security-Chef und bewacht die Baustelle.", "start": 31.25, "end": 34.154, "spec": {"type": "security"}, "afx": null, "words": [["Simon", 0.086, 0.377], ["wird", 0.388, 0.528], ["Sicherheits-", 0.539, 1.067], ["Chef", 1.067, 1.368], ["und", 1.369, 1.498], ["bewacht", 1.509, 1.821], ["die", 1.821, 1.907], ["Baustelle", 1.918, 2.565]]}, {"text": "Mit 26 Herzen ist die Wache fertig!", "start": 34.274, "end": 37.106, "spec": {"type": "ziel"}, "afx": null, "words": [["Mit", 0.086, 0.205], ["26", 0.215, 0.873], ["Herzen", 0.884, 1.282], ["ist", 1.293, 1.422], ["die", 1.422, 1.552], ["Wache", 1.552, 1.864], ["fertig", 1.864, 2.511]]}, {"text": "Und bei 200 Einwohnern wartet die Überraschung. Nur noch 29!", "start": 37.226, "end": 41.738, "spec": {"type": "surprise", "mood": "bright"}, "afx": null, "words": [["Und", 0.086, 0.172], ["bei", 0.172, 0.312], ["200", 0.312, 0.862], ["Einwohnern", 0.862, 1.39], ["wartet", 1.401, 1.832], ["die", 1.832, 1.994], ["Überraschung", 1.994, 2.608], ["Nur", 2.963, 3.082], ["noch", 3.082, 3.222], ["29", 3.222, 4.192]]}, {"text": "Wer wird Polizeichef: Mex oder Simon?", "start": 41.858, "end": 44.762, "spec": {"type": "chef"}, "afx": null, "words": [["Wer", 0.097, 0.248], ["wird", 0.248, 0.377], ["Polizeichef", 0.377, 1.175], ["Mex", 1.519, 1.95], ["oder", 1.961, 2.144], ["Simon", 2.144, 2.586]]}, {"text": "Stimmt in der Umfrage ab!", "start": 44.882, "end": 46.754, "spec": {"type": "poll", "mood": "bright"}, "afx": null, "words": [["Stimmt", 0.086, 0.388], ["in", 0.399, 0.463], ["der", 0.463, 0.603], ["Umfrage", 0.603, 1.11], ["ab", 1.121, 1.336]]}], "dur": 48.15}